//! 主题调度器：独立主题文件提供颜色 token，Theme 只选择当前预设。

import { LightTheme } from "themes/light.slint";
import { DarkTheme } from "themes/dark.slint";
import { PinkTheme } from "themes/pink.slint";

// 所有主题共享相同字段；未来新增主题只需增加调色板文件和选择分支。
// 全局导出的视觉契约；组件通过这些只读 token 统一颜色、间距和尺寸。
// 属性值只影响绘制，不参与 Rust bridge 状态或交互逻辑。
// 全局 Theme 不保存运行态，只向所有界面组件提供统一的视觉 token。
export global Theme {
    // 0 浅色、1 深色、2 淡粉；主题选择不承担业务状态。
    in-out property <int> theme-index: 0;
    // 淡粉主题的远程背景图，由 Rust 下载并在 UI 线程注入。
    in-out property <image> pink-background-image;
    // 兼容现有组件对深色状态的读取。
    out property <bool> dark-mode: root.theme-index == 1;
    // 粉色主题只允许在该分支显示图片背景。
    out property <bool> pink-mode: root.theme-index == 2;
    // 页面与控件颜色来自当前独立调色板文件。
    out property <color> bg: root.theme-index == 1
        ? DarkTheme.bg
        : (root.theme-index == 2 ? PinkTheme.bg : LightTheme.bg);
    out property <color> bar-bg: root.theme-index == 1
        ? DarkTheme.bar-bg
        : (root.theme-index == 2 ? PinkTheme.bar-bg : LightTheme.bar-bg);
    out property <color> page-bg: root.theme-index == 1
        ? DarkTheme.page-bg
        : (root.theme-index == 2 ? PinkTheme.page-bg : LightTheme.page-bg);
    // 三页主内容底层只在淡粉主题铺浅色遮罩，提高非卡片文字对比度。
    out property <color> page-overlay: root.theme-index == 2
        ? PinkTheme.page-overlay
        : transparent;
    // 页面内容卡片独立于弹层表面设置透明度。
    out property <color> content-card: root.theme-index == 1
        ? DarkTheme.card
        : (root.theme-index == 2
            ? PinkTheme.content-card
            : LightTheme.card);
    out property <color> card: root.theme-index == 1
        ? DarkTheme.card
        : (root.theme-index == 2 ? PinkTheme.card : LightTheme.card);
    out property <color> field: root.theme-index == 1
        ? DarkTheme.field
        : (root.theme-index == 2 ? PinkTheme.field : LightTheme.field);
    out property <color> border: root.theme-index == 1
        ? DarkTheme.border
        : (root.theme-index == 2 ? PinkTheme.border : LightTheme.border);
    out property <color> borderStrong: root.theme-index == 1
        ? DarkTheme.border-strong
        : (root.theme-index == 2 ? PinkTheme.border-strong : LightTheme.border-strong);
    out property <color> accentSoft: root.theme-index == 1
        ? DarkTheme.accent-soft
        : (root.theme-index == 2 ? PinkTheme.accent-soft : LightTheme.accent-soft);
    out property <color> playingSoft: root.theme-index == 1
        ? DarkTheme.playing-soft
        : (root.theme-index == 2 ? PinkTheme.playing-soft : LightTheme.playing-soft);
    out property <color> accentPressed: root.theme-index == 1
        ? DarkTheme.accent-pressed
        : (root.theme-index == 2 ? PinkTheme.accent-pressed : LightTheme.accent-pressed);
    out property <color> accent: root.theme-index == 2 ? #D85C91 : #1677E8;
    out property <color> accentHover: root.theme-index == 2 ? #C94D82 : #0D66D0;
    out property <color> ok: #22B879;
    out property <color> warn: #D98A18;
    out property <color> danger: #D94B55;
    out property <color> onAccent: #FFFFFF;
    out property <color> text: root.theme-index == 1
        ? DarkTheme.text
        : (root.theme-index == 2 ? PinkTheme.text : LightTheme.text);
    out property <color> text2: root.theme-index == 1
        ? DarkTheme.text2
        : (root.theme-index == 2 ? PinkTheme.text2 : LightTheme.text2);
    out property <color> text3: root.theme-index == 1
        ? DarkTheme.text3
        : (root.theme-index == 2 ? PinkTheme.text3 : LightTheme.text3);

    out property <length> radiusCard: 8px;
    out property <length> radiusControl: 5px;
    out property <length> padPage: 20px;
    out property <length> padCard: 16px;
    out property <length> padSection: 12px;
    out property <length> gap: 10px;
    out property <length> gapLg: 16px;
    out property <length> controlHeight: 36px;
    out property <length> topBarHeight: 96px;
    out property <length> statusBarHeight: 48px;
    out property <length> meterHeight: 28px;
}
