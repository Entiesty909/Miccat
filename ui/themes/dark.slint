//! 深色主题调色板：为 Theme 提供可独立替换的深色 token。

export global DarkTheme {
    out property <color> bg: #101216;
    out property <color> bar-bg: #181B21;
    out property <color> page-bg: #101216;
    out property <color> card: #181B21;
    out property <color> field: #22262E;
    out property <color> border: #303640;
    out property <color> border-strong: #424A58;
    out property <color> accent-soft: #33253D;
    out property <color> playing-soft: #232735;
    out property <color> accent-pressed: #453150;
    out property <color> text: #F4F7FB;
    out property <color> text2: #B2BAC7;
    out property <color> text3: #7F8998;
}
