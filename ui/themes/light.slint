//! 浅色主题调色板：为 Theme 提供可独立替换的浅色 token。

export global LightTheme {
    out property <color> bg: #F5F9FE;
    out property <color> bar-bg: #FFFFFF;
    out property <color> page-bg: #F5F9FE;
    out property <color> card: #FFFFFF;
    out property <color> field: #FFFFFF;
    out property <color> border: #DCE7F2;
    out property <color> border-strong: #C8D8E8;
    out property <color> accent-soft: #E8F2FF;
    out property <color> playing-soft: #F2F7FC;
    out property <color> accent-pressed: #D5E8FF;
    out property <color> text: #172435;
    out property <color> text2: #657487;
    out property <color> text3: #8A98A8;
}
