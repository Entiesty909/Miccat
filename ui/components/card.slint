//! 轻量内容分组容器：白底、细边框和小圆角，不承担业务状态。

import { Theme } from "../theme.slint";

// 内容分组容器：统一卡片外观和子项间距，不保存业务状态。
export component Card inherits Rectangle {
    background: Theme.content-card;
    border-radius: Theme.radiusCard;
    border-width: 1px;
    border-color: Theme.border;

    VerticalLayout {
        width: 100%;
        padding: Theme.padCard;
        spacing: Theme.gap;
        alignment: LayoutAlignment.start;
        // 子内容通过插槽放入统一内边距和间距的纵向容器。
        @children
    }
}
