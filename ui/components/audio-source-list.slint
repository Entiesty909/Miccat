//! 添加路由时搜索并选择真实音频库条目。

import { LineEdit, ScrollView } from "std-widgets.slint";
import { Theme } from "../theme.slint";

// 添加路由时提供可筛选的音频库条目列表，并维护当前选中索引。
export component AudioSourceList inherits Rectangle {
    // 音频库条目名称，所有并行元数据数组都按此数组的索引对齐。
    in-out property <[string]> entries: [];
    // 条目副标题（格式/码率等），缺失索引时由视图显示空字符串。
    in-out property <[string]> metadata: [];
    // 当前选中条目在 entries 中的索引，点击行后写回并交给宿主使用。
    in-out property <int> selected-index: 0;
    // 搜索框中的原始文本；过滤仅影响可见性，不重排 entries。
    in-out property <string> search: "";
    // 搜索文本变化时通知宿主刷新相关状态或预览。
    callback search-changed();
    // 对单个名称做不区分大小写的包含匹配，空查询匹配所有条目。
    function matches(name: string) -> bool {
        return root.search.is-empty
            || name.to-lowercase().replace-all(
                root.search.to-lowercase(),
                ""
            ) != name.to-lowercase();
    }

    width: 330px;
    border-radius: Theme.radiusControl;
    border-width: 1px;
    border-color: Theme.border;
    background: Theme.card;

    VerticalLayout {
        padding: 12px;
        spacing: 8px;
            // 搜索框与 search 双向绑定，文本编辑只触发宿主侧的过滤刷新。
        LineEdit {
            height: 34px;
            text <=> root.search;
            // 编辑事件只通知过滤状态，entries 仍由宿主提供并保持原始顺序。
            edited(value) => { root.search-changed(); }
        }
        ScrollView {
            vertical-stretch: 1;
            vertical-scrollbar-policy: always-off;
            VerticalLayout {
                // index 同时索引 entries 与 metadata；筛选只改变高度，不能破坏该协议。
                for entry[index] in root.entries: Rectangle {
                    visible: root.matches(entry);
                    height: root.matches(entry) ? 52px : 0px;
                    border-radius: Theme.radiusControl;
                    background: index == root.selected-index
                        ? Theme.accentSoft
                        : transparent;
                    VerticalLayout {
                        padding-left: 9px;
                        padding-right: 8px;
                        spacing: 3px;
                        Text {
                            text: entry;
                            color: Theme.text;
                            font-size: 11px;
                            overflow: elide;
                        }
                        Text {
                            text: index < root.metadata.length
                                ? root.metadata[index]
                                : "";
                            color: Theme.text3;
                            font-size: 9px;
                            overflow: elide;
                    }
                    }
                    // 选中事件仅写回索引，宿主随后决定详情展示或路由操作。
                    TouchArea {
                        clicked => {
                            root.selected-index = index;
                        }
                    }
                }
            }
        }
    }
}
