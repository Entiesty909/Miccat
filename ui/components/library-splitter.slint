//! 音频库三栏之间可拖动调整宽度的窄分隔条。

import { Theme } from "../theme.slint";

export component LibrarySplitter inherits Rectangle {
    in property <length> bar-width: 8px;
    in property <length> value: 0px;
    in property <bool> reverse-delta: false;
    callback resized(length);
    width: root.bar-width;
    height: 100%;
    background: transparent;
    // 拖动用屏幕坐标差，避免宽度更新移动分隔条后改变局部坐标。
    in-out property <length> drag-start: 0px;
    in-out property <length> drag-pointer-start: 0px;

    area := TouchArea {
        width: 100%;
        height: 100%;
        mouse-cursor: ew-resize;
        pointer-event(event) => {
            if event.kind == PointerEventKind.down {
                root.drag-start = root.value;
                root.drag-pointer-start = self.absolute-position.x + self.mouse-x;
            }
        }
        moved => {
            let pointer-x = self.absolute-position.x + self.mouse-x;
            let delta = pointer-x - root.drag-pointer-start;
            root.resized(root.drag-start + (root.reverse-delta ? -delta : delta));
        }
    }

    states [
        hovered when area.has-hover: {
            background: Theme.borderStrong;
        }
        dragging when area.pressed: {
            background: Theme.accent;
        }
    ]
}
