//! 设置页「诊断与日志」卡片：打开问题中心与日志文件。

import { Theme } from "../theme.slint";
import { DiagState } from "../overlays/global-overlays.slint";
import { Card } from "card.slint";
import { SectionTitle } from "section-title.slint";
import { PmButton } from "button.slint";

// 诊断与日志设置卡片：提供打开全局问题中心及日志文件的入口。
export component DiagnosticsCard inherits Card {
    Text {
        text: "问题中心汇总运行期的警告与错误，可查看详情、复制并打开日志文件。";
        color: Theme.text2;
        font-size: 12px;
        wrap: word-wrap;
    }
    HorizontalLayout {
        height: 42px;
        spacing: 10px;
        // 按钮只发起全局状态操作，抽屉/文件处理由共享桥接层完成。
        // 打开问题中心只切换全局抽屉状态，列表数据由 DiagState 提供。
        PmButton {
            label: "打开问题中心";
            filled: true;
            clicked => { DiagState.toggle(); }
        }
        // 日志文件操作同样交由全局诊断状态执行，组件不直接访问文件系统。
        PmButton {
            label: "打开日志文件";
            clicked => { DiagState.open-log(); }
        }
        Rectangle { horizontal-stretch: 1; background: transparent; }
    }
    Text {
        text: "日志文件：%APPDATA%\\Miccat\\logs\\miccat.log";
        color: Theme.text3;
        font-size: 12px;
        wrap: word-wrap;
    }
    Text {
        text: "组件日志级别在「问题中心 → 日志」标签页内单独调节，修改即时生效。";
        color: Theme.text3;
        font-size: 12px;
        wrap: word-wrap;
    }
}
