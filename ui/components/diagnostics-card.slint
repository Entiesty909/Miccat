//! 设置页「诊断与日志」卡片：打开问题中心与日志文件。

import { Theme } from "../theme.slint";
import { DiagState } from "../overlays/global-overlays.slint";
import { Card } from "card.slint";
import { SectionTitle } from "section-title.slint";
import { PmButton } from "button.slint";

export component DiagnosticsCard inherits Card {
    SectionTitle { label: "诊断与日志"; }
    Text {
        text: "问题中心汇总运行期的警告与错误，可查看详情、复制并打开日志文件。";
        color: Theme.text2;
        font-size: 12px;
        wrap: word-wrap;
    }
    HorizontalLayout {
        height: 42px;
        spacing: 10px;
        PmButton {
            label: "打开问题中心";
            filled: true;
            clicked => { DiagState.toggle(); }
        }
        PmButton {
            label: "打开日志文件";
            clicked => { DiagState.open-log(); }
        }
        Rectangle { horizontal-stretch: 1; background: transparent; }
    }
    Text {
        text: "日志文件：%APPDATA%\\ProcessMic\\logs\\processmic.log";
        color: Theme.text3;
        font-size: 12px;
        wrap: word-wrap;
    }
    Text {
        text: "组件日志级别在「问题中心 → 日志」标签页内单独调节，修改即时生效。";
        color: Theme.text3;
        font-size: 12px;
        wrap: word-wrap;
    }
}
