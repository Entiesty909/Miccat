//! 问题中心的行与徽标：级别圆点、未读徽标、单条问题行。

import { Theme } from "../theme.slint";

// 严重级别圆点：0 灰、1 黄、2 红。
export component SeverityDot inherits Rectangle {
    in property <int> severity: 0;
    width: 8px;
    height: 8px;
    border-radius: 4px;
    background: root.severity == 2
        ? Theme.danger
        : (root.severity == 1 ? Theme.warn : Theme.text3);
}

// 未读数徽标。
export component UnseenBadge inherits Rectangle {
    in property <int> count: 0;
    height: 18px;
    min-width: 18px;
    border-radius: 9px;
    background: Theme.danger;
    HorizontalLayout {
        padding-left: 5px; padding-right: 5px;
        alignment: center;
        Text {
            text: "\{root.count}";
            color: Theme.onAccent;
            font-size: 11px;
            vertical-alignment: TextVerticalAlignment.center;
        }
    }
}

// 单条问题行：级别圆点 + 标题 + 来源与时间。
export component DiagRow inherits Rectangle {
    in property <int> severity: 0;
    in property <string> title: "";
    in property <string> source: "";
    in property <string> time: "";
    in property <bool> selected: false;
    callback picked();

    height: 52px;
    background: root.selected ? Theme.accentSoft : Theme.card;
    Rectangle { y: parent.height - 1px; width: 100%; height: 1px; background: Theme.border; }
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 12px;
        spacing: 10px;
        SeverityDot { severity: root.severity; }
        VerticalLayout {
            horizontal-stretch: 1;
            min-width: 0px;
            spacing: 2px;
            Text { text: root.title; color: Theme.text; font-size: 13px; overflow: elide; }
            Text {
                text: "\{root.source} · \{root.time}";
                color: Theme.text3;
                font-size: 11px;
                overflow: elide;
            }
        }
    }
    ta := TouchArea { mouse-cursor: pointer; clicked => { root.picked(); } }
    states [
        hovered when ta.has-hover: { background: Theme.accentSoft; }
    ]
}
