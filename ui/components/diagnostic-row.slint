//! 问题中心的行与徽标：级别圆点、未读徽标、单条问题行。

import { Theme } from "../theme.slint";

// 严重级别圆点：severity 由诊断数据提供，0 灰、1 黄、2 红。
export component SeverityDot inherits Rectangle {
    // 诊断级别枚举值；0 普通、1 警告、2 错误。
    in property <int> severity: 0;
    width: 8px;
    height: 8px;
    border-radius: 4px;
    background: root.severity == 2
        ? Theme.danger
        : (root.severity == 1 ? Theme.warn : Theme.text3);
}

// 未读数徽标：显示问题中心当前累计的未读条数。
export component UnseenBadge inherits Rectangle {
    // 未读数量，由诊断状态聚合提供。
    in property <int> count: 0;
    width: max(22px, badge-count.preferred-width + 12px);
    height: 20px;
    border-radius: 10px;
    background: Theme.danger;
    HorizontalLayout {
        padding-left: 6px;
        padding-right: 6px;
        alignment: center;
        badge-count := Text {
            text: "\{root.count}";
            color: Theme.onAccent;
            font-size: 11px;
            font-weight: 600;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

// 单条问题行：展示来源数据并把选择动作交由问题中心处理。
export component DiagRow inherits Rectangle {
    // 当前记录的严重级别。
    in property <int> severity: 0;
    // 诊断标题。
    in property <string> title: "";
    // 产生日志/问题的组件或来源。
    in property <string> source: "";
    // 记录发生时间的展示文本。
    in property <string> time: "";
    // 与问题中心选中索引同步的视觉状态。
    in property <bool> selected: false;
    // 点击该行时通知父级更新当前选择项。
    callback picked();
    height: 64px;
    background: root.selected ? Theme.accentSoft : Theme.card;
    Rectangle {
        y: parent.height - 1px;
        width: 100%;
        height: 1px;
        background: Theme.border;
    }
    HorizontalLayout {
        padding-left: 18px;
        padding-right: 18px;
        spacing: 12px;
        VerticalLayout {
            width: 8px;
            height: 100%;
            alignment: center;
            SeverityDot { severity: root.severity; }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            min-width: 0px;
            alignment: center;
            spacing: 4px;
            Text {
                text: root.title;
                color: Theme.text;
                font-size: 13px;
                font-weight: root.selected ? 600 : 400;
                overflow: elide;
            }
            HorizontalLayout {
                spacing: 6px;
                Text {
                    text: root.source;
                    color: Theme.text2;
                    font-size: 11px;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
                Text {
                    text: root.time;
                    color: Theme.text3;
                    font-size: 11px;
                    overflow: elide;
                    horizontal-alignment: right;
                }
            }
        }
    }
    // 行级命中区覆盖整行，点击只报告选择而不直接改诊断数据。
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.picked(); }
    }
    states [
        hovered when ta.has-hover: { background: Theme.accentSoft; }
    ]
}
