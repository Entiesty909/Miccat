//! 扁平按钮。主按钮使用 Windows 蓝色，次按钮保持白底细边框。

import { Theme } from "../theme.slint";

// 扁平按钮：调用方提供文案、状态与尺寸，点击通过 clicked 向外通知。
export component PmButton inherits Rectangle {
    // 展示文案；icon-only 为真时按图标字体解释。
    in property <string> label: "";
    // 禁用时同时阻止触摸输入并降低视觉强调。
    in property <bool> enabled: true;
    // 使用强调色实心背景。
    in property <bool> filled: false;
    // 表示当前选中态，使用柔和强调色。
    in property <bool> selected: false;
    // 危险操作使用危险色，优先于常规填充状态。
    in property <bool> danger: false;
    // 无边框透明样式，常用于工具栏按钮。
    in property <bool> flat: false;
    // 用户点击且按钮启用时触发，不在组件内执行业务操作。
    callback clicked();
    // 以 Segoe MDL2 Assets 字体显示图标而非普通文本。
    in property <bool> icon-only: false;
    // 最小按钮宽度，也影响内部水平留白。
    in property <length> button-width: 76px;
    // 可选图片图标；是否显示由显式布尔值控制，避免把 image 当 bool 使用。
    in property <image> icon-image;
    in property <bool> has-icon-image: false;
    // 高度默认跟随标准控件尺寸；紧凑状态栏可按需缩小。
    in property <length> button-height: Theme.controlHeight;
    // 图标按钮悬停时显示操作说明；空值不创建提示浮层。
    in property <string> hint: "";

    height: root.button-height;
    min-width: root.button-width;
    border-radius: Theme.radiusControl;
    opacity: root.enabled ? 1.0 : 0.45;
    background: root.danger
        ? Theme.danger
        : (root.selected
            ? Theme.accentSoft
            : (root.filled ? Theme.accent : (root.flat ? transparent : Theme.field)));
    border-width: root.flat ? 0px : 1px;
    border-color: root.danger
        ? Theme.danger
        : (root.selected
            ? Theme.accentSoft
            : (root.flat ? transparent : Theme.borderStrong));

    HorizontalLayout {
        width: 100%;
        height: 100%;
        padding-left: root.button-width < 60px ? 4px : 12px;
        padding-right: root.button-width < 60px ? 4px : 12px;
        alignment: root.icon-only
            ? LayoutAlignment.center
            : (root.flat ? LayoutAlignment.start : LayoutAlignment.center);
        if !root.has-icon-image: Text {
            text: root.label;
            color: root.selected
                ? Theme.accent
                : (root.filled || root.danger ? Theme.onAccent : Theme.text);
            font-family: root.icon-only ? "Segoe MDL2 Assets" : "Segoe UI";
            font-size: root.icon-only ? 16px : 13px;
            font-weight: 600;
            horizontal-alignment: root.icon-only ? center : left;
            vertical-alignment: center;
        }
    }
    // 图片图标脱离文字布局，按按钮自身宽高分别居中定位。
    if root.has-icon-image: Image {
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        width: 24px;
        height: 24px;
        image-fit: contain;
        source: root.icon-image;
    }
    // 使用 Slint 原生 Tooltip，延迟出现并随指针离开关闭，不占按钮布局空间。
    if root.hint != "": Tooltip {
        text: @markdown("\{root.hint}");
    }

    // 透明命中区只负责把启用按钮的点击事件转发给调用方。
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    // 悬停与按下只改变视觉反馈，不修改按钮属性或业务状态。

    states [
        hovered when ta.has-hover && root.enabled: {
            background: root.danger
                ? Theme.danger
                : (root.filled || root.selected
                    ? Theme.accentHover
                    : Theme.accentSoft);
        }
        pressed when ta.pressed && root.enabled: {
            background: root.danger
                ? Theme.danger
                : (root.filled || root.selected
                    ? Theme.accentHover
                    : Theme.accentPressed);
            opacity: 0.82;
        }
    ]
}
