//! 路由页单条音频源卡片：源信息、文件播放控制、输出设置和转发开关。

import { Theme } from "../theme.slint";
import { MarqueeComboBox } from "marquee-combo-box.slint";
import { PmButton } from "button.slint";
import { Slider } from "std-widgets.slint";
import { SliderRow } from "slider-row.slint";
import { ForwardSwitch } from "forward-switch.slint";

// 三类源共用同一横向骨架；文件源在信息区与设置区之间插入播放控制。
export component SourceRow inherits Rectangle {
    // 源类型协议：0 进程、1 文件、2 麦克风。
    in property <int> kind: 0;
    // 混合源列表中的稳定行号，所有事件都携带该值回到桥接层。
    in property <int> row-index: 0;
    // 文件与麦克风使用的 MDL2 回退图标。
    in property <string> icon: "";
    // 进程或文件的真实图标；空图像时显示回退字形。
    in property <image> icon-image;
    // 进程名、音频库备注名或“麦克风”。
    in property <string> title: "";
    // 进程 PID、音频分类或物理麦克风型号。
    in property <string> subtitle: "";
    // 保持并行行模型的旧详情字段；本卡片不显示。
    in property <string> detail: "";
    // 运行、连接或文件播放状态。
    in property <string> status: "";
    // 当前槽位是否参与转发。
    in property <bool> active: false;
    // 文件槽是否暂停。
    in property <bool> paused: false;
    // 进程/麦克风是否静音。
    in property <bool> muted: false;
    // 全局路由运行态；设备下拉在运行时锁定。
    in property <bool> route-running: false;
    // 输出设备显示模型。
    in property <[string]> outputs: [];
    // 当前卡片逐设备勾选状态，索引与 outputs 对齐，只是持久化 ID 的视图投影。
    in property <[bool]> selected-outputs: [];
    // 下拉收起时列出所选设备的 Windows 友好名。
    in property <string> selected-output-label: "";
    // 当前槽位转发音量，单位百分比。
    in-out property <float> volume: 100;
    // 文件播放模式：0 顺序、1 列表循环、2 单曲循环、3 随机。
    in property <int> play-mode: 0;
    // 文件播放进度，范围 0..=1。
    in property <float> progress: 0;
    // 文件当前时间文本。
    in property <string> position-text: "";
    // 文件总时长文本。
    in property <string> duration-text: "";
    // 拖动时仅保存本卡片的临时位置；引擎进度仍由 bridge 权威发布。
    property <float> seek-draft: 0;
    // 拖动期间暂不让定时轮询覆盖滑块。
    property <bool> seeking-progress: false;
    // 菜单打开态只用于强调右上角入口。
    in property <bool> actions-open: false;
    // 点击后先翻转上三角，再由计时器请求弹出菜单。
    property <bool> menu-opening: false;
    // 当前状态是否使用强调色。
    property <bool> status-active: root.status == "运行中"
        || root.status == "已连接"
        || root.status == "播放中";
    // 播放模式按钮图标随模式切换。
    property <string> mode-icon: root.play-mode == 3
        ? "\u{E8B1}"
        : (root.play-mode == 0
            ? "\u{E8FD}"
            : (root.play-mode == 1 ? "\u{E8EE}" : "\u{E8ED}"));
    // 模式说明仅用作 Tooltip，不常驻在按钮中。
    property <string> mode-label: root.play-mode == 0
        ? "顺序播放"
        : (root.play-mode == 1
            ? "列表循环"
            : (root.play-mode == 2 ? "单曲循环" : "随机播放"));
    // 音量图标的悬停文案随静音状态更新，不占卡片右侧空间。
    property <string> mute-hint: root.muted ? "取消静音" : "静音";
    // 运行中已启用的卡片不允许弹出操作菜单。
    property <string> menu-hint: root.route-running && root.active
        ? "转发中不可操作"
        : "源操作";


    // 转发开关变化。
    callback active-toggled(bool);
    // 转发音量变化。
    callback volume-edited(float);
    // 进程/麦克风静音变化。
    callback mute-toggled();
    // 设备勾选变化由 bridge 按设备 ID 写回该卡片，不改变其他卡片。
    callback output-toggled(int, bool);
    // 右上角菜单请求，参数是窗口绝对坐标。
    callback actions-requested(length, length);
    // 菜单关闭通知。
    callback actions-closed();
    // 文件源播放或暂停。
    callback pause();
    // 文件源停止；入口保留给操作菜单。
    callback stop();
    // 文件源上一首。
    callback previous();
    // 文件源下一首。
    callback next-track();
    // 文件源播放模式循环切换。
    callback play-mode-cycled();
    // 用户释放进度滑块后提交 0..=1 的目标位置。
    callback progress-seek(float);
    // 源操作菜单动作码。
    callback action(int);

    width: 100%;
    height: 160px;
    background: Theme.content-card;
    border-radius: 12px;
    border-width: 1px;
    border-color: root.actions-open ? Theme.accent : Theme.borderStrong;
    // 定时器与图标翻转时长一致；重复点击不会叠加菜单请求。
    Timer {
        interval: 150ms;
        running: root.menu-opening;
        triggered => {
            root.menu-opening = false;
            if (!root.route-running || !root.active) {
                root.actions-requested(
                    root.absolute-position.x + root.width - 230px,
                    root.absolute-position.y + 34px
                );
            }
        }
    }

    // 开启的卡片沿左侧显示蓝色标识，不占用内容布局宽度。
    Rectangle {
        x: 0px;
        y: 12px;
        width: 4px;
        height: parent.height - 24px;
        border-radius: 2px;
        background: root.active ? #1677E8 : transparent;
    }

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        padding-top: 12px;
        padding-bottom: 12px;
        spacing: 12px;

        // 图标和信息在整张卡片高度内居中，窄窗口保留播放与百分比的宽度。
        Rectangle {
            width: root.width < 1050px
                ? 190px
                : (root.kind == 1 ? 240px : 320px);
            height: 100%;
            background: transparent;
            Rectangle {
                x: 0px;
                y: (parent.height - self.height) / 2;
                width: 64px;
                height: 64px;
                border-radius: 14px;
                background: root.kind == 0
                    ? Theme.accentSoft
                    : (root.kind == 1 ? #DDF6EA : #DDEBFF);
                if root.kind != 0: Text {
                    text: root.icon;
                    font-family: "Segoe MDL2 Assets";
                    color: root.kind == 1 ? #18A67A : Theme.accent;
                    font-size: 31px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                Image {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    width: 44px;
                    height: 44px;
                    image-fit: contain;
                    source: root.icon-image;
                }
            }
            VerticalLayout {
                x: 76px;
                width: parent.width - 76px;
                height: 100%;
                spacing: 5px;
                alignment: LayoutAlignment.center;
                Text {
                    text: root.title;
                    color: Theme.text;
                    font-size: 16px;
                    font-weight: 700;
                    overflow: elide;
                    Tooltip {
                        text: @markdown("\{root.kind == 1 ? root.subtitle : root.title}");
                    }
                }
                if root.kind != 1: Text {
                    text: root.subtitle;
                    color: Theme.text2;
                    font-size: 12px;
                    overflow: elide;
                    Tooltip {
                        text: @markdown("\{root.subtitle}");
                    }
                }
                Rectangle {
                    width: 82px;
                    height: 26px;
                    border-radius: 7px;
                    background: root.status-active ? Theme.accentSoft : Theme.border;
                    Text {
                        text: root.status;
                        color: root.status-active ? Theme.accent : Theme.text2;
                        font-size: 12px;
                        font-weight: 600;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }

        // 文件卡片独有的上一首、播放、下一首、模式和进度区。
        if root.kind == 1: VerticalLayout {
            width: root.width < 1050px ? 186px : 220px;
            spacing: 8px;
            alignment: LayoutAlignment.center;
            HorizontalLayout {
                height: 42px;
                spacing: 8px;
                alignment: LayoutAlignment.center;
                PmButton {
                    label: "\u{E892}";
                    icon-only: true;
                    icon-transparent: true;
                    button-width: 38px;
                    hint: "上一曲";
                    enabled: true;
                    clicked => { root.previous(); }
                }
                PmButton {
                    label: root.status == "播放中" ? "\u{E769}" : "\u{E768}";
                    icon-only: true;
                    icon-transparent: true;
                    button-width: 42px;
                    hint: root.status == "播放中" ? "暂停" : "播放";
                    enabled: true;
                    clicked => { root.pause(); }
                }
                PmButton {
                    label: "\u{E893}";
                    icon-only: true;
                    button-width: 38px;
                    icon-transparent: true;
                    hint: "下一曲";
                    enabled: true;
                    clicked => { root.next-track(); }
                }
                // 一个图标按钮循环四种模式，文字只出现在悬停提示中。
                PmButton {
                    label: root.mode-icon;
                    icon-only: true;
                    icon-transparent: true;
                    button-width: 38px;
                    hint: root.mode-label;
                    clicked => { root.play-mode-cycled(); }
                }
            }
            // 滑动时显示草稿位置，松开后才把定位交给引擎；停播时不会误启动。
            Slider {
                width: 100%;
                height: 20px;
                minimum: 0;
                maximum: 1;
                value: root.seeking-progress ? root.seek-draft : root.progress;
                enabled: (root.status == "播放中" || root.status == "已暂停")
                    && root.duration-text != "";
                changed(value) => {
                    root.seek-draft = value;
                    root.seeking-progress = true;
                }
                released(value) => {
                    root.seeking-progress = false;
                    root.progress-seek(value);
                }
            }
            HorizontalLayout {
                height: 18px;
                Text {
                    text: root.position-text;
                    color: Theme.text3;
                    font-size: 11px;
                }
                Rectangle { horizontal-stretch: 1; background: transparent; }
                Text {
                    text: root.duration-text;
                    color: Theme.text3;
                    font-size: 11px;
                }
            }
        }

        // 信息与设备设置之间的纵向分隔线。
        Rectangle {
            width: 1px;
            height: 100%;
            background: Theme.border;
        }

        // 右侧设置区与参考图一致按输出、转发音量、预览音量排列。
        VerticalLayout {
            horizontal-stretch: 1;
            min-width: 250px;
            spacing: 7px;
            alignment: LayoutAlignment.center;
            HorizontalLayout {
                height: 36px;
                spacing: 10px;
                Text {
                    text: "\u{E7F4}";
                    font-family: "Segoe MDL2 Assets";
                    color: Theme.text2;
                    font-size: 18px;
                    vertical-alignment: center;
                }
                Text {
                    text: "输出设备";
                    width: 72px;
                    color: Theme.text2;
                    font-size: 13px;
                    vertical-alignment: center;
                }
                MarqueeComboBox {
                    width: root.width < 1050px ? 240px : 300px;
                    horizontal-stretch: 0;
                    height: 34px;
                    model: root.outputs;
                    multi-select: true;
                    checked: root.selected-outputs;
                    multi-label: root.selected-output-label;
                    enabled: !root.route-running;
                    selection-toggled(index, checked) => {
                        root.output-toggled(index, checked);
                    }
                }
                Rectangle {
                    horizontal-stretch: 1;
                    background: transparent;
                }
            }
            HorizontalLayout {
                height: 36px;
                spacing: 10px;
                // 进程和麦克风的原音量图标兼任静音入口；文件音量图标仍只展示。
                if root.kind != 1: Rectangle {
                    width: 18px;
                    height: 36px;
                    background: transparent;
                    Text {
                        text: root.muted ? "\u{E74F}" : "\u{E767}";
                        font-family: "Segoe MDL2 Assets";
                        color: root.muted ? Theme.text3 : Theme.text2;
                        font-size: 18px;
                        vertical-alignment: center;
                    }
                    Tooltip {
                        text: @markdown("\{root.mute-hint}");
                    }
                    TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.mute-toggled(); }
                    }
                }
                if root.kind == 1: Text {
                    text: "\u{E767}";
                    font-family: "Segoe MDL2 Assets";
                    color: Theme.text2;
                    font-size: 18px;
                    vertical-alignment: center;
                }
                Text {
                    text: "转发音量";
                    width: 72px;
                    color: Theme.text2;
                    font-size: 13px;
                    vertical-alignment: center;
                }
                SliderRow {
                    width: root.kind == 1 && root.width < 1050px ? 240px : 300px;
                    horizontal-stretch: 0;
                    show-label: false;
                    value <=> root.volume;
                    edited(value) => { root.volume-edited(value); }
                }
                Rectangle {
                    horizontal-stretch: 1;
                    background: transparent;
                }
            }
            // 文件源把开关单独放在第三行，避免挤占百分比和播放控制的横向空间。
            if root.kind == 1: HorizontalLayout {
                height: 36px;
                ForwardSwitch {
                    active: root.active;
                    enabled: true;
                    toggled(value) => { root.active-toggled(value); }
                }
            }
            if root.kind == 0: HorizontalLayout {
                height: 36px;
                spacing: 10px;
                Text {
                    text: "\u{E767}";
                    font-family: "Segoe MDL2 Assets";
                    color: Theme.text3;
                    font-size: 18px;
                    vertical-alignment: center;
                }
                Text {
                    text: "预览音量";
                    width: 72px;
                    color: Theme.text3;
                    font-size: 13px;
                    vertical-alignment: center;
                }
                // 本轮仅提供不可交互占位，不向 bridge 上报或保存数值。
                SliderRow {
                    width: 300px;
                    horizontal-stretch: 0;
                    show-label: false;
                    enabled: false;
                    value: 0;
                    value-text: "-";
                }
                Rectangle {
                    horizontal-stretch: 1;
                    background: transparent;
                }
            }
        }

        // 进程和麦克风保持原右侧开关位置；文件源在设置区第三行操作。
        if root.kind != 1: VerticalLayout {
            min-width: 110px;
            max-width: 110px;
            alignment: LayoutAlignment.center;
            ForwardSwitch {
                active: root.active;
                enabled: !root.route-running;
                toggled(value) => { root.active-toggled(value); }
            }
        }
    }

    // 原“...”菜单入口改为卡片右上角上三角；动作内容和 PopupWindow 不变。
    Rectangle {
        x: root.width - 34px;
        y: 8px;
        width: 26px;
        height: 24px;
        border-radius: 6px;
        background: root.actions-open || root.menu-opening ? Theme.accentSoft : transparent;
        Tooltip {
            text: @markdown("\{root.menu-hint}");
        }
        // 软件渲染器不支持旋转变换；上下箭头交错下移和淡入模拟翻下。
        Text {
            width: parent.width;
            height: parent.height;
            y: root.menu-opening || root.actions-open ? 3px : 0px;
            opacity: root.menu-opening || root.actions-open ? 0 : 1;
            text: "\u{E70E}";
            font-family: "Segoe MDL2 Assets";
            color: root.route-running && root.active ? Theme.text3 : Theme.text2;
            font-size: 15px;
            horizontal-alignment: center;
            vertical-alignment: center;
            animate y {
                duration: 150ms;
                easing: ease-in-out;
            }
            animate opacity {
                duration: 150ms;
                easing: ease-in-out;
            }
        }
        Text {
            width: parent.width;
            height: parent.height;
            y: root.menu-opening || root.actions-open ? 0px : -3px;
            opacity: root.menu-opening || root.actions-open ? 1 : 0;
            text: "\u{E70D}";
            font-family: "Segoe MDL2 Assets";
            color: Theme.accent;
            font-size: 15px;
            horizontal-alignment: center;
            vertical-alignment: center;
            animate y {
                duration: 150ms;
                easing: ease-in-out;
            }
            animate opacity {
                duration: 150ms;
                easing: ease-in-out;
            }
        }
        // 坐标锚定上三角下方，菜单由 RoutePage 的 PopupWindow 承载。
        TouchArea {
            enabled: !root.route-running || !root.active;
            mouse-cursor: pointer;
            clicked => {
                if (!root.menu-opening && !root.actions-open) {
                    root.menu-opening = true;
                }
            }
        }
    }
}
