//! 路由页单条真实音频源：名称、输出目标、增益、启用状态和操作入口。

import { Theme } from "../theme.slint";
import { MarqueeComboBox } from "marquee-combo-box.slint";
import { PmButton } from "button.slint";
import { SliderRow } from "slider-row.slint";
export component SourceRow inherits Rectangle {
    in property <int> kind: 0;
    in property <int> row-index: 0;
    in property <string> icon: "";
    in property <image> icon-image;
    in property <string> title: "";
    in property <string> subtitle: "";
    in property <string> detail: "";
    in property <string> status: "";
    in property <bool> active: false;
    in property <bool> paused: false;
    in property <bool> muted: false;
    in property <bool> route-running: false;
    in property <[string]> outputs: [];
    in property <int> initial-output-index: 0;
    in-out property <int> output-index: 0;
    init => {
        root.output-index = root.initial-output-index;
    }
    in-out property <float> volume: 100;
    callback active-toggled(bool);
    callback volume-edited(float);
    callback mute-toggled();
    callback output-changed(int);
    callback action(int);
    callback actions-requested(length, length);
    callback actions-closed();
    callback pause();
    callback stop();
    in property <bool> actions-open: false;

    height: 112px;
    width: 100%;
    background: Theme.card;
    border-radius: Theme.radiusCard;
    border-width: root.active ? 2px : 1px;
    border-color: root.active ? Theme.accent : Theme.borderStrong;

    Rectangle {
        x: 16px;
        y: (root.height - self.height) / 2;
        width: 56px;
        height: 56px;
        border-radius: 12px;
        background: root.kind == 0
            ? Theme.accentSoft
            : (root.kind == 1 ? #EEE9FF : #DDF6F0);
        if root.kind != 0: Text {
            text: root.icon;
            font-family: "Segoe MDL2 Assets";
            color: root.kind == 2 ? #188E7A : Theme.accent;
            font-size: 28px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        Image {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 36px;
            height: 36px;
            image-fit: contain;
            source: root.icon-image;
        }
    }

    HorizontalLayout {
        height: 100%;
        padding-left: 8px;
        padding-right: 8px;
        spacing: 6px;

        Rectangle {
            width: 76px;
            height: 1px;
            background: transparent;
        }

        VerticalLayout {
            min-width: 108px;
            preferred-width: 168px;
            horizontal-stretch: 1;
            alignment: LayoutAlignment.center;
            HorizontalLayout {
                width: 100%;
                height: 24px;
                spacing: 8px;
                Text {
                    text: root.title;
                    color: Theme.text;
                    font-size: 15px;
                    font-weight: 600;
                    horizontal-stretch: 1;
                    overflow: elide;
                    vertical-alignment: center;
                }
            }
            if root.kind == 2: VerticalLayout {
                width: 100%;
                height: 34px;
                spacing: 2px;
                Text {
                    text: root.subtitle;
                    color: Theme.text2;
                    font-size: 11px;
                    overflow: elide;
                }
                Text {
                    text: root.detail;
                    color: Theme.text3;
                    font-size: 11px;
                    overflow: elide;
                }
            }
            if root.kind != 2: Text {
                text: root.subtitle;
                color: Theme.text2;
                font-size: 11px;
                overflow: elide;
            }
            if root.kind == 0: Text {
                text: root.detail;
                color: Theme.text3;
                font-size: 11px;
                overflow: elide;
            }
        }

        VerticalLayout {
            min-width: 120px;
            preferred-width: 176px;
            horizontal-stretch: 1;
            alignment: LayoutAlignment.center;
            Text {
                text: "输出设备";
                color: Theme.text2;
                font-size: 11px;
            }
            MarqueeComboBox {
                width: 100%;
                height: 34px;
                model: root.outputs;
                current-index <=> root.output-index;
                enabled: !root.route-running;
                selected(value) => {
                    root.output-changed(root.output-index);
                }
            }
        }

        VerticalLayout {
            horizontal-stretch: 2;
            min-width: 110px;
            alignment: LayoutAlignment.center;
            Text {
                text: "音量";
                color: Theme.text2;
                font-size: 11px;
            }
            SliderRow {
                show-label: false;
                value <=> root.volume;
                edited(value) => { root.volume-edited(value); }
            }
        }

        HorizontalLayout {
            width: 258px;
            vertical-stretch: 1;
            alignment: LayoutAlignment.center;
            spacing: 8px;
            VerticalLayout {
                width: 124px;
                alignment: LayoutAlignment.center;
                HorizontalLayout {
                    width: 100%;
                    height: 36px;
                    spacing: 6px;
                    alignment: LayoutAlignment.end;
                    if root.kind != 1: PmButton {
                        label: root.muted ? "\u{E74F}" : "\u{E767}";
                        icon-only: true;
                        button-width: 36px;
                        clicked => { root.mute-toggled(); }
                    }
                    if root.kind == 1: PmButton {
                        label: root.paused ? "\u{E768}" : "\u{E769}";
                        icon-only: true;
                        button-width: 36px;
                        enabled: root.route-running
                            && (root.status == "播放中" || root.paused);
                        clicked => { root.pause(); }
                    }
                    if root.kind == 1: PmButton {
                        label: "\u{E71A}";
                        icon-only: true;
                        button-width: 36px;
                        enabled: root.route-running
                            && (root.status == "播放中" || root.paused);
                        clicked => { root.stop(); }
                    }
                    PmButton {
                        label: "\u{E712}";
                        icon-only: true;
                        button-width: 36px;
                        enabled: !root.route-running || root.kind == 1;
                        clicked => {
                            root.actions-requested(
                                root.absolute-position.x + root.width - 246px,
                                root.absolute-position.y
                                    + (root.height - 36px) / 2 + 36px
                            );
                        }
                    }
                }
            }
            VerticalLayout {
                width: 1px;
                height: 100%;
                vertical-stretch: 1;
                alignment: LayoutAlignment.center;
                Rectangle {
                    width: 1px;
                    height: 36px;
                    background: Theme.border;
                }
            }
            VerticalLayout {
                width: 126px;
                height: 100%;
                vertical-stretch: 1;
                alignment: LayoutAlignment.center;
                HorizontalLayout {
                    width: 126px;
                    height: 36px;
                    spacing: 8px;
                    alignment: LayoutAlignment.center;
                    VerticalLayout {
                        width: 42px;
                        height: 36px;
                        alignment: LayoutAlignment.center;
                        Rectangle {
                            width: 42px;
                            height: 22px;
                            border-radius: 11px;
                            background: root.active ? Theme.accent : Theme.borderStrong;
                            Rectangle {
                                x: root.active ? 22px : 2px;
                                y: 2px;
                                width: 18px;
                                height: 18px;
                                border-radius: 9px;
                                background: Theme.card;
                            }
                            TouchArea {
                                enabled: !root.route-running || root.kind == 1;
                                clicked => { root.active-toggled(!root.active); }
                            }
                        }
                    }
                Text {
                    text: "启用转发";
                    color: Theme.text;
                    font-size: 13px;
                    vertical-alignment: center;
                }
            }
        }
    }

    }
}
