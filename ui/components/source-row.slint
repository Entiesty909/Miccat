//! 路由页单条音频源卡片：源信息、文件播放控制、输出设置和转发开关。

import { Theme } from "../theme.slint";
import { MarqueeComboBox } from "marquee-combo-box.slint";
import { PmButton } from "button.slint";
import { SliderRow } from "slider-row.slint";

// 三类源共用同一横向骨架；文件源在信息区与设置区之间插入播放控制。
export component SourceRow inherits Rectangle {
    // 源类型协议：0 进程、1 文件、2 麦克风。
    in property <int> kind: 0;
    // 混合源列表中的稳定行号，所有事件都携带该值回到桥接层。
    in property <int> row-index: 0;
    // 文件与麦克风使用的 MDL2 回退图标。
    in property <string> icon: "";
    // 进程或文件的真实图标；空图像时显示回退字形。
    in property <image> icon-image;
    // 卡片主标题。
    in property <string> title: "";
    // 来源类型、格式和分类等次要信息。
    in property <string> subtitle: "";
    // 进程 PID 等补充信息。
    in property <string> detail: "";
    // 运行、连接或文件播放状态。
    in property <string> status: "";
    // 当前槽位是否参与转发。
    in property <bool> active: false;
    // 文件槽是否暂停。
    in property <bool> paused: false;
    // 进程/麦克风是否静音。
    in property <bool> muted: false;
    // 全局路由运行态；设备下拉在运行时锁定。
    in property <bool> route-running: false;
    // 输出设备显示模型。
    in property <[string]> outputs: [];
    // bridge 恢复的设备下标，只在组件初始化时写入双向属性。
    in property <int> initial-output-index: 0;
    // 当前输出设备下标。
    in-out property <int> output-index: 0;
    // 当前槽位转发音量，单位百分比。
    in-out property <float> volume: 100;
    // 文件播放模式：0 顺序、1 列表循环、2 单曲循环、3 随机。
    in property <int> play-mode: 0;
    // 文件播放进度，范围 0..=1。
    in property <float> progress: 0;
    // 文件当前时间文本。
    in property <string> position-text: "";
    // 文件总时长文本。
    in property <string> duration-text: "";
    // 菜单打开态只用于强调右上角入口。
    in property <bool> actions-open: false;
    // 当前状态是否使用强调色。
    property <bool> status-active: root.status == "运行中"
        || root.status == "已连接"
        || root.status == "播放中";
    // 播放模式按钮图标随模式切换。
    property <string> mode-icon: root.play-mode == 3
        ? "\u{E8B1}"
        : (root.play-mode == 0 ? "\u{E8FD}" : "\u{E8EE}");
    // 播放模式短标签用于消除图标歧义。
    property <string> mode-label: root.play-mode == 0
        ? "顺序"
        : (root.play-mode == 1
            ? "列表循环"
            : (root.play-mode == 2 ? "单曲循环" : "随机"));

    // 初始设备下标只同步一次，列表动态刷新不会覆盖用户当前选择。
    init => {
        root.output-index = root.initial-output-index;
    }

    // 转发开关变化。
    callback active-toggled(bool);
    // 转发音量变化。
    callback volume-edited(float);
    // 进程/麦克风静音变化。
    callback mute-toggled();
    // 输出设备变化。
    callback output-changed(int);
    // 右上角菜单请求，参数是窗口绝对坐标。
    callback actions-requested(length, length);
    // 菜单关闭通知。
    callback actions-closed();
    // 文件源播放或暂停。
    callback pause();
    // 文件源停止；入口保留给操作菜单。
    callback stop();
    // 文件源上一首。
    callback previous();
    // 文件源下一首。
    callback next-track();
    // 文件源播放模式循环切换。
    callback play-mode-cycled();
    // 源操作菜单动作码。
    callback action(int);

    width: 100%;
    height: 160px;
    background: Theme.content-card;
    border-radius: 12px;
    border-width: 1px;
    border-color: root.actions-open ? Theme.accent : Theme.borderStrong;

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        padding-top: 12px;
        padding-bottom: 12px;
        spacing: 12px;

        // 左侧源标识从卡片左边缘开始，避免布局剩余空间把内容推向右侧。
        HorizontalLayout {
            min-width: 230px;
            max-width: 250px;
            spacing: 12px;
            Rectangle {
                width: 64px;
                height: 64px;
                border-radius: 14px;
                background: root.kind == 0
                    ? Theme.accentSoft
                    : (root.kind == 1 ? #DDF6EA : #DDEBFF);
                if root.kind != 0: Text {
                    text: root.icon;
                    font-family: "Segoe MDL2 Assets";
                    color: root.kind == 1 ? #18A67A : Theme.accent;
                    font-size: 31px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                Image {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    width: 44px;
                    height: 44px;
                    image-fit: contain;
                    source: root.icon-image;
                }
            }
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 5px;
                alignment: LayoutAlignment.center;
                Text {
                    text: root.title;
                    color: Theme.text;
                    font-size: 16px;
                    font-weight: 700;
                    overflow: elide;
                }
                Text {
                    text: root.detail == ""
                        ? root.subtitle
                        : "\{root.subtitle} · \{root.detail}";
                    color: Theme.text2;
                    font-size: 12px;
                    overflow: elide;
                }
                Rectangle {
                    width: 82px;
                    height: 26px;
                    border-radius: 7px;
                    background: root.status-active ? Theme.accentSoft : Theme.border;
                    Text {
                        text: root.status;
                        color: root.status-active ? Theme.accent : Theme.text2;
                        font-size: 12px;
                        font-weight: 600;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }

        // 文件卡片独有的上一首、播放、下一首、模式和进度区。
        if root.kind == 1: VerticalLayout {
            min-width: 220px;
            max-width: 240px;
            spacing: 8px;
            alignment: LayoutAlignment.center;
            HorizontalLayout {
                height: 42px;
                spacing: 8px;
                alignment: LayoutAlignment.center;
                PmButton {
                    label: "\u{E892}";
                    icon-only: true;
                    button-width: 38px;
                    enabled: root.route-running && root.active;
                    clicked => { root.previous(); }
                }
                PmButton {
                    label: root.status == "播放中" ? "\u{E769}" : "\u{E768}";
                    icon-only: true;
                    filled: true;
                    button-width: 42px;
                    enabled: root.route-running && root.active;
                    clicked => { root.pause(); }
                }
                PmButton {
                    label: "\u{E893}";
                    icon-only: true;
                    button-width: 38px;
                    enabled: root.route-running && root.active;
                    clicked => { root.next-track(); }
                }
                Rectangle {
                    width: 76px;
                    height: 38px;
                    border-radius: 19px;
                    background: Theme.card;
                    border-width: 1px;
                    border-color: Theme.borderStrong;
                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        spacing: 5px;
                        alignment: LayoutAlignment.center;
                        Text {
                            text: root.mode-icon;
                            font-family: "Segoe MDL2 Assets";
                            color: root.play-mode == 0 ? Theme.text2 : Theme.accent;
                            font-size: 16px;
                        }
                        Text {
                            text: root.mode-label;
                            color: Theme.text2;
                            font-size: 9px;
                            overflow: elide;
                        }
                    }
                    // 单击同一控件循环四种模式，不创建四个并列开关。
                    TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.play-mode-cycled(); }
                    }
                }
            }
            Rectangle {
                width: 100%;
                height: 5px;
                border-radius: 3px;
                background: Theme.border;
                Rectangle {
                    width: parent.width * max(0, min(1, root.progress));
                    height: 100%;
                    border-radius: 3px;
                    background: Theme.accent;
                }
            }
            HorizontalLayout {
                height: 18px;
                Text {
                    text: root.position-text;
                    color: Theme.text3;
                    font-size: 11px;
                }
                Rectangle { horizontal-stretch: 1; background: transparent; }
                Text {
                    text: root.duration-text;
                    color: Theme.text3;
                    font-size: 11px;
                }
            }
        }

        // 信息与设备设置之间的纵向分隔线。
        Rectangle {
            width: 1px;
            height: 100%;
            background: Theme.border;
        }

        // 右侧设置区与参考图一致按输出、转发音量、预览音量排列。
        VerticalLayout {
            horizontal-stretch: 1;
            min-width: 250px;
            spacing: 7px;
            alignment: LayoutAlignment.center;
            HorizontalLayout {
                height: 36px;
                spacing: 10px;
                Text {
                    text: "\u{E7F4}";
                    font-family: "Segoe MDL2 Assets";
                    color: Theme.text2;
                    font-size: 18px;
                    vertical-alignment: center;
                }
                Text {
                    text: "输出设备";
                    width: 72px;
                    color: Theme.text2;
                    font-size: 13px;
                    vertical-alignment: center;
                }
                MarqueeComboBox {
                    horizontal-stretch: 1;
                    min-width: 140px;
                    height: 34px;
                    model: root.outputs;
                    current-index <=> root.output-index;
                    enabled: !root.route-running;
                    selected(value) => {
                        root.output-changed(root.output-index);
                    }
                }
            }
            HorizontalLayout {
                height: 36px;
                spacing: 10px;
                Text {
                    text: "\u{E767}";
                    font-family: "Segoe MDL2 Assets";
                    color: Theme.text2;
                    font-size: 18px;
                    vertical-alignment: center;
                }
                Text {
                    text: "转发音量";
                    width: 72px;
                    color: Theme.text2;
                    font-size: 13px;
                    vertical-alignment: center;
                }
                SliderRow {
                    horizontal-stretch: 1;
                    show-label: false;
                    value <=> root.volume;
                    edited(value) => { root.volume-edited(value); }
                }
                // 保留原静音能力，但收进音量行，避免破坏参考图主布局。
                if root.kind != 1: PmButton {
                    label: root.muted ? "\u{E74F}" : "\u{E767}";
                    icon-only: true;
                    button-width: 30px;
                    clicked => { root.mute-toggled(); }
                }
            }
            if root.kind != 2: HorizontalLayout {
                height: 36px;
                spacing: 10px;
                Text {
                    text: "\u{E767}";
                    font-family: "Segoe MDL2 Assets";
                    color: Theme.text3;
                    font-size: 18px;
                    vertical-alignment: center;
                }
                Text {
                    text: "预览音量";
                    width: 72px;
                    color: Theme.text3;
                    font-size: 13px;
                    vertical-alignment: center;
                }
                // 本轮仅提供不可交互占位，不向 bridge 上报或保存数值。
                SliderRow {
                    horizontal-stretch: 1;
                    show-label: false;
                    enabled: false;
                    value: 0;
                    value-text: "-";
                }
                if root.kind != 1: Rectangle {
                    width: 30px;
                    background: transparent;
                }
            }
        }

        // 最右侧开关只改变当前卡片，不启动文件解码。
        VerticalLayout {
            min-width: 110px;
            max-width: 110px;
            alignment: LayoutAlignment.center;
            HorizontalLayout {
                height: 38px;
                spacing: 10px;
                alignment: LayoutAlignment.center;
                Text {
                    text: "启用转发";
                    color: Theme.text;
                    font-size: 13px;
                    vertical-alignment: center;
                }
                Rectangle {
                    width: 48px;
                    height: 26px;
                    border-radius: 13px;
                    background: root.active ? Theme.accent : Theme.borderStrong;
                    Rectangle {
                        x: root.active ? 24px : 2px;
                        y: 2px;
                        width: 22px;
                        height: 22px;
                        border-radius: 11px;
                        background: Theme.card;
                    }
                    // 文件槽运行中仍可单独关闭；进程/麦克风运行时保持原锁定规则。
                    TouchArea {
                        enabled: !root.route-running || root.kind == 1;
                        mouse-cursor: pointer;
                        clicked => { root.active-toggled(!root.active); }
                    }
                }
            }
        }
    }

    // 原“...”菜单入口改为卡片右上角上三角；动作内容和 PopupWindow 不变。
    Rectangle {
        x: root.width - 34px;
        y: 8px;
        width: 26px;
        height: 24px;
        border-radius: 6px;
        background: root.actions-open ? Theme.accentSoft : transparent;
        Text {
            text: "\u{E70E}";
            font-family: "Segoe MDL2 Assets";
            color: root.actions-open ? Theme.accent : Theme.text2;
            font-size: 15px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        // 坐标锚定上三角下方，菜单由 RoutePage 的 PopupWindow 承载。
        TouchArea {
            enabled: !root.route-running || root.kind == 1;
            mouse-cursor: pointer;
            clicked => {
                root.actions-requested(
                    root.absolute-position.x + root.width - 230px,
                    root.absolute-position.y + 34px
                );
            }
        }
    }
}
