//! 一行「标签 + 滑条 + 百分比」。滑条值双向绑定，改动通过 edited 回调上报。

import { Slider } from "std-widgets.slint";
import { Theme } from "../theme.slint";

// 可复用音量行：value 由父级持有，edited 只上报用户操作。
export component SliderRow inherits HorizontalLayout {
// 左侧标签，可由调用方隐藏以给滑块更多宽度。
    in property <string> label: "";
// 禁用时同时限制滑块输入并降低标签强调。
    in property <bool> enabled: true;
// 百分比数值，范围由内部 Slider 限制为 0..=100。
    in-out property <float> value: 100;
// 是否显示左侧标签。
    in property <bool> show-label: true;
// 可选覆盖显示文本；用于尚未接线的占位滑块。
    in property <string> value-text: "";
// 用户拖动结束或数值改变时向 bridge 上报。
    callback edited(float);

    height: Theme.controlHeight;
    spacing: 8px;

    if root.show-label: Text {
        text: root.label;
        color: root.enabled ? Theme.text2 : Theme.text3;
        font-size: 13px;
        vertical-alignment: TextVerticalAlignment.center;
        width: 72px;
    }
    Slider {
        horizontal-stretch: 1;
        minimum: 0;
        maximum: 100;
        value <=> root.value;
        enabled: root.enabled;
        changed(v) => { root.edited(v); }
    }
    Text {
        width: 44px;
        text: root.value-text == "" ? "\{Math.round(root.value)}%" : root.value-text;
        color: root.enabled ? Theme.text : Theme.text3;
        font-size: 13px;
        font-weight: 600;
        horizontal-alignment: right;
        vertical-alignment: TextVerticalAlignment.center;
    }
}
