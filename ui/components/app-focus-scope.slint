//! 应用级键盘焦点区：分发热键录制和右键菜单 Escape 关闭。

import { HotkeyState } from "../overlays/global-overlays.slint";

export component AppFocusScope inherits FocusScope {
    in property <bool> listening-hotkey: false;
    in property <bool> listening-audio-hotkey: false;
    in property <bool> category-menu-open: false;
    in property <bool> entry-menu-open: false;
    callback hotkey-captured(string, bool, bool, bool);
    callback audio-hotkey-captured(string);
    callback audio-hotkey-binding-captured(string, bool, bool, bool);
    callback hotkey-row-captured(int, string, bool, bool, bool);
    callback audio-hotkey-pressed(string);
    callback close-menus();

    key-pressed(event) => {
        if root.listening-hotkey {
            root.hotkey-captured(
                event.text,
                event.modifiers.control,
                event.modifiers.shift,
                event.modifiers.alt
            );
            accept
        } else if HotkeyState.listening-row >= 0 {
            root.hotkey-row-captured(
                HotkeyState.listening-row,
                event.text,
                event.modifiers.control,
                event.modifiers.shift,
                event.modifiers.alt
            );
            accept
        } else if root.listening-audio-hotkey {
            root.audio-hotkey-binding-captured(
                event.text,
                event.modifiers.control,
                event.modifiers.shift,
                event.modifiers.alt
            );
            accept
        } else if event.text == "\u{1b}"
            && (root.category-menu-open || root.entry-menu-open) {
            root.close-menus();
            accept
        } else {
            root.audio-hotkey-pressed(event.text);
            reject
        }
    }
    @children
}