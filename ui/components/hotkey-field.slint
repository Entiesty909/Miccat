//! 热键显示与录制入口。按键解释与冲突判定在 ui_bridge 里做。

import { Theme } from "../theme.slint";
import { PmButton } from "button.slint";

// 热键显示与录制入口：状态由父级提供，录制和重置请求向父级转发。
export component HotkeyField inherits HorizontalLayout {
    // 热键功能说明文本。
    in property <string> label: "";
    // 当前已绑定组合键，由设置状态提供。
    in property <string> combo: "";
    // 录制期间展示等待提示并高亮字段；生命周期由父级维护。
    in property <bool> listening: false;
    // 控制更改与重置按钮是否可操作。
    in property <bool> enabled: true;
    // 请求父级开始捕获后续键盘输入。
    callback begin();
    // 请求父级清除当前热键绑定。
    callback reset();

    height: Theme.controlHeight;
    spacing: 8px;

    Text {
        text: root.label;
        color: Theme.text2;
        font-size: 13px;
        vertical-alignment: TextVerticalAlignment.center;
        width: 132px;
    }
    Rectangle {
        height: Theme.controlHeight;
        min-width: 168px;
        horizontal-stretch: 1;
        background: root.listening ? Theme.accentSoft : Theme.field;
        border-radius: Theme.radiusControl;
        border-width: 1px;
        border-color: root.listening ? Theme.accent : Theme.border;
        Text {
            text: root.listening ? "按下新快捷键…" : (root.combo == "" ? "未设置" : root.combo);
            color: root.listening ? Theme.accent : (root.combo == "" ? Theme.text3 : Theme.text);
            font-size: 13px;
            font-weight: 600;
            vertical-alignment: TextVerticalAlignment.center;
            x: 12px;
            width: parent.width - 24px;
            overflow: elide;
        }
    }
    // 更改按钮进入捕获流程，录制结果由父级回填 combo。
    PmButton {
        label: "更改";
        enabled: root.enabled;
        clicked => { root.begin(); }
    }
    // 重置按钮请求父级清除绑定并刷新显示。
    PmButton {
        label: "重置";
        enabled: root.enabled;
        clicked => { root.reset(); }
    }
}
