//! 主窗口品牌和全局操作栏：展示 Miccat 标识、主题按钮和全局操作。

import { Theme } from "../theme.slint";
import { PmButton } from "button.slint";

// 主题菜单中的单个预设色块；点击后只上报主题索引。
component ThemePreset inherits Rectangle {
    in property <int> index: 0;
    in property <color> swatch: #FFFFFF;
    in property <bool> active: false;
    callback selected(int);
    width: 54px;
    height: 54px;
    border-radius: 9px;
    border-width: root.active ? 2px : 1px;
    border-color: root.active ? Theme.accent : Theme.borderStrong;
    background: root.swatch;
    TouchArea {
        mouse-cursor: pointer;
        clicked => { root.selected(root.index); }
    }
}
export component AppHeader inherits Rectangle {
    // 当前转发引擎是否运行。
    in property <bool> running: false;
    // 后台线缆任务进行时禁止启动/停止按钮。
    in property <bool> cable-busy: false;
    // 当前主题索引：0 浅色、1 深色、2 淡粉。
    in property <int> theme-index: 0;
    // Rust 构建版本，保持与 Cargo package 版本一致。
    in property <string> version: "";
    // 请求切换转发状态。
    callback start-stop();
    // 用户从主题菜单选择预设。
    callback theme-selected(int);
    // 请求重新枚举进程、设备和音频状态。
    callback refresh();

    function toggle-theme-menu() {
        if theme-menu.is-open { theme-menu.close(); }
        else { theme-menu.show(); }
    }

    height: 58px;
    background: Theme.bar-bg;
    border-width: 1px;
    border-color: Theme.border;

    HorizontalLayout {
        width: 100%;
        height: 36px;
        // 固定行高后相对 58px 顶栏居中，避免控件贴住窗口上沿。
        y: (root.height - self.height) / 2;
        padding-left: 16px;
        padding-right: 16px;
        spacing: 10px;

        VerticalLayout {
            width: 28px;
            height: 36px;
            alignment: center;
            Image {
                source: @image-url("../../resources/icon.ico");
                width: 28px;
                height: 28px;
                image-fit: contain;
            }
        }

        // 每个字母独立着色，软件渲染器下稳定呈现品牌渐变效果。
        VerticalLayout {
            height: 36px;
            alignment: center;
            HorizontalLayout {
                spacing: 0px;
                Text { text: "M"; color: #F05A9D; font-size: 20px; font-weight: 700; }
                Text { text: "i"; color: #D45BD4; font-size: 20px; font-weight: 700; }
                Text { text: "c"; color: #A45CE5; font-size: 20px; font-weight: 700; }
                Text { text: "c"; color: #735FE8; font-size: 20px; font-weight: 700; }
                Text { text: "a"; color: #4D76E8; font-size: 20px; font-weight: 700; }
                Text { text: "t"; color: #3296E8; font-size: 20px; font-weight: 700; }
            }
        }
        VerticalLayout {
            height: 36px;
            alignment: center;
            Text {
                text: root.version == "" ? "" : "v\{root.version}";
                color: Theme.text3;
                font-size: 11px;
                vertical-alignment: center;
            }
        }

        Rectangle {
            horizontal-stretch: 1;
            background: transparent;
        }

        // 顶栏主动作从底部状态栏移到品牌操作区。
        PmButton {
            label: root.running ? "\u{E71A}  停止" : "\u{E768}  开始转发";
            filled: true;
            danger: root.running;
            button-width: 124px;
            enabled: !root.cable-busy;
            clicked => { root.start-stop(); }
        }
        PmButton {
            label: "";
            icon-image: @image-url("../../resources/theme-shirt.svg");
            has-icon-image: true;
            icon-only: true;
            flat: true;
            button-width: 38px;
            clicked => { root.toggle-theme-menu(); }
        }
        PmButton {
            label: "\u{E72C}";
            icon-only: true;
            flat: true;
            button-width: 38px;
            clicked => { root.refresh(); }
        }
    }
    // 主题选择菜单悬浮在主题按钮正下方，只显示主题色块。
    theme-menu := PopupWindow {
        x: root.width - 160px;
        y: root.height + 4px;
        width: 150px;
        height: 132px;
        close-policy: close-on-click-outside;
        Rectangle {
            width: 100%;
            height: 100%;
            border-radius: Theme.radiusCard;
            border-width: 1px;
            border-color: Theme.borderStrong;
            background: Theme.card;
            VerticalLayout {
                padding: 12px;
                spacing: 8px;
                HorizontalLayout {
                    spacing: 8px;
                    ThemePreset {
                        index: 0;
                        active: root.theme-index == 0;
                        swatch: #F5F9FE;
                        selected(i) => { root.theme-selected(i); theme-menu.close(); }
                    }
                    ThemePreset {
                        index: 1;
                        active: root.theme-index == 1;
                        swatch: #101216;
                        selected(i) => { root.theme-selected(i); theme-menu.close(); }
                    }
                }
                HorizontalLayout {
                    spacing: 8px;
                    ThemePreset {
                        index: 2;
                        active: root.theme-index == 2;
                        swatch: #FFDCEB;
                        selected(i) => { root.theme-selected(i); theme-menu.close(); }
                    }
                    Rectangle { width: 54px; height: 54px; background: transparent; }
                }
            }
        }
    }
    }