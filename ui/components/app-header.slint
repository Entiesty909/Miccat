//! 应用页签栏：提供路由、音频库和设置页切换。

import { Theme } from "../theme.slint";
import { TabBar } from "tab-bar.slint";

export component AppHeader inherits Rectangle {
    in-out property <int> current: 0;
    callback picked(int);

    height: 42px;
    background: Theme.card;
    border-width: 1px;
    border-color: Theme.border;

    TabBar {
        current: root.current;
        picked(i) => { root.picked(i); }
    }
}