//! 装配路由、音频库与设置页并转发它们的用户操作。

import { RoutePage } from "../pages/route.slint";
import { PlayerPage } from "../pages/player.slint";
import { SettingsPage } from "../pages/settings.slint";
import { Theme } from "../theme.slint";

// 页面宿主只做属性桥接和事件转发；业务状态由 MainWindow/Rust bridge 持有。
export component PageHost inherits Rectangle {
    // 页面索引：0 路由、1 音频库、2 设置；切换时条件组件重建。
    in property <int> page: 0;
    // 当前主窗口的页面浅粉遮罩是否已经烘入与尺寸匹配的背景图。
    in property <bool> pink-background-precomposed: false;
    // 进程名称数组，由 bridge 刷新。
    in-out property <[string]> processes: [];
    // 进程 PID 数组，用于添加源去重。
    in-out property <[string]> process-pids: [];
    // 进程图标图像数组。
    in-out property <[image]> process-icon-images: [];
    // 音频库文件名数组。
    in-out property <[string]> audio-catalog-entries: [];
    // 音频库元数据数组。
    in-out property <[string]> audio-catalog-metadata: [];
    // 音频库时长数组。
    in-out property <[string]> audio-catalog-durations: [];
    // 音频库分类数组。
    in-out property <[string]> audio-catalog-categories: [];
    // 音频库路径数组。
    in-out property <[string]> audio-catalog-paths: [];
    // 音频库大小数组。
    in-out property <[string]> audio-catalog-sizes: [];
    // 音频库快捷键数组。
    in-out property <[string]> audio-catalog-hotkeys: [];
    // 音频库循环设置数组。
    in-out property <[bool]> audio-catalog-loops: [];
    // 输出设备名称列表。
    in-out property <[string]> output-options: [];
    // 文件输出设备下标。
    in-out property <int> file-output-index: 0;
    // 文件音量百分比。
    in-out property <float> audio-file-volume: 100;
    // 麦克风输入音量百分比。
    in-out property <float> microphone-input-volume: 100;
    // 当前进程下标。
    in-out property <int> process-index: 0;
    // 源类型数组。
    in-out property <[int]> source-kinds: [];
    // 源字体图标数组。
    in-out property <[string]> source-icons: [];
    // 源图像数组。
    in-out property <[image]> source-icon-images: [];
    // 源标题数组。
    in-out property <[string]> source-titles: [];
    // 每槽位音量 dB 文本。
    in-out property <[string]> source-volume-dbs: [];
    // 每槽位副标题。
    in-out property <[string]> source-subtitles: [];
    // 每槽位详情。
    in-out property <[string]> source-details: [];
    // 每槽位播放状态。
    in-out property <[string]> source-statuses: [];
    // 每槽位启用状态。
    in-out property <[bool]> source-active: [];
    // 每槽位峰值 dB 文本。
    in-out property <[string]> source-peak-dbs: [];
    // 每槽位峰值数值。
    in-out property <[float]> source-peak-values: [];
    // 每槽位音量百分比。
    in-out property <[float]> source-volumes: [];
    // 路由文件和麦克风卡片的本机试听百分比，与转发音量数组按行对齐。
    in-out property <[float]> source-preview-volumes: [];
    // 每槽位静音状态。
    in-out property <[bool]> source-muted: [];
    // 每槽位暂停状态。
    in-out property <[bool]> source-paused: [];
    // 按卡片行与设备下标两级索引的勾选状态。
    in-out property <[[bool]]> source-output-selections: [];
    // 每张源卡片所选设备的友好名。
    in-out property <[string]> source-output-labels: [];
    // 每槽位文件播放模式。
    in-out property <[int]> source-play-modes: [];
    // 每槽位文件播放进度。
    in-out property <[float]> source-progresses: [];
    // 每槽位文件当前时间文本。
    in-out property <[string]> source-position-texts: [];
    // 每槽位文件总时长文本。
    in-out property <[string]> source-duration-texts: [];
    // 输出设备列表。
    in-out property <[string]> outputs: [];
    // 默认输出设备下标。
    in-out property <int> output-index: 0;
    // 麦克风设备列表。
    in-out property <[string]> mics: [];
    // 麦克风下标。
    in-out property <int> mic-index: 0;
    // 麦克风混音开关。
    in-out property <bool> mix-mic: false;
    // 替换目标槽位，-1 表示新增。
    in-out property <int> source-replace-index: -1;
    // 添加源窗口当前页签。
    in-out property <int> source-add-tab: 0;
    // 转发运行态。
    in-out property <bool> running: false;
    // 分类名称数组。
    in-out property <[string]> categories: [];
    // 分类树深度数组。
    in-out property <[int]> category-depths: [];
    // 分类条目数量数组。
    in-out property <[int]> category-counts: [];
    // 分类图标图像数组。
    in-out property <[image]> category-icon-images: [];
    // 分类图标字形数组。
    in-out property <[string]> category-icon-glyphs: [];
    // 编辑器自定义图标图像。
    in-out property <image> edit-custom-icon-image;
    // 编辑窗口开关。
    in-out property <bool> edit-dialog-open: false;
    // 编辑模式：true 分类，false 音频。
    in-out property <bool> edit-category-mode: false;
    // 编辑对象名称草稿。
    in-out property <string> edit-name: "";
    // 编辑图标索引。
    in-out property <int> edit-icon-index: 0;
    // 编辑自定义图标路径。
    in-out property <string> edit-custom-icon-path: "";
    // 当前分类下标。
    in-out property <int> category-index: 0;
    // 当前页条目名称数组。
    in-out property <[string]> entries: [];
    // 条目时长数组。
    in-out property <[string]> entry-durations: [];
    // 条目图标图像数组。
    in-out property <[image]> entry-icon-images: [];
    // 条目图标字形数组。
    in-out property <[string]> entry-icon-glyphs: [];
    // 条目元数据数组。
    in-out property <[string]> entry-metadata: [];
    // 条目路径数组。
    in-out property <[string]> entry-paths: [];
    // 条目大小数组。
    in-out property <[string]> entry-sizes: [];
    // 条目快捷键数组。
    in-out property <[string]> entry-hotkeys: [];
    // 条目搜索草稿。
    in-out property <string> search: "";
    // 当前选中条目下标。
    in-out property <int> entry-index: -1;
    // 条目快捷键捕获态。
    in-out property <bool> listening-entry-hotkey: false;
    // 分页页码。
    in-out property <int> page-index: 0;
    // 分页总页数。
    in-out property <int> page-count: 1;
    // 筛选后总条目数。
    in-out property <int> total-count: 0;
    // 排序列与方向均由 bridge 的同一个筛选结果提供。
    in-out property <int> sort-column-index: 0;
    in-out property <bool> sort-ascending: true;
    // 当前播放条目下标。
    in-out property <int> playing-entry-index: -1;
    // 播放进度比例。
    in-out property <float> progress: 0;
    // 拖动进度保护标记。
    in-out property <bool> seeking-progress: false;
    // 当前播放位置文本。
    in-out property <string> current-position: "";
    // 当前音频时长，单位秒。
    in-out property <float> duration-seconds: 0;
    // 播放态。
    in-out property <bool> playing: false;
    // 暂停态。
    in-out property <bool> paused: false;
    // 音频库工具栏的本机试听音量百分比。
    in-out property <float> preview-volume: 50;
    // 分类菜单可见态。
    in-out property <bool> category-menu-open: false;
    // 条目菜单可见态。
    in-out property <bool> entry-menu-open: false;
    // 分类菜单 X 坐标。
    in-out property <length> category-menu-x: 0px;
    // 分类菜单 Y 坐标。
    in-out property <length> category-menu-y: 0px;
    // 条目菜单 X 坐标。
    in-out property <length> entry-menu-x: 0px;
    // 条目菜单 Y 坐标。
    in-out property <length> entry-menu-y: 0px;
    // 全局快捷键标签，只读展示。
    in property <string> hotkey-label: "";
    // 设置分组索引。
    in-out property <int> settings-section-index: 0;
    // 输出设备选择数组。
    in-out property <[bool]> device-selected: [];
    // 是否显示全部设备。
    in-out property <bool> all-devices: false;
    // 是否展示默认麦克风选项。
    in-out property <bool> show-set-default-mic: false;
    // 默认麦克风开关。
    in-out property <bool> set-default-mic: false;
    // 默认播放设备开关。
    in-out property <bool> set-default-render: false;
    // 默认通信设备开关。
    in-out property <bool> set-default-communications: false;
    // 默认目标设备提示。
    in-out property <string> dest-hint: "";
    // 线缆安装态。
    in-out property <bool> cable-installed: false;
    // 线缆任务忙碌态。
    in-out property <bool> cable-busy: false;
    // 线缆状态文本。
    in-out property <string> cable-text: "";
    // 全局快捷键捕获态。
    in-out property <bool> listening-hotkey: false;
    // 关于文本。
    in-out property <string> about-text: "";

    // 设置页设备刷新请求；路由页不再显示独立刷新进程按钮。
    callback refresh();
    // 添加进程请求。
    callback process-add();
    // 导入音频文件请求。
    callback add-files();
    // 麦克风混音变更。
    callback mic-mix-changed(bool);
    // 源启停变更。
    callback source-active-toggled(int, bool);
    // 源音量变更。
    callback source-volume-edited(int, float);
    // 文件/麦克风本机试听音量变化；进程源不响应。
    callback source-preview-volume-edited(int, float);
    // 源静音切换。
    callback source-mute-toggled(int);
    // 按卡片行号、目标设备下标和勾选状态上报。
    callback source-output-toggled(int, int, bool);
    // 源菜单动作码。
    callback source-action(int, int);
    // 源暂停。
    callback source-pause(int);
    // 源停止。
    callback source-stop(int);
    // 文件源上一首。
    callback source-previous(int);
    // 文件源下一首。
    callback source-next-track(int);
    // 文件源播放模式循环切换。
    callback source-play-mode-cycled(int);
    // 指定文件槽释放进度滑块后提交目标位置。
    callback source-progress-seek(int, float);
    // 打开音频库。
    callback open-library();
    // 打开设置并指定分组。
    callback settings-requested(int);
    // 提交编辑表单。
    callback edit-accepted(string, int, string);
    // 取消编辑。
    callback edit-cancelled();
    // 将音频条目加入路由。
    callback audio-entry-add-route-index(int);
    // 编辑文件音量。
    callback audio-file-volume-edited(float);
    // 编辑文件输出设备。
    callback audio-file-output-changed(int);
    // 编辑麦克风输入音量。
    callback microphone-input-volume-edited(float);
    // 请求自定义图标。
    callback edit-custom-icon-requested();
    // 分类选择。
    callback category-changed(int);
    // 分类上下文菜单。
    callback category-context(int);
    // 分类拖拽序列化。
    pure callback category-to-transfer(int) -> data-transfer;
    // 分类拖拽校验。
    callback category-can-drop(data-transfer, int, int) -> bool;
    // 分类拖拽提交。
    callback category-drop(data-transfer, int, int);
    // 音频条目拖到分类栏时在 bridge 中检查、保存分类变化。
    pure callback entry-to-transfer(int) -> data-transfer;
    callback entry-category-can-drop(data-transfer, int) -> bool;
    callback entry-category-drop(data-transfer, int);
    // 条目上下文菜单。
    callback entry-context(int);
    // 条目选择。
    callback entry-selected(int);
    // 条目双击。
    callback entry-double-clicked(int);
    // 条目播放。
    callback entry-play(int);
    // 清除条目快捷键。
    callback entry-hotkey-clear();
    // 拖动播放进度。
    callback progress-seek(float);
    // 停止播放。
    callback audio-stop();
    // 播放动作码。
    callback play-action(int);
    // 播放暂停切换。
    callback pause-toggle();
    // 播放上一条。
    callback previous();
    // 播放下一条。
    callback next();
    // 预览音量编辑。
    callback preview-volume-edited(float);
    // 文件输出变更。
    callback file-output-changed(int);
    // 搜索编辑。
    callback search-edited(string);
    // 格式变更。
    callback format-changed(int);
    // 名称或时长表头触发对应列的排序切换。
    callback sort-column(int);
    // 分页变更。
    callback page-changed(int);
    // 条目快捷键绑定。
    callback entry-hotkey-bind();
    // 安装线缆。
    callback install-cable();
    // 卸载线缆。
    callback uninstall-cable();
    // 开始全局快捷键捕获。
    callback begin-hotkey-capture();
    // 重置全局快捷键。
    callback reset-hotkey();
    // 开始指定行快捷键捕获。
    callback begin-hotkey-row(int);
    // 重置指定行快捷键。
    callback reset-hotkey-row(int);
    // 回传行快捷键捕获结果。
    callback hotkey-row-captured(int, string, bool, bool, bool);
    // 显示全部设备切换。
    callback all-devices-toggled(bool);
    // 单设备选择切换。
    callback device-toggled(int, bool);
    // 默认麦克风切换。
    callback set-default-mic-toggled(bool);
    // 默认播放设备切换。
    callback set-default-render-toggled(bool);
    // 默认通信设备切换。
    callback set-default-communications-toggled(bool);

    // 淡粉主题给非卡片区域铺浅色遮罩，背景图仍属于主窗口。
    background: root.pink-background-precomposed ? transparent : Theme.page-overlay;
    // 条件组件按 page 重建，保证隐藏页面不继续接收交互。
    // 路由页仅负责把桥接数组投影到页面，并将用户事件原样上送。
    if root.page == 0: RoutePage {
        width: 100%;
        height: 100%;
        audio-entries <=> root.audio-catalog-entries;
        audio-catalog-metadata <=> root.audio-catalog-metadata;
        audio-catalog-durations <=> root.audio-catalog-durations;
        audio-catalog-sizes <=> root.audio-catalog-sizes;
        audio-catalog-categories <=> root.audio-catalog-categories;
        audio-catalog-hotkeys <=> root.audio-catalog-hotkeys;
        audio-catalog-loops <=> root.audio-catalog-loops;
        file-output-index <=> root.file-output-index;
        audio-file-volume <=> root.audio-file-volume;
        microphone-input-volume <=> root.microphone-input-volume;
        processes <=> root.processes;
        process-pids <=> root.process-pids;
        process-icon-images <=> root.process-icon-images;
        process-index <=> root.process-index;
        source-kinds <=> root.source-kinds;
        source-icons <=> root.source-icons;
        source-icon-images <=> root.source-icon-images;
        source-titles <=> root.source-titles;
        source-subtitles <=> root.source-subtitles;
        source-details <=> root.source-details;
        source-statuses <=> root.source-statuses;
        source-active <=> root.source-active;
        source-peak-values <=> root.source-peak-values;
        source-volumes <=> root.source-volumes;
        source-preview-volumes <=> root.source-preview-volumes;
        source-peak-dbs <=> root.source-peak-dbs;
        source-volume-dbs <=> root.source-volume-dbs;
        source-muted <=> root.source-muted;
        source-paused <=> root.source-paused;
        source-output-selections <=> root.source-output-selections;
        source-output-labels <=> root.source-output-labels;
        source-play-modes <=> root.source-play-modes;
        source-progresses <=> root.source-progresses;
        source-position-texts <=> root.source-position-texts;
        source-duration-texts <=> root.source-duration-texts;
        outputs <=> root.outputs;
        output-index <=> root.output-index;
        mics <=> root.mics;
        mic-index <=> root.mic-index;
        mix-mic <=> root.mix-mic;
        source-replace-index <=> root.source-replace-index;
        source-add-tab <=> root.source-add-tab;
        running <=> root.running;
        audio-entry-add-route(actual) => {
            root.audio-entry-add-route-index(actual);
        }
        audio-file-volume-edited(value) => {
            root.audio-file-volume-edited(value);
        }
        audio-file-output-changed(index) => {
            root.audio-file-output-changed(index);
        }
        process-add => { root.process-add(); }
        add-files => { root.add-files(); }
        mic-mix-changed(value) => { root.mic-mix-changed(value); }
        microphone-input-volume-edited(value) => {
            root.microphone-input-volume-edited(value);
        }
        // 源槽位事件携带 index，确保音量、启停和设备变更只影响目标卡片。
        source-active-toggled(index, value) => {
            root.source-active-toggled(index, value);
        }
        source-volume-edited(index, value) => {
            root.source-volume-edited(index, value);
        }
        source-preview-volume-edited(index, value) => {
            root.source-preview-volume-edited(index, value);
        }
        source-mute-toggled(index) => { root.source-mute-toggled(index); }
        source-output-toggled(index, target, checked) => {
            root.source-output-toggled(index, target, checked);
        }
        source-action(index, code) => { root.source-action(index, code); }
        source-pause(index) => { root.source-pause(index); }
        source-stop(index) => { root.source-stop(index); }
        source-previous(index) => { root.source-previous(index); }
        source-next-track(index) => { root.source-next-track(index); }
        source-play-mode-cycled(index) => {
            root.source-play-mode-cycled(index);
        }
        source-progress-seek(index, value) => {
            root.source-progress-seek(index, value);
        }
        // 导航事件切换宿主页面或打开设置，不在组件内改变路由数据。
        open-library => { root.open-library(); }
        open-settings => { root.settings-requested(1); }
    }
    // 音频库页只挂载 page == 1，播放和菜单状态仍由 root 双向持有。
    if root.page == 1: PlayerPage {
        width: 100%;
        height: 100%;
        categories <=> root.categories;
        category-depths <=> root.category-depths;
        category-counts <=> root.category-counts;
        category-icon-images <=> root.category-icon-images;
        category-icon-glyphs <=> root.category-icon-glyphs;
        edit-dialog-open <=> root.edit-dialog-open;
        edit-category-mode <=> root.edit-category-mode;
        edit-name <=> root.edit-name;
        edit-custom-icon-image <=> root.edit-custom-icon-image;
        edit-icon-index <=> root.edit-icon-index;
        edit-custom-icon-path <=> root.edit-custom-icon-path;
        category-index <=> root.category-index;
        entries <=> root.entries;
        entry-durations <=> root.entry-durations;
        entry-icon-images <=> root.entry-icon-images;
        entry-icon-glyphs <=> root.entry-icon-glyphs;
        entry-paths <=> root.entry-paths;
        entry-sizes <=> root.entry-sizes;
        entry-hotkeys <=> root.entry-hotkeys;
        search <=> root.search;
        entry-index <=> root.entry-index;
        listening-entry-hotkey <=> root.listening-entry-hotkey;
        page <=> root.page-index;
        page-count <=> root.page-count;
        total-count <=> root.total-count;
        sort-ascending <=> root.sort-ascending;
        sort-column-index <=> root.sort-column-index;
        playing-entry-index <=> root.playing-entry-index;
        progress <=> root.progress;
        seeking-progress <=> root.seeking-progress;
        current-position <=> root.current-position;
        duration-seconds <=> root.duration-seconds;
        playing <=> root.playing;
        paused <=> root.paused;
        preview-volume <=> root.preview-volume;
        category-menu-open <=> root.category-menu-open;
        entry-menu-open <=> root.entry-menu-open;
        category-menu-x <=> root.category-menu-x;
        category-menu-y <=> root.category-menu-y;
        entry-menu-x <=> root.entry-menu-x;
        entry-menu-y <=> root.entry-menu-y;
        // 音频库编辑与分类操作保持参数原样，业务校验由桥接层完成。
        edit-accepted(name, icon, path) => {
            root.edit-accepted(name, icon, path);
        }
        edit-cancelled => { root.edit-cancelled(); }
        edit-custom-icon-requested => { root.edit-custom-icon-requested(); }
        category-changed(index) => { root.category-changed(index); }
        category-context(index) => { root.category-context(index); }
        category-to-transfer(index) => { root.category-to-transfer(index); }
        category-can-drop(data, target, position) => {
            root.category-can-drop(data, target, position);
        }
        category-drop(data, target, position) => {
            root.category-drop(data, target, position);
        }
        entry-to-transfer(index) => { root.entry-to-transfer(index); }
        entry-category-can-drop(data, target) => {
            root.entry-category-can-drop(data, target);
        }
        entry-category-drop(data, target) => {
            root.entry-category-drop(data, target);
        }
        entry-context(index) => { root.entry-context(index); }
        entry-selected(index) => { root.entry-selected(index); }
        entry-double-clicked(index) => { root.entry-double-clicked(index); }
        entry-play(index) => { root.entry-play(index); }
        entry-hotkey-clear => { root.entry-hotkey-clear(); }
        // 播放器控制事件统一转发给宿主，播放器组件只维护交互态。
        progress-seek(value) => { root.progress-seek(value); }
        add-files => { root.add-files(); }
        stop => { root.audio-stop(); }
        pause-toggle => { root.pause-toggle(); }
        previous => { root.previous(); }
        next => { root.next(); }
        preview-volume-edited(value) => { root.preview-volume-edited(value); }
        search-edited(value) => { root.search-edited(value); }
        sort-column(index) => { root.sort-column(index); }
        page-changed(value) => { root.page-changed(value); }
        entry-hotkey-bind => { root.entry-hotkey-bind(); }
    }
    // 设置页只挂载 page == 2，设备和线缆回调统一转发到宿主。
    if root.page == 2: SettingsPage {
        width: 100%;
        height: 100%;
        section-index <=> root.settings-section-index;
        devices <=> root.outputs;
        device-index <=> root.output-index;
        device-selected <=> root.device-selected;
        all-devices <=> root.all-devices;
        show-set-default-mic <=> root.show-set-default-mic;
        set-default-mic <=> root.set-default-mic;
        set-default-render <=> root.set-default-render;
        set-default-communications <=> root.set-default-communications;
        dest-hint <=> root.dest-hint;
        running <=> root.running;
        cable-installed <=> root.cable-installed;
        cable-busy <=> root.cable-busy;
        cable-text <=> root.cable-text;
        hotkey-label: root.hotkey-label;
        listening-hotkey <=> root.listening-hotkey;
        about-text <=> root.about-text;
        // 设置页设备与线缆事件只做转发，运行态约束由桥接层执行。
        refresh => { root.refresh(); }
        install-cable => { root.install-cable(); }
        uninstall-cable => { root.uninstall-cable(); }
        begin-hotkey-capture => { root.begin-hotkey-capture(); }
        reset-hotkey => { root.reset-hotkey(); }
        begin-hotkey-row(row) => { root.begin-hotkey-row(row); }
        reset-hotkey-row(row) => { root.reset-hotkey-row(row); }
        hotkey-row-captured(row, text, ctrl, shift, alt) => {
            root.hotkey-row-captured(row, text, ctrl, shift, alt);
        }
        all-devices-toggled(value) => { root.all-devices-toggled(value); }
        device-toggled(index, value) => { root.device-toggled(index, value); }
        set-default-mic-toggled(value) => { root.set-default-mic-toggled(value); }
        set-default-render-toggled(value) => { root.set-default-render-toggled(value); }
        set-default-communications-toggled(value) => {
            root.set-default-communications-toggled(value);
        }
    }
}
