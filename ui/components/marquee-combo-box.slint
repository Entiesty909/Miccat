//! 使用虚拟化列表呈现选项，并只在打开时创建弹出列表。

import { ListView } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { MarqueeText } from "marquee-text.slint";
// 可访问的滚动组合框：键盘、鼠标和弹出列表共享同一选中索引。

export component MarqueeComboBox inherits FocusScope {
    // 下拉选项模型；列表顺序即索引协议，空模型不打开弹层。
    in property <[string]> model: [];
    // 当前选中项索引，超出模型范围时由显示值回退为空。
    in-out property <int> current-index: 0;
    // 是否在长文本上启用悬停滚动显示。
    in property <bool> marquee-enabled: true;
    // 用户选中条目后通知宿主，参数是选项显示文本。
    callback selected(string);

    // 根据 current-index 派生的当前显示文本，供无障碍和视口共用。
    out property <string> current-value:
        root.current-index >= 0
        && root.current-index < root.model.length
        ? root.model[root.current-index]
        : "";

    // 弹出窗口是否可见，直接反映 PopupWindow 的生命周期。
    out property <bool> popup-open: popup.is-open;
    // 键盘/悬停导航的临时高亮索引，不等同于已提交选择。
    property <int> highlighted-index: 0;
    // 弹层内容的垂直偏移，保持高亮项在可见窗口内。
    in-out property <length> popup-scroll-y: 0px;
    // 每个选项行的固定高度，用于滚动位置计算。
    property <length> row-height: 32px;
    // 弹层最多展示六行，避免选项过多遮挡主界面。
    property <int> visible-item-count: min(6, root.model.length);
    // 弹层总高度由可见行数和上下留白共同决定。
    property <length> popup-height: root.visible-item-count * root.row-height + 8px;

    width: 100%;
    height: Theme.controlHeight;
    min-width: 0px;
    horizontal-stretch: 1;
    accessible-role: combobox;
    accessible-enabled: root.enabled;
    accessible-expandable: true;
    accessible-expanded: root.popup-open;
    accessible-value: root.current-value;
    // 无障碍展开动作与鼠标触发共享同一弹层切换路径。
    accessible-action-expand => { root.toggle-popup(); }
    // 将任意候选索引限制到当前模型的合法范围。
    // 空模型没有合法项，返回零只作为稳定的显示回退。
    function clamp-index(index: int) -> int {
        if root.model.length == 0 {
            return 0;
        }
        return min(max(index, 0), root.model.length - 1);
    }
    // 打开弹层前让高亮项与当前选择对齐，并重置滚动位置。
    // 通过负偏移把当前高亮项放到弹层可视窗口内。
    function reset-scroll() {
        root.popup-scroll-y = -max(
            0,
            root.highlighted-index - root.visible-item-count + 1
        ) * root.row-height;
    }
    // 只有启用且存在选项时才创建可交互的弹出列表。
    // 打开前同步高亮，避免外部更新索引后键盘焦点仍停留旧项。
    function open-popup() {
        if root.enabled && root.model.length > 0 {
            root.highlighted-index = root.clamp-index(root.current-index);
            root.reset-scroll();
            popup.show();
        }
    }
    // 在打开与关闭之间切换，保持触发入口与 PopupWindow 状态一致。
    // 关闭路径不修改 current-index，取消操作不会产生 selected 回调。
    function toggle-popup() {
        if root.popup-open {
            popup.close();
        } else {
            root.open-popup();
        }
    }
    // 高亮移动后修正滚动偏移，避免键盘选择跑出可视区域。
    // 比较条目顶部与可视边界，只调整必要的最小滚动距离。
    function scroll-highlight-into-view() {
        let item-top = root.highlighted-index * root.row-height;
        let visible-top = -root.popup-scroll-y;
        if item-top < visible-top {
            root.popup-scroll-y = -item-top;
        } else if item-top + root.row-height > visible-top + root.popup-height {
            root.popup-scroll-y = -(
                item-top + root.row-height - root.popup-height
            );
        }
    }
    // 按步长移动高亮项，并在边界处由 clamp-index 截断。

    function move-highlight(delta: int) {
        root.highlighted-index = root.clamp-index(
            root.highlighted-index + delta
        );
        root.scroll-highlight-into-view();
    }
    // 提交合法索引并关闭弹层；非法索引只关闭而不发出选择事件。
    // 只有合法索引才写回选择并通知宿主，防止模型刷新期间越界。
    function choose(index: int) {
        if index >= 0 && index < root.model.length {
            root.current-index = index;
            root.selected(root.model[index]);
        }
        popup.close();
    }
    // 外部改变选择时同步键盘高亮，不触发重复 selected 回调。
    changed current-index => {
        root.highlighted-index = root.clamp-index(root.current-index);
    }
    // 模型为空时关闭旧弹层，避免 PopupWindow 保留失效的条目。
    changed model => {
        if root.model.length == 0 {
            popup.close();
        } else {
            root.highlighted-index = root.clamp-index(root.current-index);
            root.reset-scroll();
        }
    }
    // 禁用控件时立即关闭弹层，避免保留不可操作的浮层。
    changed enabled => {
        if !root.enabled {
            popup.close();
        }
    }
    // 主控件未打开弹层时消费方向键/回车，直接进入选择流程。
    // 非弹层状态下的方向键和确认键作为打开快捷键消费。
    key-pressed(event) => {
        if root.enabled
            && !root.popup-open
            && (event.text == Key.DownArrow
                || event.text == Key.UpArrow
                || event.text == Key.Return
                || event.text == Key.Space) {
            root.open-popup();
            accept
        } else {
            reject
        }
    }

    Rectangle {
        width: 100%;
        height: 100%;
        border-radius: 3px;
        border-width: 1px;
        border-color: Theme.borderStrong;
        background: trigger.pressed
            ? Theme.accentPressed
            : (trigger.has-hover ? Theme.playingSoft : Theme.field);
        opacity: root.enabled ? 1 : 0.45;

        value-viewport := Rectangle {
            x: 10px;
            y: 1px;
            width: 82%;
            height: parent.height - 2px;
            clip: true;
            background: transparent;

            if root.marquee-enabled: selected-value := Text {
                x: -(root.marquee-enabled
                    && trigger.has-hover
                    && selected-value.preferred-width > parent.width
                    ? min(
                        selected-value.preferred-width - parent.width,
                        260px
                    )
                    : 0px);
                y: 0px;
                width: selected-value.preferred-width;
                height: parent.height;
                text: root.current-value;
                color: Theme.text;
                font-size: 12px;
                vertical-alignment: center;
                overflow: clip;
                wrap: no-wrap;
                animate x {
                    duration: 5000ms;
                    delay: 700ms;
                    easing: ease-in-out;
                    iteration-count: -1;
                    direction: alternate;
                    enabled: root.marquee-enabled
                        && trigger.has-hover
                        && selected-value.preferred-width > parent.width;
                }
            }
            if !root.marquee-enabled: Text {
                width: 100%;
                height: 100%;
                text: root.current-value;
                color: Theme.text;
                font-size: 12px;
                vertical-alignment: center;
                overflow: elide;
            }
        }

        Text {
            x: parent.width - 27px;
            width: 18px;
            height: 100%;
            text: "\u{E70D}";
            font-family: "Segoe MDL2 Assets";
            font-size: 12px;
            color: Theme.text2;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
    // 主视口只显示当前值，触发区负责打开或关闭弹层。

    // 触发区覆盖整个当前值视口，点击只负责切换弹出列表。
    trigger := TouchArea {
        width: 100%;
        height: 100%;
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.toggle-popup(); }
    }

    // 弹层使用独立窗口承载列表，点击外部时由 close-policy 收起。
    popup := PopupWindow {
        x: 0px;
        y: -4px;
        width: root.width;
        height: root.popup-height;
        close-policy: close-on-click-outside;

        if root.popup-open: popup_focus := FocusScope {
            width: 100%;
            height: 100%;
            // 弹层获得焦点后承接键盘导航，避免按键落到主页面。
            init => { self.focus(); }

            // 键盘导航只改变临时高亮，确认键才提交选择。
            key-pressed(event) => {
                if event.text == Key.DownArrow {
                    root.move-highlight(1);
                    accept
                } else if event.text == Key.UpArrow {
                    root.move-highlight(-1);
                    accept
                } else if event.text == Key.Home {
                    root.highlighted-index = 0;
                    root.scroll-highlight-into-view();
                    accept
                } else if event.text == Key.End {
                    root.highlighted-index = root.model.length - 1;
                    root.scroll-highlight-into-view();
                    accept
                } else if event.text == Key.Return
                    || event.text == Key.Space {
                    root.choose(root.highlighted-index);
                    accept
                } else if event.text == Key.Escape {
                    popup.close();
                    accept
                } else {
                    reject
                }
            }

            Rectangle {
                width: 100%;
                height: 100%;
                background: #F8F8F8;
                border-width: 1px;
                border-color: #D0D0D0;
                border-radius: 7px;
                drop-shadow-blur: 16px;
                drop-shadow-offset-y: 8px;
                drop-shadow-color: #40000000;
                // 虚拟化列表承载大量选项，并把滚动位置绑定到组件状态。

                ListView {
                    x: 4px;
                    y: 4px;
                    width: parent.width - 8px;
                    height: parent.height - 8px;
                    content-y <=> root.popup-scroll-y;
                    vertical-scrollbar-policy: as-needed;
                    // 每个条目保持原模型索引，供高亮和选择回调使用。

                    for item[index] in root.model: Rectangle {
                        x: 3px;
                        width: parent.width - 6px;
                        height: root.row-height;

                        item-background := Rectangle {
                            y: 2px;
                            width: parent.width;
                            height: parent.height - 4px;
                            border-radius: 4px;
                            background: item-area.has-hover
                                ? #F2F2F2
                                : (root.current-index == index
                                    || root.highlighted-index == index
                                    ? #E8E8E8
                                    : transparent);

                            selector := Rectangle {
                                x: 0px;
                                y: (parent.height - self.height) / 2;
                                width: 3px;
                                height: root.current-index == index ? 16px : 0px;
                                background: Theme.accent;
                                border-radius: 2px;
                            }

                            if root.marquee-enabled: MarqueeText {
                                x: 16px;
                                y: 0px;
                                width: max(0px, parent.width - 20px);
                                height: parent.height;
                                text: item;
                                text-color: Theme.text;
                                font-size: 12px;
                                hovered: item-area.has-hover;
                            }
                            if !root.marquee-enabled: Text {
                                x: 16px;
                                y: 0px;
                                width: max(0px, parent.width - 20px);
                                height: parent.height;
                                text: item;
                                color: Theme.text;
                                font-size: 12px;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                        }
                        // 点击条目提交该索引；悬停时同步键盘高亮以保持视觉一致。

                        item-area := TouchArea {
                            width: 100%;
                            height: 100%;
                            mouse-cursor: pointer;
                            clicked => { root.choose(index); }
                            changed has-hover => {
                                if self.has-hover {
                                    root.highlighted-index = index;
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
