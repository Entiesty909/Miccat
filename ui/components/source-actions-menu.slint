//! 路由源更多操作菜单：提供当前源类型可用的操作。

import { Theme } from "../theme.slint";
import { MenuItem } from "menu-item.slint";

export component SourceActionsMenu inherits Rectangle {
    in property <int> kind: 0;
    callback action(int);
    callback closed();

    height: root.kind == 1 ? 188px : 126px;
    background: Theme.card;
    border-width: 1px;
    border-color: Theme.borderStrong;
    border-radius: Theme.radiusControl;

    TouchArea {
        clicked => { root.closed(); }
    }
    VerticalLayout {
        padding: 8px;
        spacing: 2px;
        Text {
            text: "源操作";
            height: 20px;
            color: Theme.text2;
            font-size: 11px;
            vertical-alignment: TextVerticalAlignment.center;
        }
        if root.kind == 0: MenuItem {
            label: "替换进程";
            clicked => { root.action(5); }
        }
        if root.kind == 1: MenuItem {
            label: "替换音频";
            clicked => { root.action(6); }
        }
        if root.kind == 2: MenuItem {
            label: "替换麦克风";
            clicked => { root.action(7); }
        }
        MenuItem {
            label: "单独转发此源";
            clicked => { root.action(2); }
        }
        if root.kind == 1: MenuItem {
            label: "在音频库中定位";
            clicked => { root.action(3); }
        }
        if root.kind == 1: MenuItem {
            label: "设置快捷键";
            clicked => { root.action(1); }
        }
        MenuItem {
            label: "删除此源";
            danger: true;
            clicked => { root.action(4); }
        }
    }
}
