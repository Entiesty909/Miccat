//! 音频库列表：只显示当前页的图标、名称和时长，整行可选择和打开右键菜单。

import { ScrollView } from "std-widgets.slint";
import { Theme } from "../theme.slint";

// 音频库当前页的文件行：并行数组共用可见行索引，业务操作通过右键菜单提交。
export component AudioList inherits Rectangle {
    // 当前页的条目显示名称；index 是本页所有并行数组的索引。
    in-out property <[string]> entries: [];
    // 每个条目的格式化时长文本。
    in-out property <[string]> entry-durations: [];
    // 可选的自定义图标图片，和 glyph 数组按行索引配对。
    in property <[image]> entry-icon-images: [];
    // 空字符串表示优先使用对应图片，否则显示该行字形。
    in property <[string]> entry-icon-glyphs: [];
    // 当前选中行索引，-1 表示未选中。
    in-out property <int> entry-index: -1;
    // 播放引擎当前行索引，仅用于高亮，不等同于选中状态。
    in property <int> playing-entry-index: -1;
    // 分页从零开始，每页 20 条；序号展示跨页连续编号。
    in property <int> page: 0;
    // 当前排序列和方向只用于表头反馈，排序结果由宿主查询。
    in property <int> sort-column-index: 0;
    in property <bool> sort-ascending: true;
    // 条目右键菜单的可见状态，由行右键和菜单覆盖层共同维护。
    in-out property <bool> entry-menu-open: false;
    // 分类菜单开关；打开条目菜单时必须关闭分类菜单。
    in-out property <bool> category-menu-open: false;
    // 菜单锚点坐标，使用屏幕长度单位供宿主定位上下文菜单。
    in-out property <length> entry-menu-x: 0px;
    // 菜单锚点的垂直坐标，与 entry-menu-x 配对使用。
    in-out property <length> entry-menu-y: 0px;
    // 右键当前行时请求宿主准备条目上下文操作。
    callback entry-context(int);
    // 行选择通知，参数为 entries 的行索引。
    callback entry-selected(int);
    // 行点击沿用宿主的双击检测和播放动作。
    callback entry-double-clicked(int);
    // 行索引为当前页可见索引，宿主负责序列化为条目拖放数据。
    pure callback entry-to-transfer(int) -> data-transfer;
    // 点击名称/时长表头时上报列索引（0 名称，1 时长）。
    callback sort-column(int);

    width: 100%;
    height: 100%;

    VerticalLayout {
        width: 100%;
        height: 100%;
        Rectangle {
            width: 100%;
            height: 38px;
            background: transparent;
            HorizontalLayout {
                padding-left: 12px;
                padding-right: 8px;
                spacing: 6px;
                Text {
                    text: "序号";
                    width: 32px;
                    color: Theme.text2;
                    font-size: 11px;
                    vertical-alignment: TextVerticalAlignment.center;
                }
                Text {
                    text: "名称" + (root.sort-column-index == 0
                        ? (root.sort-ascending ? " ↑" : " ↓") : "");
                    horizontal-stretch: 1;
                    min-width: 60px;
                    color: Theme.text2;
                    font-size: 11px;
                    vertical-alignment: TextVerticalAlignment.center;
                    TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.sort-column(0); }
                    }
                }
                Text {
                    text: "时长" + (root.sort-column-index == 1
                        ? (root.sort-ascending ? " ↑" : " ↓") : "");
                    width: 48px;
                    color: Theme.text2;
                    font-size: 11px;
                    vertical-alignment: TextVerticalAlignment.center;
                    TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.sort-column(1); }
                    }
                }
            }
        }
        Rectangle { width: 100%; height: 1px; background: Theme.border; }
        ScrollView {
            vertical-stretch: 1;
            width: 100%;
            height: 100%;
            VerticalLayout {
                height: 100%;
                // 没有条目时保留列表区域，并提示当前筛选结果为空。
                if root.entries.length == 0: Text {
                    text: "当前分类没有匹配的音频文件";
                    color: Theme.text3;
                    height: 52px;
                    vertical-alignment: TextVerticalAlignment.center;
                }
                // 拖动数据使用当前页可见索引，Rust 接收时重新映射到真实条目。
                for name[index] in root.entries: DragArea {
                    height: 58px;
                    allow-move: true;
                    data: root.entry-to-transfer(index);
                    Rectangle {
                        width: 100%;
                        height: 100%;
                        background: index == root.entry-index
                            ? Theme.accentSoft
                            : (index == root.playing-entry-index
                                ? Theme.playingSoft
                                : Theme.content-card);
                    // 整行命中区位于内容层之下，左右键都能命中图标、文字和空白区域。
                    // 左键沿用已有选择及双击通知；右键只选择当前行并打开菜单。
                    TouchArea {
                        width: parent.width;
                        height: parent.height;
                        clicked => {
                            root.entry-index = index;
                            root.entry-selected(index);
                            root.entry-double-clicked(index);
                            root.entry-menu-open = false;
                        }
                        // 右键用绝对坐标定位菜单，并与分类菜单互斥。
                        pointer-event(event) => {
                            if event.button == PointerEventButton.right
                                && event.kind == PointerEventKind.down {
                                root.entry-index = index;
                                root.entry-selected(index);
                                root.entry-menu-x =
                                    self.absolute-position.x + self.mouse-x;
                                root.entry-menu-y =
                                    self.absolute-position.y + self.mouse-y;
                                root.entry-context(index);
                                root.entry-menu-open = true;
                                root.category-menu-open = false;
                            }
                        }
                    }
                    Rectangle {
                        y: parent.height - 1px;
                        width: parent.width;
                        height: 1px;
                        background: Theme.border;
                    }
                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 8px;
                        spacing: 6px;
                        Text {
                            text: "\{root.page * 20 + index + 1}";
                            width: 32px;
                            color: Theme.text2;
                            font-size: 11px;
                            vertical-alignment: TextVerticalAlignment.center;
                        }
                        // 固定尺寸图标在整行高度内居中，内部图片或字形也在底板居中。
                        VerticalLayout {
                            width: 30px;
                            height: 100%;
                            alignment: LayoutAlignment.center;
                            Rectangle {
                                width: 30px;
                                height: 30px;
                                border-radius: 5px;
                                background: Theme.accentSoft;
                                // 没有自定义图片时回退到音频字形。
                                if index < root.entry-icon-images.length
                                    && index < root.entry-icon-glyphs.length
                                    && root.entry-icon-glyphs[index] == "": Image {
                                    x: 2px;
                                    y: 2px;
                                    width: 26px;
                                    height: 26px;
                                    source: root.entry-icon-images[index];
                                    image-fit: contain;
                                }
                                if index >= root.entry-icon-glyphs.length
                                    || root.entry-icon-glyphs[index] != "": Text {
                                    width: 100%;
                                    height: 100%;
                                    text: index < root.entry-icon-glyphs.length
                                        ? root.entry-icon-glyphs[index]
                                        : "\u{EC4F}";
                                    font-family: "Segoe MDL2 Assets";
                                    color: Theme.accent;
                                    font-size: 16px;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                        }
                        Text {
                            text: name;
                            horizontal-stretch: 1;
                            min-width: 50px;
                            color: Theme.text;
                            font-size: 12px;
                            overflow: elide;
                            vertical-alignment: TextVerticalAlignment.center;
                        }
                        Text {
                            text: index < root.entry-durations.length
                                ? root.entry-durations[index]
                                : "—";
                            width: 48px;
                            color: Theme.text2;
                            font-size: 9px;
                            vertical-alignment: TextVerticalAlignment.center;
                        }
                    }
                    }
                }
            }
        }
    }
}
