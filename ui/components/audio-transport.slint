//! 音频库顶部常驻播放条：空闲时禁用控制，播放时支持导航和拖动进度。

import { Slider } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { PmButton } from "button.slint";

// 音频库顶部传输控制栏；隐藏/显示不再由播放态决定，进度仍为 0..1。
export component AudioTransport inherits Rectangle {
    // 当前播放条目索引；负值表示没有可导航的条目。
    in property <int> entry-index: -1;
    // 当前列表条目总数，用于计算上一首/下一首可用性。
    in property <int> entry-count: 0;
    // 播放流是否活动。
    in property <bool> playing: false;
    // 播放流是否暂停；暂停时仍保留当前条目与进度。
    in property <bool> paused: false;
    // 当前播放位置的归一化进度，0 表示开头、1 表示结尾。
    in-out property <float> progress: 0;
    // 用户正在拖动进度条时抑制外部位置更新造成的跳动。
    in-out property <bool> seeking-progress: false;
    // 已格式化的当前位置文本。
    in property <string> current-position: "";
    // 当前媒体时长，单位为秒；非正值时禁止拖动。
    in property <float> duration-seconds: 0;
    // 本机试听音量，单位百分比。
    in-out property <float> preview-volume: 50;
    // 请求播放上一条可用条目。
    callback previous();
    // 请求在播放与暂停之间切换。
    callback pause-toggle();
    // 请求停止当前播放并清理播放状态。
    callback stop();
    // 请求播放下一条可用条目。
    callback next();
    // 用户释放滑块后提交归一化进度，宿主负责换算为秒并 seek。
    callback progress-seek(float);
    // 请求添加音频文件。
    callback add-files();
    // 修改本机试听音量，参数为百分比。
    callback preview-volume-edited(float);

    height: 44px;
    width: 100%;
    background: Theme.content-card;
    border-radius: 0px;
    border-width: 1px;
    border-color: Theme.border;

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 5px;
        // 添加入口放在播放工具栏最左侧，和列表搜索框不重复。
        VerticalLayout {
            width: 88px;
            height: 100%;
            alignment: center;
            PmButton {
                label: "添加音频";
                filled: true;
                clicked => { root.add-files(); }
            }
        }
        // 为四个播放按钮提供固定高度的居中行，避免贴在播放条顶边。
        VerticalLayout {
            width: 135px;
            height: 100%;
            alignment: center;
            HorizontalLayout {
                width: 135px;
                height: 30px;
                spacing: 5px;
                PmButton {
                    label: "\u{E892}";
                    icon-only: true;
                    icon-transparent: true;
                    hint: "上一曲";
                    button-width: 30px;
                    button-height: 30px;
                    enabled: (root.playing || root.paused) && root.entry-index > 0;
                    clicked => { root.previous(); }
                }
                PmButton {
                    label: root.paused ? "\u{E768}" : "\u{E769}";
                    icon-only: true;
                    icon-transparent: true;
                    hint: root.paused ? "播放" : "暂停";
                    button-width: 30px;
                    button-height: 30px;
                    enabled: root.playing || root.paused;
                    clicked => { root.pause-toggle(); }
                }
                PmButton {
                    label: "\u{E71A}";
                    icon-only: true;
                    icon-transparent: true;
                    hint: "停止";
                    button-width: 30px;
                    button-height: 30px;
                    enabled: root.playing || root.paused;
                    clicked => { root.stop(); }
                }
                PmButton {
                    label: "\u{E893}";
                    icon-only: true;
                    icon-transparent: true;
                    hint: "下一曲";
                    button-width: 30px;
                    button-height: 30px;
                    enabled: (root.playing || root.paused)
                        && root.entry-index >= 0
                        && root.entry-index < root.entry-count - 1;
                    clicked => { root.next(); }
                }
            }
        }
        // 独立于播放进度，滑动即提交既有本机预览音量 API。
        VerticalLayout {
            width: 130px;
            height: 100%;
            alignment: center;
            HorizontalLayout {
                width: 130px;
                height: 30px;
                spacing: 5px;
                Text {
                    text: "\u{E767}";
                    width: 20px;
                    font-family: "Segoe MDL2 Assets";
                    color: Theme.text2;
                    font-size: 16px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                Slider {
                    horizontal-stretch: 1;
                    minimum: 0;
                    maximum: 100;
                    value <=> root.preview-volume;
                    changed(value) => { root.preview-volume-edited(value); }
                    released(value) => { root.preview-volume-edited(value); }
                }
            }
        }
        Text {
            text: root.playing || root.paused ? root.current-position : "00:00";
            width: 82px;
            color: Theme.text2;
            font-size: 10px;
            vertical-alignment: TextVerticalAlignment.center;
        }
        // Slider 仅在活动且有时长时可拖动；仍在释放后才提交 0..1 比例。
        Slider {
            horizontal-stretch: 1;
            minimum: 0;
            maximum: 1;
            value <=> root.progress;
            enabled: (root.playing || root.paused) && root.duration-seconds > 0;
            changed(value) => {
                // value 改变代表用户仍在拖动，暂不触发引擎 seek。
                root.seeking-progress = true;
            }
            released(value) => {
                // 释放时提交最终归一化值，并恢复外部进度同步。
                root.seeking-progress = false;
                root.progress-seek(value);
            }
        }
    }
}
