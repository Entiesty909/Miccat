//! 常驻状态栏：显示运行摘要、音源电平入口、总线音量与问题中心入口。

import { Theme } from "../theme.slint";
import { DiagState } from "../overlays/global-overlays.slint";
import { PmButton } from "button.slint";
import { ScrollView, Slider } from "std-widgets.slint";
import { LevelMeter } from "level-meter.slint";

// 状态栏接收 Rust bridge 的运行镜像和电平采样；用户编辑只通过回调交还宿主。
export component StatusBar inherits Rectangle {
    // 状态文案由引擎生命周期提供，不在 UI 内推导。
    in property <string> status-text: "未运行";
    // 0 普通、1 成功、2 警告、3 错误；仅决定指示灯颜色。
    in property <int> status-kind: 0;
    // 保留桥接层的错误输入契约；底栏不展示错误，诊断入口统一放在右侧徽标。
    in property <string> error-text: "";
    // 状态灯和状态文案始终位于底栏左侧。
    // 当前路由源数量，用于摘要文字和电平弹层高度。
    in property <int> source-count: 0;
    // 源标题按槽位下标对齐，供弹层逐行显示。
    in property <[string]> source-titles: [];
    // 所有源的峰值采样扁平数组，每个源占固定 32 个样本。
    in property <[float]> source-meter-history: [];
    // 每个源当前峰值 dBFS 文本，与 source-titles 下标对齐。
    in property <[string]> source-meter-dbs: [];
    // 主总线的 32 个峰值采样。
    in property <[float]> master-meter-history: [];
    // 弹层是否打开；该状态由按钮和宿主双向保持。
    in-out property <bool> source-meter-open: false;
    // 主总线最新峰值数值，保留给外部诊断/展示契约。
    in property <float> master-peak-value: 0;
    // 主总线峰值格式化文本，例如 -∞ dB。
    in property <string> master-peak-db: "-∞ dB";
    // 总线增益格式化文本，单位 dB。
    in property <string> master-volume-db: "0.0 dB";
    // 总线音量百分比，Slider 以 0–100 映射。
    in-out property <float> master-volume: 100;
    // Rust 轮询的全局光标坐标，单位为主窗口逻辑坐标。
    in-out property <length> volume-pointer-x: 0px;
    in-out property <length> volume-pointer-y: 0px;
    // 光标位置至少更新一次后才能创建悬浮窗口。
    in-out property <bool> volume-pointer-valid: false;
    // 总音量拖动态由 Slint 滑块上报并传给桥接层轮询全局光标。
    in-out property <bool> volume-adjusting: false;
    // 滑块变化后通知 Rust 更新总线增益。
    callback master-volume-edited(float);
    changed volume-adjusting => {
        if !root.volume-adjusting {
            root.volume-pointer-valid = false;
            volume-pointer-popup.close();
        }
    }
    changed volume-pointer-valid => {
        if root.volume-adjusting && root.volume-pointer-valid {
            volume-pointer-popup.show();
        } else {
            volume-pointer-popup.close();
        }
    }

    background: Theme.bar-bg;
    border-width: 1px;
    border-color: Theme.border;

    HorizontalLayout {
        width: 100%;
        height: 100%;
        padding-left: 12px;
        padding-right: 12px;
        spacing: 7px;

        // 状态指示区使用固定控件高度并在全高包装中垂直居中。
        VerticalLayout {
            height: 100%;
            alignment: center;
            HorizontalLayout {
                height: 36px;
                spacing: 8px;
                VerticalLayout {
                    width: 12px;
                    height: 36px;
                    alignment: center;
                    Rectangle {
                        width: 10px;
                        height: 10px;
                        border-radius: 5px;
                        // 指示灯颜色由 bridge 状态码决定，不参与业务状态转换。
                        background: root.status-kind == 1
                            ? Theme.ok
                            : (root.status-kind == 2
                                ? Theme.warn
                                : (root.status-kind == 3
                                    ? Theme.danger
                                    : Theme.text3));
                    }
                }
                Text {
                    text: root.status-text;
                    color: Theme.text;
                    font-size: 15px;
                    font-weight: 600;
                    vertical-alignment: center;
                }
            }
        }

        Rectangle {
            horizontal-stretch: 1;
            background: transparent;
        }

        // 音源入口固定靠右并用作声纹弹层锚点。
        VerticalLayout {
            width: 144px;
            height: 100%;
            alignment: center;
            source-count-anchor := Rectangle {
                width: 144px;
                height: 36px;
                background: transparent;
                // 音源计数为可点击弹层入口，悬停时说明其操作。
                Tooltip {
                    text: @markdown("查看各音频源电平");
                }
                HorizontalLayout {
                    spacing: 3px;
                    Text {
                        text: "\{root.source-count} 个音频源";
                        width: self.preferred-width;
                        horizontal-stretch: 0;
                        color: Theme.text2;
                        font-size: 15px;
                        vertical-alignment: center;
                    }
                    Text {
                        text: root.source-meter-open ? "\u{E70E}" : "\u{E70D}";
                        width: 15px;
                        font-family: "Segoe MDL2 Assets";
                        color: root.source-meter-open ? Theme.accent : Theme.text2;
                        font-size: 13px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
                TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.source-meter-open = !root.source-meter-open;
                    }
                }
            }
        }

        // 固定音量控件宽度；提示由独立PopupWindow绘制，不改变布局尺寸。
        VerticalLayout {
            width: 330px;
            height: 100%;
            alignment: center;
            HorizontalLayout {
                width: 330px;
                height: 36px;
                spacing: 12px;
                Text {
                    text: "\u{E767}";
                    width: 21px;
                    font-family: "Segoe MDL2 Assets";
                    color: Theme.text2;
                    font-size: 18px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                volume-slider := Slider {
                    horizontal-stretch: 1;
                    minimum: 0;
                    maximum: 100;
                    value <=> root.master-volume;
                    changed(value) => {
                        root.volume-adjusting = true;
                        root.volume-pointer-x = volume-slider.absolute-position.x
                            + volume-slider.width * (value / 100);
                        root.volume-pointer-y = volume-slider.absolute-position.y
                            + volume-slider.height / 2;
                        root.volume-pointer-valid = true;
                        root.master-volume-edited(value);
                    }
                    released(value) => {
                        root.volume-adjusting = false;
                        root.master-volume-edited(value);
                    }
                }
            }
        }

        // 诊断入口仅保留在设置页「诊断」分组内，底栏不再提供徽标入口。
    }
    // 独立 PopupWindow 让提示能越过主窗口边界，并始终以全局光标为锚点。
    volume-pointer-popup := PopupWindow {
        x: root.volume-pointer-x - 66px;
        y: root.volume-pointer-y + 12px;
        width: 132px;
        height: 18px;
        close-policy: no-auto-close;
        Text {
            text: "\{root.master-volume-db}   \{Math.round(root.master-volume)}%";
            width: 100%;
            height: 100%;
            color: Theme.text;
            font-size: 10px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    // 源电平弹层覆盖在状态栏上方，关闭时不创建子项，降低常驻布局成本。
    if root.source-meter-open: Rectangle {
        x: source-count-anchor.absolute-position.x - root.absolute-position.x;
        y: source-count-anchor.absolute-position.y
            - root.absolute-position.y
            - self.height
            - 8px;
        // 高度随源数量增长但封顶，ScrollView 负责超过可视区域的滚动。
        width: 360px;
        height: min(300px, 104px + 34px * root.source-count);
        border-radius: Theme.radiusCard;
        border-width: 1px;
        border-color: Theme.borderStrong;
        background: Theme.card;
        VerticalLayout {
            padding: 12px;
            spacing: 8px;
            Text {
                text: "实时声纹 · 峰值 dBFS";
                color: Theme.text;
                font-size: 13px;
                font-weight: 600;
            }
            // 每个源取扁平采样中的 32 点窗口；sample-offset 由槽位下标计算。
            ScrollView {
                vertical-stretch: 1;
                vertical-scrollbar-policy: always-off;
                VerticalLayout {
                    spacing: 4px;
                    for title[index] in root.source-titles: HorizontalLayout {
                        height: 28px;
                        Text {
                            text: title;
                            width: 110px;
                            color: Theme.text2;
                            font-size: 10px;
                            overflow: elide;
                            vertical-alignment: center;
                        }
                        LevelMeter {
                            horizontal-stretch: 1;
                            height: 24px;
                            samples: root.source-meter-history;
                            sample-offset: index * 32;
                            sample-count: 32;
                            tint: Theme.accent;
                        }
                        Text {
                            text: index < root.source-meter-dbs.length
                                ? root.source-meter-dbs[index]
                                : "-∞ dB";
                            width: 54px;
                            color: Theme.text;
                            font-size: 10px;
                            horizontal-alignment: right;
                            vertical-alignment: center;
                        }
                    }
                }
            }
            HorizontalLayout {
                height: 28px;
                Text {
                    text: "总线";
                    width: 110px;
                    color: Theme.text2;
                    font-size: 10px;
                    vertical-alignment: center;
                }
                LevelMeter {
                    horizontal-stretch: 1;
                    height: 24px;
                    samples: root.master-meter-history;
                    sample-offset: 0;
                    sample-count: 32;
                    tint: Theme.ok;
                }
                Text {
                    text: root.master-peak-db;
                    width: 54px;
                    color: Theme.text;
                    font-size: 10px;
                    horizontal-alignment: right;
                    vertical-alignment: center;
                }
            }
            Text {
                text: "总线增益（相对 100%）：\{root.master-volume-db}";
                color: Theme.text3;
                font-size: 9px;
            }
        }
        // 空 TouchArea 拦截弹层内部点击，避免点击内容时冒泡关闭弹层。
        TouchArea { }
    }
}
