//! 音频库详情面板：展示选中文件的本地元数据和管理字段。

import { CheckBox, ComboBox, ScrollView } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { Card } from "card.slint";

export component AudioDetail inherits Card {
    in property <[string]> entries: [];
    in property <[string]> metadata: [];
    in property <[string]> categories: [];
    in property <[string]> durations: [];
    in property <[string]> sizes: [];
    in property <[string]> paths: [];
    in property <[string]> category-options: [];
    in property <string> hotkey: "";
    in property <bool> listening-hotkey: false;
    in property <int> entry-index: -1;
    in-out property <int> category-index: 0;
    in-out property <bool> preview-enabled: false;
    in-out property <bool> loop: false;
    callback category-changed(int);
    callback preview-toggled(bool);
    callback loop-toggled(bool);
    callback hotkey-bind();
    callback hotkey-clear();

    width: 340px;
    vertical-stretch: 1;

    min-height: 0px;
    ScrollView {
        width: 100%;
        height: 100%;
        vertical-scrollbar-policy: always-off;
        horizontal-scrollbar-policy: always-off;
        VerticalLayout {
            width: 100%;
            alignment: LayoutAlignment.start;
            spacing: 8px;
            HorizontalLayout {
                height: 78px;
                spacing: 12px;
                Rectangle {
                    width: 68px;
                    height: 68px;
                    border-radius: 8px;
                    background: Theme.accentSoft;
                    Text {
                        text: "\u{E8D6}";
                        font-family: "Segoe MDL2 Assets";
                        font-size: 30px;
                        color: Theme.accent;
                        horizontal-alignment: center;
                        vertical-alignment: TextVerticalAlignment.center;
                    }
                }
                VerticalLayout {
                    horizontal-stretch: 1;
                    min-width: 0px;
                    Text {
                        text: root.entry-index >= 0
                            && root.entry-index < root.entries.length
                            ? root.entries[root.entry-index]
                            : "未选择音频";
                        color: Theme.text;
                        font-size: 15px;
                        font-weight: 700;
                        overflow: elide;
                    }
                    Text {
                        text: root.entry-index >= 0
                            && root.entry-index < root.metadata.length
                            ? root.metadata[root.entry-index]
                            : "从本地音频库选择文件";
                        color: Theme.text2;
                        font-size: 10px;
                        overflow: elide;
                    }
                    Rectangle {
                        width: 72px;
                        height: 22px;
                        border-radius: 4px;
                        background: Theme.accentSoft;
                        Text {
                            text: root.entry-index >= 0
                                && root.entry-index < root.categories.length
                                ? root.categories[root.entry-index]
                                : "未分类";
                            width: 100%;
                            color: Theme.accent;
                            font-size: 10px;
                            horizontal-alignment: center;
                            vertical-alignment: TextVerticalAlignment.center;
                            overflow: elide;
                        }
                    }
                }
            }
            Text {
                text: "快捷键";
                color: Theme.text2;
                font-size: 11px;
            }
            Rectangle {
                height: 36px;
                background: Theme.field;
                border-width: 1px;
                border-color: Theme.borderStrong;
                border-radius: Theme.radiusControl;
                Text {
                    x: 12px;
                    width: parent.width - 44px;
                    text: root.listening-hotkey
                        ? "按下快捷键…"
                        : (root.hotkey == "" ? "未设置" : root.hotkey);
                    color: Theme.text;
                    vertical-alignment: center;
                    overflow: elide;
                }
                if root.hotkey != "": Text {
                    x: parent.width - 28px;
                    width: 20px;
                    text: "×";
                    color: Theme.text3;
                    font-size: 16px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    TouchArea {
                        clicked => { root.hotkey-clear(); }
                    }
                }
                TouchArea {
                    enabled: root.hotkey == "";
                    clicked => { root.hotkey-bind(); }
                }
            }
            HorizontalLayout {
                height: 30px;
                Text {
                    text: "循环播放";
                    horizontal-stretch: 1;
                    color: Theme.text2;
                    font-size: 11px;
                    vertical-alignment: center;
                }
                CheckBox {
                    checked <=> root.loop;
                    enabled: root.entry-index >= 0;
                    toggled => { root.loop-toggled(self.checked); }
                }
            }
            Text { text: "分类"; color: Theme.text2; font-size: 11px; }
            ComboBox {
                model: root.category-options;
                current-index <=> root.category-index;
                enabled: root.entry-index >= 0;
                selected(value) => { root.category-changed(root.category-index); }
            }
            VerticalLayout {
                spacing: 2px;
                HorizontalLayout {
                    height: 28px;
                    Text {
                        text: "本机试听";
                        horizontal-stretch: 1;
                        color: Theme.text2;
                        font-size: 11px;
                        vertical-alignment: center;
                    }
                    CheckBox {
                        checked <=> root.preview-enabled;
                        toggled => { root.preview-toggled(self.checked); }
                    }
                }
                Text {
                    text: "在本机设备上播放该音频（不经过路由）";
                    color: Theme.text3;
                    font-size: 9px;
                }
            }
            Rectangle { height: 1px; width: 100%; background: Theme.border; }
            Text {
                text: "文件信息";
                color: Theme.text;
                font-size: 13px;
                font-weight: 600;
            }
            HorizontalLayout {
                Text { text: "文件名"; width: 68px; color: Theme.text2; font-size: 10px; }
                Text {
                    text: root.entry-index >= 0
                        && root.entry-index < root.entries.length
                        ? root.entries[root.entry-index]
                        : "—";
                    horizontal-stretch: 1;
                    color: Theme.text2;
                    font-size: 10px;
                    overflow: elide;
                }
            }
            HorizontalLayout {
                Text { text: "格式/码率"; width: 68px; color: Theme.text2; font-size: 10px; }
                Text {
                    text: root.entry-index >= 0
                        && root.entry-index < root.metadata.length
                        ? root.metadata[root.entry-index]
                        : "—";
                    horizontal-stretch: 1;
                    color: Theme.text2;
                    font-size: 10px;
                    overflow: elide;
                }
            }
            HorizontalLayout {
                Text { text: "时长"; width: 68px; color: Theme.text2; font-size: 10px; }
                Text {
                    text: root.entry-index >= 0
                        && root.entry-index < root.durations.length
                        ? root.durations[root.entry-index]
                        : "—";
                    color: Theme.text2;
                    font-size: 10px;
                }
            }
            HorizontalLayout {
                Text { text: "文件大小"; width: 68px; color: Theme.text2; font-size: 10px; }
                Text {
                    text: root.entry-index >= 0
                        && root.entry-index < root.sizes.length
                        ? root.sizes[root.entry-index]
                        : "—";
                    color: Theme.text2;
                    font-size: 10px;
                }
            }
            HorizontalLayout {
                Text { text: "路径"; width: 68px; color: Theme.text2; font-size: 10px; }
                Text {
                    text: root.entry-index >= 0
                        && root.entry-index < root.paths.length
                        ? root.paths[root.entry-index]
                        : "—";
                    horizontal-stretch: 1;
                    min-width: 0px;
                    color: Theme.text3;
                    font-size: 9px;
                    overflow: elide;
                }
            }
            Rectangle { vertical-stretch: 1; background: transparent; }
        }
    }
}
