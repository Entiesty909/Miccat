//! 音频库详情面板：展示选中文件的本地元数据和管理字段。

import { ScrollView } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { Card } from "card.slint";

// 选中音频的详情与编辑面板；所有并行数组按 entry-index 对齐。
export component AudioDetail inherits Card {
    // 当前分类下的音频名称列表，显示值由 entry-index 选择。
    in property <[string]> entries: [];
    // 条目格式/码率等副标题，索引与 entries 一一对应。
    in property <[string]> metadata: [];
    // 每个条目的格式化时长文本，单位已由数据层处理。
    in property <[string]> durations: [];
    // 每个条目的格式化文件大小文本。
    in property <[string]> sizes: [];
    // 每个条目的本地路径，仅用于详情展示，不在组件内访问文件。
    in property <[string]> paths: [];
    // 当前条目的快捷键标签，为空表示未绑定。
    in property <string> hotkey: "";
    // 是否处于等待键盘输入阶段，影响快捷键输入框提示。
    in property <bool> listening-hotkey: false;
    // 当前条目索引；负值代表没有选择，越界时所有详情字段回退占位文本。
    in property <int> entry-index: -1;
    // 请求宿主进入快捷键捕获流程。
    callback hotkey-bind();
    // 请求宿主清除当前条目的快捷键绑定。
    callback hotkey-clear();

    width: 340px;
    vertical-stretch: 1;

    min-height: 0px;
    ScrollView {
        width: 100%;
        height: 100%;
        vertical-scrollbar-policy: always-off;
        horizontal-scrollbar-policy: always-off;
        VerticalLayout {
            width: 100%;
            alignment: LayoutAlignment.start;
            spacing: 8px;
            HorizontalLayout {
                height: 78px;
                spacing: 12px;
                Rectangle {
                    width: 68px;
                    height: 68px;
                    border-radius: 8px;
                    background: Theme.accentSoft;
                    Text {
                        text: "\u{E8D6}";
                        font-family: "Segoe MDL2 Assets";
                        font-size: 30px;
                        color: Theme.accent;
                        horizontal-alignment: center;
                        vertical-alignment: TextVerticalAlignment.center;
                    }
                }
                VerticalLayout {
                    horizontal-stretch: 1;
                    min-width: 0px;
                    // 以 entry-index 读取 entries；负值或越界时展示未选择占位状态。
                    Text {
                        text: root.entry-index >= 0
                            && root.entry-index < root.entries.length
                            ? root.entries[root.entry-index]
                            : "未选择音频";
                        color: Theme.text;
                        font-size: 15px;
                        font-weight: 700;
                        overflow: elide;
                    }
                    // metadata 与 entries 共用 entry-index，数组不足时不暴露错误数据。
                    Text {
                        text: root.entry-index >= 0
                            && root.entry-index < root.metadata.length
                            ? root.metadata[root.entry-index]
                            : "从本地音频库选择文件";
                        color: Theme.text2;
                        font-size: 10px;
                        overflow: elide;
                    }
                }
            }
            Text {
                text: "快捷键";
                color: Theme.text2;
                font-size: 11px;
            }
            Rectangle {
                height: 36px;
                background: Theme.field;
                border-width: 1px;
                border-color: Theme.borderStrong;
                border-radius: Theme.radiusControl;
                Text {
                    x: 12px;
                    width: parent.width - 44px;
                    text: root.listening-hotkey
                        ? "按下快捷键…"
                        : (root.hotkey == "" ? "未设置" : root.hotkey);
                    color: Theme.text;
                    vertical-alignment: center;
                    overflow: elide;
                }
                // 已绑定时显示清除按钮；无绑定则由下方热区启动捕获。
                if root.hotkey != "": Text {
                    x: parent.width - 28px;
                    width: 20px;
                    text: "×";
                    color: Theme.text3;
                    font-size: 16px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    // 仅在已有快捷键时显示清除热区，点击会让宿主移除绑定。
                    TouchArea {
                        clicked => { root.hotkey-clear(); }
                    }
                }
                // 无绑定时允许进入捕获流程；有绑定时禁用以避免误覆盖。
                TouchArea {
                    enabled: root.hotkey == "";
                    clicked => { root.hotkey-bind(); }
                }
            }
            Rectangle { height: 1px; width: 100%; background: Theme.border; }
            Text {
                text: "文件信息";
                color: Theme.text;
                font-size: 13px;
                font-weight: 600;
            }
            // 文件属性均只展示与 entry-index 对应的宿主数据，不访问文件系统。
            HorizontalLayout {
                Text { text: "文件名"; width: 68px; color: Theme.text2; font-size: 10px; }
                Text {
                    text: root.entry-index >= 0
                        && root.entry-index < root.entries.length
                        ? root.entries[root.entry-index]
                        : "—";
                    horizontal-stretch: 1;
                    color: Theme.text2;
                    font-size: 10px;
                    overflow: elide;
                }
            }
            HorizontalLayout {
                Text { text: "格式/码率"; width: 68px; color: Theme.text2; font-size: 10px; }
                Text {
                    text: root.entry-index >= 0
                        && root.entry-index < root.metadata.length
                        ? root.metadata[root.entry-index]
                        : "—";
                    horizontal-stretch: 1;
                    color: Theme.text2;
                    font-size: 10px;
                    overflow: elide;
                }
            }
            HorizontalLayout {
                Text { text: "时长"; width: 68px; color: Theme.text2; font-size: 10px; }
                Text {
                    text: root.entry-index >= 0
                        && root.entry-index < root.durations.length
                        ? root.durations[root.entry-index]
                        : "—";
                    color: Theme.text2;
                    font-size: 10px;
                }
            }
            HorizontalLayout {
                Text { text: "文件大小"; width: 68px; color: Theme.text2; font-size: 10px; }
                Text {
                    text: root.entry-index >= 0
                        && root.entry-index < root.sizes.length
                        ? root.sizes[root.entry-index]
                        : "—";
                    color: Theme.text2;
                    font-size: 10px;
                }
            }
            HorizontalLayout {
                Text { text: "路径"; width: 68px; color: Theme.text2; font-size: 10px; }
                Text {
                    text: root.entry-index >= 0
                        && root.entry-index < root.paths.length
                        ? root.paths[root.entry-index]
                        : "—";
                    horizontal-stretch: 1;
                    min-width: 0px;
                    color: Theme.text3;
                    font-size: 9px;
                    overflow: elide;
                }
            }
            Rectangle { vertical-stretch: 1; background: transparent; }
        }
    }
}
