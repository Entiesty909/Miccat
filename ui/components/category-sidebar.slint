//! 音频库分类栏：本地分类计数、拖拽排序和上下文菜单。

import { Card } from "card.slint";
import { Theme } from "../theme.slint";

// 分类侧栏：展示分类树，并把选择、拖放和菜单操作上报宿主。
export component CategorySidebar inherits Card {
    // 分类名称按树序排列；每个名称与其他分类数组共享同一索引。
    in-out property <[string]> categories: [];
    // 分类条目计数，与 categories 按索引对齐。
    in-out property <[int]> category-counts: [];
    // 分类树深度，单位为层级，决定行内容的缩进量。
    in-out property <[int]> category-depths: [];
    // 分类自定义图标图像，与字形数组按分类索引配对。
    in-out property <[image]> category-icon-images: [];
    // 分类图标字形；空字符串表示优先显示对应图像。
    in-out property <[string]> category-icon-glyphs: [];
    // 当前选中的分类索引，-1 表示上下文菜单作用于空白区域。
    in-out property <int> category-index: 0;
    // 当前拖放命中的分类索引，-1 表示没有有效目标。
    in-out property <int> category-drop-target: -1;
    // 拖放位置协议：0 为上方、1 为内部、2 为下方，-1 表示未命中。
    in-out property <int> category-drop-position: -1;
    // 分类上下文菜单可见状态，由本组件的选择和右键交互维护。
    in-out property <bool> category-menu-open: false;
    // 条目菜单可见状态；打开分类菜单时必须关闭它。
    in-out property <bool> entry-menu-open: false;
    // 分类上下文菜单左上角横坐标，单位为 length。
    in-out property <length> category-menu-x: 0px;
    // 分类上下文菜单左上角纵坐标，单位为 length。
    in-out property <length> category-menu-y: 0px;
    // 用户选择分类后通知宿主刷新条目筛选。
    callback category-changed(int);
    // 请求宿主打开指定分类的上下文菜单。
    callback category-context(int);
    // 将分类索引转换为拖放数据，保持拖动协议由宿主定义。
    pure callback category-to-transfer(int) -> data-transfer;
    // 音频条目拖入分类时由宿主验证、持久化；分类重排仍使用上面的协议。
    callback entry-category-can-drop(data-transfer, int) -> bool;
    callback entry-category-drop(data-transfer, int);
    // 宿主校验分类拖放数据、目标和插入位置。
    callback category-can-drop(data-transfer, int, int) -> bool;
    callback category-drop(data-transfer, int, int);

    width: 180px;
    vertical-stretch: 1;

    VerticalLayout {
        width: 100%;
        height: 100%;
        Text {
            text: "分类";
            color: Theme.text;
            font-size: 14px;
            font-weight: 600;
        }
        Rectangle { height: 1px; width: 100%; background: Theme.border; }
        VerticalLayout {
            vertical-stretch: 1;
            height: 100%;
            spacing: 2px;
            // 分类列表为空时保留空白命中区，右键仍可请求创建分类。
            if root.categories.length == 0: Rectangle {
                width: 100%;
                vertical-stretch: 1;
                background: transparent;
                Text {
                    x: 10px;
                    y: 10px;
                    width: parent.width - 20px;
                    text: "暂无分类，右键创建分类";
                    color: Theme.text3;
                    font-size: 12px;
                    wrap: word-wrap;
                }
                // 空列表命中区只处理右键，并把菜单作用对象标记为 -1。
                TouchArea {
                    width: 100%;
                    height: 100%;
                    pointer-event(event) => {
                        if event.button == PointerEventButton.right
                            && event.kind == PointerEventKind.down {
                            root.category-index = -1;
                            root.category-context(-1);
                            root.category-menu-x = self.absolute-position.x + self.mouse-x;
                            root.category-menu-y = self.absolute-position.y + self.mouse-y;
                            root.category-menu-open = true;
                            root.entry-menu-open = false;
                        }
                    }
                }
            }
            // 每个分类行携带宿主序列化的数据；系统分类不可移动。
            for category[index] in root.categories: DragArea {
                height: 36px;
                allow-move: category != "全部" && category != "未分类";
                data: root.category-to-transfer(index);
                // 无论拖放是否成功都清除指示器，避免旧目标残留。
                drag-finished(action) => {
                    root.category-drop-target = -1;
                    root.category-drop-position = -1;
                }
                Rectangle {
                    width: 100%;
                    height: 100%;
                    background: index == root.category-index
                        || (index == root.category-drop-target
                            && root.category-drop-position == 1)
                        ? Theme.accentSoft
                        : transparent;
                    // “全部”不接受归类；“未分类”允许音频移入但不能参与分类重排。
                    if category != "全部": DropArea {
                        width: 100%;
                        height: 100%;
                        can-drop(event) => {
                            if root.entry-category-can-drop(event.data, index) {
                                root.category-drop-target = index;
                                root.category-drop-position = 1;
                                return DragAction.move;
                            }
                            if category != "未分类" {
                                let position = event.position.y < self.height * 0.25
                                    ? 0
                                    : (event.position.y > self.height * 0.75 ? 2 : 1);
                                if root.category-can-drop(event.data, index, position) {
                                    root.category-drop-target = index;
                                    root.category-drop-position = position;
                                    return DragAction.move;
                                }
                            }
                            root.category-drop-target = -1;
                            root.category-drop-position = -1;
                            return DragAction.none;
                        }
                        dropped(event) => {
                            if root.entry-category-can-drop(event.data, index) {
                                root.entry-category-drop(event.data, index);
                            } else if category != "未分类" {
                                let position = event.position.y < self.height * 0.25
                                    ? 0
                                    : (event.position.y > self.height * 0.75 ? 2 : 1);
                                if root.category-can-drop(event.data, index, position) {
                                    root.category-drop(event.data, index, position);
                                }
                            }
                            root.category-drop-target = -1;
                            root.category-drop-position = -1;
                            return event.proposed-action;
                        }
                    }
                    HorizontalLayout {
                        height: 36px;
                        padding-left: (index < root.category-depths.length
                            ? root.category-depths[index] * 6px
                            : 0px) + 6px;
                        padding-right: 6px;
                        spacing: 4px;
                        // 图标盒与分类文字共用行中线；图像和字形在盒内双轴居中。
                        Rectangle {
                            width: 18px;
                            height: 36px;
                            background: transparent;
                            // 有图像且字形为空时使用自定义图标资源。
                            if index < root.category-icon-images.length
                                && index < root.category-icon-glyphs.length
                                && root.category-icon-glyphs[index] == "": Image {
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                                width: 18px;
                                height: 18px;
                                source: root.category-icon-images[index];
                                image-fit: contain;
                            }
                            // 没有可用图像时显示字形，缺失字形再回退到分类默认图标。
                            if index >= root.category-icon-glyphs.length
                                || root.category-icon-glyphs[index] != "": Text {
                                text: index < root.category-icon-glyphs.length
                                    ? root.category-icon-glyphs[index]
                                    : (category == "未分类" ? "\u{E8F4}" : "\u{E8B7}");
                                font-family: "Segoe MDL2 Assets";
                                width: 18px;
                                y: (parent.height - self.height) / 2;
                                height: 18px;
                                color: index == root.category-index
                                    ? Theme.accent
                                    : Theme.text2;
                                vertical-alignment: TextVerticalAlignment.center;
                                horizontal-alignment: center;
                            }
                        }
                        Text {
                            text: category;
                            horizontal-stretch: 1;
                            min-width: 0px;
                            color: index == root.category-index ? Theme.accent : Theme.text;
                            font-size: 12px;
                            overflow: elide;
                            vertical-alignment: TextVerticalAlignment.center;
                            horizontal-alignment: left;
                        }
                        Text {
                            text: index < root.category-counts.length
                                ? "\{root.category-counts[index]}"
                                : "0";
                            width: 32px;
                            color: Theme.text2;
                            font-size: 11px;
                            vertical-alignment: TextVerticalAlignment.center;
                            horizontal-alignment: right;
                        }
                    }
                    // 仅在目标位置为行首时绘制上方插入提示线。
                    if root.category-drop-target == index
                        && root.category-drop-position == 0: Rectangle {
                        width: 100%;
                        height: 2px;
                        background: Theme.accent;
                    }
                    // 仅在目标位置为行尾时绘制下方插入提示线。
                    if root.category-drop-target == index
                        && root.category-drop-position == 2: Rectangle {
                        y: parent.height - 2px;
                        width: 100%;
                        height: 2px;
                        background: Theme.accent;
                    }
                    // 行点击选择分类并关闭两个互斥的上下文菜单。
                    TouchArea {
                        clicked => {
                            root.category-index = index;
                            root.category-changed(index);
                            root.category-menu-open = false;
                            root.entry-menu-open = false;
                        }
                        // 行右键按屏幕坐标打开分类菜单，并关闭条目菜单。
                        pointer-event(event) => {
                            if event.button == PointerEventButton.right
                                && event.kind == PointerEventKind.down {
                                root.category-index = index;
                                root.category-context(index);
                                root.category-menu-x =
                                    self.absolute-position.x + self.mouse-x;
                                root.category-menu-y =
                                    self.absolute-position.y + self.mouse-y;
                                root.category-menu-open = true;
                                root.entry-menu-open = false;
                            }
                        }
                    }
                }
            }
            // 列表末尾空白区也支持右键菜单，但不绑定具体分类。
            TouchArea {
                width: 100%;
                vertical-stretch: 1;
                pointer-event(event) => {
                    if event.button == PointerEventButton.right
                        && event.kind == PointerEventKind.down {
                        root.category-index = -1;
                        root.category-context(-1);
                        root.category-menu-x = self.absolute-position.x + self.mouse-x;
                        root.category-menu-y = self.absolute-position.y + self.mouse-y;
                        root.category-menu-open = true;
                        root.entry-menu-open = false;
                    }
                }
            }
        }
    }
}
