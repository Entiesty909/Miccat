//! 添加路由时显示所选音频文件的真实元数据和输出设置。

import { MarqueeComboBox } from "marquee-combo-box.slint";
import { Theme } from "../theme.slint";
import { SliderRow } from "slider-row.slint";

// 添加路由对话框中展示单个库条目的元数据、输出目标和音量。
export component AudioSourceDetails inherits Rectangle {
    // 由音频库提供的显示名称及格式元数据；这些字段只读展示，不改变库记录。
    in property <string> entry-name: "";
    // 预格式化的编码信息，来源于所选音频文件的扫描结果。
    in property <string> entry-metadata: "";
    // 已格式化的时长文本，单位由上游转换为用户可读字符串。
    in property <string> entry-duration: "";
    // 已格式化的文件大小文本，避免组件自行推断单位。
    in property <string> entry-size: "";
    // 当前条目所属分类名称，用于确认路由来源。
    in property <string> entry-category: "";
    // 当前条目绑定的快捷键显示值。
    in property <string> entry-hotkey: "";
    // 循环播放状态的说明文本，由上游决定具体措辞。
    in property <string> entry-loop-state: "";
    // 输出列表沿用路由卡片设备顺序，索引只用于当前对话框勾选。
    in property <[string]> outputs: [];
    // 对话框的逐项勾选与 Windows 友好名，仅在确认添加源时提交。
    in property <[bool]> selected-outputs: [];
    in property <string> selected-output-label: "";
    // 当前路由槽位的音量百分比，范围约定由 SliderRow/宿主共同维护。
    in-out property <float> volume: 100;
    // 通知宿主切换一个输出项，不能因两个端点共享 render ID 而连带改变选择。
    callback output-toggled(int, bool);
    // 用户提交了新的音量值，副作用由宿主应用到对应路由槽位。
    callback volume-edited(float);

    horizontal-stretch: 1;
    border-radius: Theme.radiusControl;
    border-width: 1px;
    border-color: Theme.border;
    background: Theme.card;

    VerticalLayout {
        padding: 14px;
        spacing: 8px;
        Text {
            text: root.entry-name;
            color: Theme.text;
            font-size: 13px;
            font-weight: 600;
            overflow: elide;
        }
        Text {
            text: root.entry-metadata;
            color: Theme.text2;
            font-size: 10px;
            overflow: elide;
        }
        HorizontalLayout {
            spacing: 12px;
            Text {
                text: "时长  " + root.entry-duration;
                color: Theme.text2;
                font-size: 10px;
            }
            Text {
                text: "大小  " + root.entry-size;
                color: Theme.text2;
                font-size: 10px;
            }
        }
        HorizontalLayout {
            spacing: 12px;
            Text {
                text: "分类  " + root.entry-category;
                color: Theme.text2;
                font-size: 10px;
            }
            Text {
                text: "快捷键  " + root.entry-hotkey;
                color: Theme.text2;
                font-size: 10px;
            }
        }
        Text {
            text: root.entry-loop-state;
            color: Theme.text2;
            font-size: 10px;
        }
        Text {
            text: "输出设备";
            color: Theme.text2;
            font-size: 11px;
        }
        MarqueeComboBox {
            model: root.outputs;
            multi-select: true;
            checked: root.selected-outputs;
            multi-label: root.selected-output-label;
            selection-toggled(index, checked) => {
                root.output-toggled(index, checked);
            }
        }
        SliderRow {
            label: "音量";
            value <=> root.volume;
            edited(value) => {
                // 绑定值已写回本卡片；回调让宿主同步音频引擎。
                root.volume-edited(value);
            }
        }
        Rectangle { vertical-stretch: 1; background: transparent; }
    }
}
