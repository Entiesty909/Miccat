//! 全局右键菜单宿主：把页面菜单状态接到 ContextMenu，避免 app-window 逐项透传。

import { ContextMenu } from "context-menu.slint";

/// 菜单宿主：属性与回调由 app-window 双向绑定。
// 全局右键菜单宿主：承载可见菜单，并把页面数据及操作回调集中转接。
export component ContextMenuHost inherits Rectangle {
    // 菜单显隐及屏幕位置，双向连接到页面拥有的状态。
    in-out property <bool> category-open: false;
// 条目菜单当前是否显示。
    in-out property <bool> entry-open: false;
// 分类菜单 X 坐标。
    in-out property <length> category-x: 0px;
// 分类菜单 Y 坐标。
    in-out property <length> category-y: 0px;
// 条目菜单 X 坐标。
    in-out property <length> entry-x: 0px;
// 条目菜单 Y 坐标。
    in-out property <length> entry-y: 0px;
    // 当前分类索引与重命名文本，维持菜单编辑期间的数据来源。
    in-out property <int> category-index: 0;
// 分类编辑时的名称输入值。
    in-out property <string> category-edit-name: "";
    // 当前条目的快捷键标签，由页面只读提供。
    in property <string> entry-hotkey: "";
    // 分类操作转发到页面，由页面完成实际状态变更。
    // 请求打开分类编辑窗口。
    callback category-edit-requested();
    // 请求创建分类。
    callback category-new();
    // 提交分类重命名。
    callback category-rename();
    // 请求删除分类。
    callback category-delete();
    // 音频条目操作转发；播放参数选择播放路径。
    // 请求播放条目，参数保持 ContextMenu 的播放模式协议。
    callback entry-play(int);
    // 请求将条目添加到路由主页。
    callback entry-add-route();
    // 请求绑定条目快捷键。
    callback entry-hotkey-bind();
    // 请求清除条目快捷键。
    callback entry-hotkey-clear();
    // 请求从音频库移除条目。
    callback entry-remove();
    // 请求在资源管理器中定位条目。
    callback entry-explorer();
    // 请求打开条目编辑窗口。
    callback entry-edit-requested();
    // 请求编辑条目文件，保持与 ContextMenu 的转发接口一致。
    callback entry-edit-file();

    width: 100%;
    height: 100%;
    background: transparent;

    // 仅在至少一个菜单打开时实例化覆盖层，关闭后释放命中区域。
    if root.category-open || root.entry-open: ContextMenu {
        category-open <=> root.category-open;
        entry-open <=> root.entry-open;
        category-x <=> root.category-x;
        category-y <=> root.category-y;
        entry-x <=> root.entry-x;
        entry-y <=> root.entry-y;
        category-index <=> root.category-index;
        category-edit-name <=> root.category-edit-name;
        entry-hotkey: root.entry-hotkey;
        category-edit-requested => { root.category-edit-requested(); }
        category-new => { root.category-new(); }
        category-rename => { root.category-rename(); }
        category-delete => { root.category-delete(); }
        entry-play(i) => { root.entry-play(i); }
        entry-add-route => { root.entry-add-route(); }
        entry-hotkey-bind => { root.entry-hotkey-bind(); }
        entry-hotkey-clear => { root.entry-hotkey-clear(); }
        entry-remove => { root.entry-remove(); }
        entry-edit-requested => { root.entry-edit-requested(); }
        entry-explorer => { root.entry-explorer(); }
        entry-edit-file => { root.entry-edit-file(); }
    }
}
