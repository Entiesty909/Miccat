//! 路由页：以对齐的音源行和独立 render 目标选择配置进程、文件和麦克风。

import { ScrollView } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { PmButton } from "../components/button.slint";
import { SourceRow } from "../components/source-row.slint";
import { SourceActionsMenu } from "../components/source-actions-menu.slint";
export component RoutePage inherits Rectangle {
    in-out property <[string]> processes: [];
    in-out property <[string]> process-pids: [];
    in-out property <[image]> process-icon-images: [];
    in-out property <float> audio-file-volume: 100;
    in-out property <float> microphone-input-volume: 100;
    in-out property <string> process-search: "";
    in-out property <[string]> categories: [];
    in-out property <int> process-index: 0;
    in-out property <[int]> source-kinds: [];
    in-out property <[string]> source-icons: [];
    in-out property <[image]> source-icon-images: [];
    in-out property <[string]> source-titles: [];
    in-out property <[string]> source-subtitles: [];
    in-out property <[string]> source-details: [];
    in-out property <[string]> source-statuses: [];
    in-out property <[bool]> source-active: [];
    in-out property <[string]> source-peak-dbs: [];
    in-out property <[float]> source-peak-values: [];
    in-out property <[string]> source-volume-dbs: [];
    in-out property <[float]> source-volumes: [];
    in-out property <[bool]> source-muted: [];
    in-out property <[int]> source-output-indices: [];
    in-out property <[string]> outputs: [];
    in-out property <[bool]> source-paused: [];
    in-out property <[string]> audio-entries: [];
    in-out property <[string]> audio-catalog-metadata: [];
    in-out property <[string]> audio-catalog-durations: [];
    in-out property <[string]> audio-catalog-sizes: [];
    in-out property <[string]> audio-catalog-categories: [];
    in-out property <[string]> audio-catalog-hotkeys: [];
    in-out property <[bool]> audio-catalog-loops: [];
    in-out property <int> output-index: 0;
    in-out property <int> file-output-index: 0;
    in-out property <[string]> mics: [];
    in-out property <int> mic-index: 0;
    in-out property <bool> mix-mic: false;
    in-out property <int> source-replace-index: -1;
    in-out property <int> source-add-tab: 0;
    in-out property <int> source-menu-index: -1;
    in-out property <length> source-menu-x: 0px;
    in-out property <length> source-menu-y: 0px;
    in-out property <int> source-menu-kind: 0;
    in-out property <length> source-menu-height: 96px;
    in-out property <bool> running: false;
    callback refresh();
    callback source-add-requested();
    callback process-add();
    callback add-files();
    callback mic-mix-changed(bool);
    callback source-active-toggled(int, bool);
    callback source-volume-edited(int, float);
    callback source-mute-toggled(int);
    callback source-action(int, int);
    callback source-pause(int);
    callback source-stop(int);
    callback source-output-changed(int, int);
    callback open-settings();
    callback open-library();
    callback audio-entry-add-route(int);
    callback audio-file-volume-edited(float);
    callback audio-file-output-changed(int);
    callback microphone-input-volume-edited(float);

    background: transparent;

    VerticalLayout {
        padding-left: 38px;
        padding-right: 38px;
        padding-top: 18px;
        padding-bottom: 18px;
        spacing: 13px;


        HorizontalLayout {
            height: 38px;
            spacing: 8px;
            Text {
                text: "当前音频源";
                color: Theme.text;
                font-size: 15px;
                font-weight: 600;
                vertical-alignment: TextVerticalAlignment.center;
            }
            Rectangle { horizontal-stretch: 1; background: transparent; }
            PmButton {
                label: "＋  添加音频源";
                filled: true;
                clicked => { root.source-add-requested(); }
            }
            PmButton {
                label: "刷新进程";
                enabled: !root.running;
                clicked => { root.refresh(); }
            }
        }

        VerticalLayout {
            vertical-stretch: 1;
            min-height: 0px;
            spacing: 8px;
            if root.source-titles.length == 0: Rectangle {
                height: 104px;
                width: 100%;
                border-radius: 8px;
                border-width: 1px;
                border-color: Theme.border;
                background: Theme.card;
                VerticalLayout {
                    vertical-stretch: 1;
                    alignment: LayoutAlignment.center;
                    Text {
                        text: "暂无音频源";
                        color: Theme.text;
                        font-size: 16px;
                        font-weight: 600;
                        horizontal-alignment: center;
                    }
                    Text {
                        text: "选择进程，或从音频库播放本地文件。";
                        color: Theme.text2;
                        font-size: 13px;
                        horizontal-alignment: center;
                    }
                }
            }
            ScrollView {
                width: 100%;
                vertical-stretch: 1;
                min-height: 0px;
                VerticalLayout {
                    width: 100%;
                    spacing: 8px;
                    for title[index] in root.source-titles: SourceRow {
                        kind: index < root.source-kinds.length
                            ? root.source-kinds[index]
                            : 0;
                        row-index: index;
                        icon: index < root.source-icons.length
                            ? root.source-icons[index]
                            : "";
                        icon-image: root.source-icon-images[index];
                        title: title;
                        subtitle: index < root.source-subtitles.length
                            ? root.source-subtitles[index]
                            : "";
                        detail: index < root.source-details.length
                            ? root.source-details[index]
                            : "";
                        status: index < root.source-statuses.length
                            ? root.source-statuses[index]
                            : "";
                        active: index < root.source-active.length
                            ? root.source-active[index]
                            : false;
                        muted: index < root.source-muted.length
                            ? root.source-muted[index]
                            : false;
                        paused: index < root.source-paused.length
                            ? root.source-paused[index]
                            : false;
                        actions-open: source-menu-popup.is-open
                            && root.source-menu-index == index;
                        actions-requested(x, y) => {
                            root.source-menu-index = index;
                            root.source-menu-kind = index < root.source-kinds.length
                                ? root.source-kinds[index]
                                : 0;
                            root.source-menu-height = root.source-menu-kind == 1
                                ? 188px
                                : 126px;
                            root.source-menu-x = min(
                                max(0px, x - root.absolute-position.x),
                                max(0px, root.width - 230px)
                            );
                            root.source-menu-y = min(
                                max(0px, y - root.absolute-position.y),
                                max(0px, root.height - root.source-menu-height)
                            );
                            source-menu-popup.show();
                        }
                        actions-closed => {
                            source-menu-popup.close();
                            root.source-menu-index = -1;
                        }
                        route-running: root.running;
                        mics <=> root.mics;
                        mic-selection-changed => {
                            root.mic-mix-changed(root.mix-mic);
                        }
                        mic-index <=> root.mic-index;

                        outputs <=> root.outputs;
                        initial-output-index: index < root.source-output-indices.length
                            ? root.source-output-indices[index]
                            : root.output-index;
                        volume-db: index < root.source-volume-dbs.length
                            ? root.source-volume-dbs[index]
                            : "0.0 dB";
                        peak-value: index < root.source-peak-values.length
                            ? root.source-peak-values[index]
                            : 0.0;
                        peak-db: index < root.source-peak-dbs.length
                            ? root.source-peak-dbs[index]
                            : "-∞ dB";
                        volume: index < root.source-volumes.length
                            ? root.source-volumes[index]
                            : 100;
                        active-toggled(value) => {
                            root.source-active-toggled(index, value);
                        }
                        volume-edited(value) => {
                            root.source-volume-edited(index, value);
                        }
                        mute-toggled => { root.source-mute-toggled(index); }
                        action(code) => {
                            root.source-action(index, code);
                        }
                        output-changed(target) => {
                            root.source-output-changed(index, target);
                        }
                        pause => { root.source-pause(index); }
                        stop => { root.source-stop(index); }
                    }
                }
            }
        }
    }
    source-menu-popup := PopupWindow {
        x: root.source-menu-x;
        y: root.source-menu-y;
        width: 230px;
        height: root.source-menu-height;
        close-policy: close-on-click-outside;
        SourceActionsMenu {
            width: 100%;
            height: 100%;
            kind: root.source-menu-kind;
            action(code) => {
                let index = root.source-menu-index;
                source-menu-popup.close();
                root.source-menu-index = -1;
                root.source-action(index, code);
            }
            closed => {
                source-menu-popup.close();
                root.source-menu-index = -1;
            }
        }
    }
}
