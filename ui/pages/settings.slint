//! 设置页：QQ PC 风格的左侧固定导航 + 右侧单页可滚动设置。
//! 左侧标签固定不动，点击跳转到右侧对应分组；右侧上下滚动时，左侧高亮自动跟随（scroll-spy）。

import { CheckBox, ScrollView } from "std-widgets.slint";
import { SectionTitle } from "../components/section-title.slint";
import { Theme } from "../theme.slint";
import { DiagState, HotkeyState } from "../overlays/global-overlays.slint";
import { DiagnosticsCard } from "../components/diagnostics-card.slint";
import { Card } from "../components/card.slint";
import { PmButton } from "../components/button.slint";
import { HotkeyField } from "../components/hotkey-field.slint";
import { HotkeyCard } from "../components/hotkey-card.slint";

// 设置页展示由 Rust bridge 提供的设备、快捷键、线缆和诊断状态；控件事件只通过回调提交。
export component SettingsPage inherits Rectangle {
    // 系统默认播放设备开关。
    in-out property <bool> set-default-render: false;
    // 默认通信播放设备开关。
    in-out property <bool> set-default-communications: false;
    // bridge 格式化的默认目标设备提示。
    in-out property <string> dest-hint: "";
    // 转发运行态；运行时锁定设备相关控件。
    in-out property <bool> running: false;
    // VB-CABLE 是否已安装。
    in-out property <bool> cable-installed: false;
    // 线缆安装/卸载任务是否忙碌。
    in-out property <bool> cable-busy: false;
    // 线缆状态或错误提示文本。
    in-out property <string> cable-text: "";
    // 全局快捷键当前显示文本。
    in-out property <string> hotkey-label: "";
    // 全局快捷键捕获生命周期标记。
    in-out property <bool> listening-hotkey: false;
    // 关于卡片的版本/构建说明，由 Rust 组装。
    in-out property <string> about-text: "";
    // 请求刷新设备和运行状态。
    callback refresh();
    // 请求安装或升级 VB-CABLE。
    callback install-cable();
    // 请求卸载 VB-CABLE。
    callback uninstall-cable();
    // 开始捕获全局快捷键。
    callback begin-hotkey-capture();
    // 重置全局快捷键。
    callback reset-hotkey();
    // 开始捕获指定快捷键行。
    callback begin-hotkey-row(int);
    // 重置指定快捷键行。
    callback reset-hotkey-row(int);
    // 将捕获的按键及修饰键回传 bridge。
    callback hotkey-row-captured(int, string, bool, bool, bool);
    // 切换系统默认播放设备设置。
    callback set-default-render-toggled(bool);
    // 切换默认通信播放设备设置。
    callback set-default-communications-toggled(bool);
    // 请求跳转到指定分组（0 音频设备、1 快捷键、2 虚拟线缆、3 关于、4 诊断）。
    // 用于左侧标签点击与来自侧栏/状态栏的外部跳转；只驱动右侧滚动，不改变分组显隐。
    callback goto-section(int);

    // 各分组的坐标（section-tops）与当前激活分组（active-section）在布局之后推导，
    // 见文件末尾 ScrollView 定义之后，确保 sec-audio 等命名元素已进入作用域。

    // 页面本身透明，由主窗口卡片和布局提供底色。
    background: transparent;

    // 左侧固定导航与右侧可滚动设置横向排列；左侧不参与滚动。
    HorizontalLayout {
        spacing: 0px;
        // 左侧固定导航：始终可见，点击跳转到对应分组。
        Card {
            width: 200px;
            VerticalLayout {
                spacing: 6px;
                padding: 16px;
                Text {
                    text: "设置";
                    color: Theme.text;
                    font-size: 18px;
                    font-weight: 700;
                }
                Rectangle { height: 1px; width: 100%; background: Theme.border; }
                PmButton {
                    label: "音频设备";
                    selected: root.active-section == 0;
                    flat: true;
                    clicked => { root.goto-section(0); }
                }
                PmButton {
                    label: "快捷键";
                    selected: root.active-section == 1;
                    flat: true;
                    clicked => { root.goto-section(1); }
                }
                PmButton {
                    label: "虚拟线缆";
                    selected: root.active-section == 2;
                    flat: true;
                    clicked => { root.goto-section(2); }
                }
                PmButton {
                    label: "关于";
                    selected: root.active-section == 3;
                    flat: true;
                    clicked => { root.goto-section(3); }
                }
                PmButton {
                    label: "诊断";
                    selected: root.active-section == 4;
                    flat: true;
                    clicked => { root.goto-section(4); }
                }
                  Rectangle { vertical-stretch: 1; background: transparent; }
            }
        }
        // 右侧单页可滚动设置：所有分组在同一滚动区内，无逐标签子页。
        scroll-view := ScrollView {
            // 隐藏滚动条，符合要求。
            vertical-scrollbar-policy: ScrollBarPolicy.always-off;
            horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
            content := VerticalLayout {
                padding: 24px;
                spacing: 18px;
                // 0 音频设备
                sec-audio := VerticalLayout {
                    SectionTitle { label: "音频设备"; }
                    Card {
                        CheckBox {
                            text: "设为系统默认播放设备";
                            checked <=> root.set-default-render;
                            // 系统默认播放设备开关交由宿主执行平台设置。
                            enabled: !root.running;
                            toggled => { root.set-default-render-toggled(self.checked); }
                        }
                        CheckBox {
                            text: "设为默认通信播放设备";
                            checked <=> root.set-default-communications;
                            // 默认通信播放设备开关交由宿主执行平台设置。
                            enabled: !root.running;
                            toggled => { root.set-default-communications-toggled(self.checked); }
                        }
                    }
                }
                // 1 快捷键
                sec-hotkey := VerticalLayout {
                    SectionTitle { label: "快捷键"; }
                    HotkeyCard {
                        toggle-label: root.hotkey-label;
                        toggle-listening: root.listening-hotkey;
                        enabled: !root.running;
                        begin-toggle => { root.begin-hotkey-capture(); }
                        reset-toggle => { root.reset-hotkey(); }
                        begin-row(row) => { root.begin-hotkey-row(row); }
                        reset-row(row) => { root.reset-hotkey-row(row); }
                    }
                }
                // 2 虚拟线缆
                sec-cable := VerticalLayout {
                    SectionTitle { label: "虚拟线缆"; }
                    Card {
                        VerticalLayout {
                            spacing: 10px;
                            Text {
                                text: root.cable-installed
                                    ? "VB-CABLE 已检测到"
                                    : root.cable-text;
                                color: root.cable-installed ? Theme.ok : Theme.text2;
                                font-size: 13px;
                                vertical-alignment: TextVerticalAlignment.center;
                            }
                            // 已安装时提供升级和卸载；按钮 enabled 受后台任务生命周期保护。
                            if root.cable-installed: HorizontalLayout {
                                spacing: 8px;
                                PmButton {
                                    label: root.cable-busy ? "处理中…" : "升级到最新版";
                                    // 安装/升级按钮请求后台线缆任务，忙碌态由 bridge 回写。
                                    enabled: !root.cable-busy;
                                    clicked => { root.install-cable(); }
                                }
                                PmButton {
                                    label: "卸载";
                                    danger: true;
                                    // 卸载按钮请求后台线缆任务，避免在 UI 回调内执行同步操作。
                                    enabled: !root.cable-busy;
                                    clicked => { root.uninstall-cable(); }
                                }
                                Rectangle { horizontal-stretch: 1; background: transparent; }
                            }
                            // 未安装时只显示安装入口，避免对不存在的设备发送卸载请求。
                            if !root.cable-installed: PmButton {
                                label: root.cable-busy ? "处理中…" : "安装 VB-CABLE";
                                // 未安装时只提交安装请求，不创建卸载入口。
                                enabled: !root.cable-busy;
                                clicked => { root.install-cable(); }
                            }
                        }
                    }
                }
                // 3 关于
                sec-about := VerticalLayout {
                    SectionTitle { label: "关于"; }
                    Card {
                        Text {
                            text: root.about-text;
                            color: Theme.text2;
                            font-size: 12px;
                            wrap: word-wrap;
                        }
                    }
                }
                // 4 诊断
                sec-diag := VerticalLayout {
                    SectionTitle { label: "诊断"; }
                    DiagnosticsCard { }
                }
                // 底部留白，保证最后一节也能滚到接近顶部。
                Rectangle { height: 24px; background: transparent; }
            }
        }
    }

    // 各分组在滚动内容中的内容坐标（相对内容顶部的 y），用于点击跳转与 scroll-spy。
    // 声明于布局之后，sec-audio 等命名元素已进入作用域；用裸名而非 root.sec-*.y 访问。
    // 裸名 sec-audio.y 对应的是其相对父级 content 的坐标，与 scroll-view.content-y 同坐标系。
    // 分组顺序：0 音频设备、1 快捷键、2 虚拟线缆、3 关于、4 诊断。
    property <[length]> section-tops: [
        sec-audio.y,
        sec-hotkey.y,
        sec-cable.y,
        sec-about.y,
        sec-diag.y
    ];
    // ScrollView 的 content-y 是「视口相对内容的偏移」，向下滚动时为负值，
    // 合法区间为 [-(content-height - visible-height), 0]（见 i-slint-core flickable.rs 的
    // in-bounds 判定）。这里取反换算成习惯的正向滚动距离，供高亮推导使用。
    property <length> scroll-offset: -scroll-view.content-y;
    // 当前激活分组：根据正向滚动距离推导，滚动时自动更新左侧高亮。
    // 使用纯嵌套三元表达式（无赋值），在纯属性上下文中合法。
    property <int> active-section:
        // 滚到最底部时，即使末节无法顶到顶部也强制选中最后一节。
        (root.scroll-offset + scroll-view.visible-height >= scroll-view.content-height - 2px) ? 4 :
        (root.scroll-offset + 4px >= root.section-tops[4]) ? 4 :
        (root.scroll-offset + 4px >= root.section-tops[3]) ? 3 :
        (root.scroll-offset + 4px >= root.section-tops[2]) ? 2 :
        (root.scroll-offset + 4px >= root.section-tops[1]) ? 1 : 0;

    // 外部或左侧导航的跳转目标：值变化时驱动右侧滚动到对应分组。
    in-out property <int> target-section: 0;
    changed target-section => {
        root.goto-section(root.target-section);
    }

    // 点击左侧标签或外部跳转：将对应分组顶到可视区顶部。
    // content-y 为负向偏移，故写入 -目标距离；目标已在下方夹取到可滚动上限。
    goto-section(sec) => {
        let i = min(max(sec, 0), 4);
        // 可滚动的最大距离。末几节高度不足时顶不到视口顶部，故把目标夹到该上限：
        // content-y 是双向绑定到滚动条的，Flickable 对带绑定的 content-y 不做自动夹取，
        // 越界会让内容滚出空白区域，所以这里自行限制。
        let max-scroll = max(scroll-view.content-height - scroll-view.visible-height, 0px);
        scroll-view.content-y = -min(root.section-tops[i], max-scroll);
    }
}
