//! 音频库：分类导航、本地文件表、文件详情和独立播放控制。

import { LineEdit } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { Card } from "../components/card.slint";
import { PmButton } from "../components/button.slint";
import { CategorySidebar } from "../components/category-sidebar.slint";
import { AudioList } from "../components/audio-list.slint";
import { AudioDetail } from "../components/audio-detail.slint";
import { AudioTransport } from "../components/audio-transport.slint";

export component PlayerPage inherits Rectangle {
    in-out property <[string]> categories: ["全部", "未分类"];
    in-out property <[int]> category-counts: [];
    in-out property <[string]> audio-hotkeys: [];
    in-out property <int> category-index: 0;
    in-out property <int> category-drop-target: -1;
    in-out property <int> category-drop-position: -1;
    in-out property <[string]> entries: [];
    in-out property <[string]> entry-durations: [];
    in-out property <[string]> entry-metadata: [];
    in-out property <[string]> entry-categories: [];
    in-out property <[string]> entry-statuses: [];
    in-out property <[string]> entry-paths: [];
    in-out property <[string]> entry-sizes: [];
    in-out property <[string]> entry-hotkeys: [];
    in-out property <string> search: "";
    in-out property <int> entry-index: -1;
    in-out property <bool> listening-entry-hotkey: false;
    in-out property <int> entry-category-index: 0;
    in-out property <int> page: 0;
    in-out property <int> page-count: 1;
    in-out property <int> total-count: 0;
    in-out property <bool> sort-ascending: true;
    in-out property <int> playing-entry-index: -1;
    in-out property <float> progress: 0;
    in-out property <bool> seeking-progress: false;
    in-out property <string> current-name: "";
    in-out property <string> current-position: "";
    in-out property <float> duration-seconds: 0;
    in-out property <bool> paused: false;
    in-out property <bool> preview-enabled: false;
    in-out property <float> monitor-volume: 50;
    in-out property <bool> loop: false;
    in-out property <bool> playing: false;
    in-out property <bool> route-running: false;
    in-out property <[string]> devices: [];
    in-out property <int> file-output-index: 0;
    in-out property <bool> category-menu-open: false;
    in-out property <bool> entry-menu-open: false;
    in-out property <length> category-menu-x: 0px;
    in-out property <length> category-menu-y: 0px;
    in-out property <length> entry-menu-x: 0px;
    in-out property <length> entry-menu-y: 0px;
    in property <string> hotkey-label: "";

    callback category-changed(int);
    callback category-context(int);
    pure callback category-to-transfer(int) -> data-transfer;
    callback category-can-drop(data-transfer, int, int) -> bool;
    callback category-drop(data-transfer, int, int);
    callback entry-context(int);
    callback entry-selected(int);
    callback entry-double-clicked(int);
    callback entry-play(int);
    callback progress-seek(float);
    callback add-files();
    callback stop();
    callback play-action(int);
    callback pause-toggle();
    callback previous();
    callback next();
    callback preview-enabled-toggled(bool);
    callback preview-volume-edited(float);
    callback file-output-changed(int);
    callback search-edited(string);
    callback sort-toggled();
    callback page-changed(int);
    callback entry-category-changed(int);
    callback loop-changed(bool);
    callback entry-hotkey-bind();
    callback hotkey-settings();
    background: transparent;

    VerticalLayout {
        padding-left: 22px;
        padding-right: 22px;
        padding-top: 16px;
        padding-bottom: 14px;
        spacing: 12px;
        HorizontalLayout {
            vertical-stretch: 1;
            min-height: 0px;
            spacing: 12px;
            CategorySidebar {
                width: 228px;
                categories <=> root.categories;
                category-counts <=> root.category-counts;
                audio-hotkeys <=> root.audio-hotkeys;
                category-index <=> root.category-index;
                category-drop-target <=> root.category-drop-target;
                category-drop-position <=> root.category-drop-position;
                category-menu-open <=> root.category-menu-open;
                entry-menu-open <=> root.entry-menu-open;
                category-menu-x <=> root.category-menu-x;
                category-menu-y <=> root.category-menu-y;
                hotkey-label: root.hotkey-label;
                category-changed(i) => { root.category-changed(i); }
                category-context(i) => { root.category-context(i); }
                category-to-transfer(i) => { root.category-to-transfer(i); }
                category-can-drop(data, target, position) => {
                    root.category-can-drop(data, target, position);
                }
                category-drop(data, target, position) => {
                    root.category-drop(data, target, position);
                }
                hotkey-settings => { root.hotkey-settings(); }
            }
            Card {
                horizontal-stretch: 1;
                vertical-stretch: 1;
                min-width: 0px;
                min-height: 0px;
                HorizontalLayout {
                    height: 44px;
                    spacing: 8px;
                    Text {
                        text: "\u{E721}";
                        font-family: "Segoe MDL2 Assets";
                        color: Theme.text2;
                        width: 20px;
                        vertical-alignment: TextVerticalAlignment.center;
                    }
                    LineEdit {
                        horizontal-stretch: 1;
                        text <=> root.search;
                        placeholder-text: "搜索音频文件…";
                        edited(text) => { root.search-edited(text); }
                    }
                    PmButton {
                        label: "添加音频";
                        filled: true;
                        clicked => { root.add-files(); }
                    }
                    PmButton {
                        label: root.sort-ascending ? "↑ 名称" : "↓ 名称";
                        clicked => { root.sort-toggled(); }
                    }
                }
                Rectangle {
                    width: 100%;
                    height: 1px;
                    background: Theme.border;
                }
                AudioList {
                    vertical-stretch: 1;
                    min-height: 0px;
                    entries <=> root.entries;
                    entry-durations <=> root.entry-durations;
                    entry-hotkeys <=> root.entry-hotkeys;
                    entry-categories <=> root.entry-categories;
                    entry-statuses <=> root.entry-statuses;
                    entry-index <=> root.entry-index;
                    playing <=> root.playing;
                    playing-entry-index <=> root.playing-entry-index;
                    entry-menu-open <=> root.entry-menu-open;
                    category-menu-open <=> root.category-menu-open;
                    entry-menu-x <=> root.entry-menu-x;
                    entry-menu-y <=> root.entry-menu-y;
                    entry-context(index) => { root.entry-context(index); }
                    entry-selected(index) => { root.entry-selected(index); }
                    entry-double-clicked(index) => {
                        root.entry-double-clicked(index);
                    }
                    entry-play(index) => { root.entry-play(index); }
                }
                Rectangle {
                    width: 100%;
                    height: 1px;
                    background: Theme.border;
                }
                HorizontalLayout {
                    height: 36px;
                    Text {
                        text: "共 \{root.total-count} 个音频文件";
                        horizontal-stretch: 1;
                        color: Theme.text2;
                        font-size: 11px;
                        vertical-alignment: TextVerticalAlignment.center;
                    }
                    PmButton {
                        label: "‹";
                        button-width: 34px;
                        enabled: root.page > 0;
                        clicked => { root.page-changed(root.page - 1); }
                    }
                    Text {
                        text: "\{root.page + 1} / \{root.page-count}";
                        width: 56px;
                        color: Theme.accent;
                        horizontal-alignment: center;
                        vertical-alignment: TextVerticalAlignment.center;
                    }
                    PmButton {
                        label: "›";
                        button-width: 34px;
                        enabled: root.page + 1 < root.page-count;
                        clicked => { root.page-changed(root.page + 1); }
                    }
                    Text {
                        text: "每页 20 条";
                        width: 70px;
                        color: Theme.text2;
                        font-size: 11px;
                        horizontal-alignment: right;
                        vertical-alignment: TextVerticalAlignment.center;
                    }
                }
            }
            AudioDetail {
                vertical-stretch: 1;
                entries <=> root.entries;
                metadata <=> root.entry-metadata;
                categories <=> root.entry-categories;
                durations <=> root.entry-durations;
                sizes <=> root.entry-sizes;
                paths <=> root.entry-paths;
                category-options <=> root.categories;
                devices <=> root.devices;
                route-running <=> root.route-running;
                hotkey: root.entry-index >= 0
                    && root.entry-index < root.entry-hotkeys.length
                    ? root.entry-hotkeys[root.entry-index]
                    : "";
                listening-hotkey: root.listening-entry-hotkey;
                entry-index <=> root.entry-index;
                category-index <=> root.entry-category-index;
                output-index <=> root.file-output-index;
                monitor-volume <=> root.monitor-volume;
                preview-enabled <=> root.preview-enabled;
                loop <=> root.loop;
                play => { root.play-action(0); }
                preview => { root.play-action(1); }
                context => { root.entry-context(root.entry-index); }
                output-changed(value) => { root.file-output-changed(value); }
                category-changed(value) => {
                    root.entry-category-changed(value);
                }
                monitor-volume-edited(value) => {
                    root.preview-volume-edited(value);
                }
                preview-toggled(value) => {
                    root.preview-enabled-toggled(value);
                }
                loop-toggled(value) => { root.loop-changed(value); }
            }
        }
        if root.playing || root.paused: AudioTransport {
            entry-index: root.entry-index;
            entry-count: root.entries.length;
            playing: root.playing;
            paused: root.paused;
            progress <=> root.progress;
            seeking-progress <=> root.seeking-progress;
            current-name: root.current-name;
            current-position: root.current-position;
            duration-seconds: root.duration-seconds;
            previous => { root.previous(); }
            pause-toggle => { root.pause-toggle(); }
            stop => { root.stop(); }
            next => { root.next(); }
            progress-seek(value) => { root.progress-seek(value); }
        }
    }
}
