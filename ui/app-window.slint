//! 主窗口：Windows 桌面顶栏、三页内容、常驻状态栏和全局右键菜单。

import { Theme } from "theme.slint";
import { Palette } from "std-widgets.slint";
import { AppFocusScope } from "components/app-focus-scope.slint";
import { SidebarNav } from "components/sidebar-nav.slint";
import { AppHeader } from "components/app-header.slint";
import { StatusBar } from "components/status-bar.slint";
import { ContextMenuHost } from "overlays/context-menu-host.slint";
import { DiagState, GlobalOverlays, HotkeyState } from "overlays/global-overlays.slint";
import { AddSourceWindow, AudioEditWindow } from "windows.slint";
import { PageHost } from "components/page-host.slint";
export { AddSourceWindow, AudioEditWindow, DiagState, HotkeyState, Palette, Theme }

// 主窗口持有 Rust bridge 的权威 UI 镜像，并把页面事件汇聚回应用控制器。
export component MainWindow inherits Window {
    // Windows 标题栏/任务栏图标使用仓库资源中的应用图标。
    icon: @image-url("../resources/icon.ico");
    // 窗口标题由桌面宿主显示，不参与页面状态。
    title: "Miccat";
    // 最小宽度，保证三栏路由布局仍有可用操作区。
    min-width: 900px;
    // 最小高度，保证状态栏和页面内容不重叠。
    min-height: 600px;
    // 首次创建窗口的建议宽度。
    preferred-width: 1280px;
    // 首次创建窗口的建议高度。
    preferred-height: 800px;
    // 窗口底色保持不透明；淡粉图片绘制其上，避免初始加载时透出其它窗口。
    background: Theme.page-bg;
    // 尺寸不匹配时使用原图与页面遮罩；后台合成对应尺寸后再切换。
    property <bool> pink-composite-fits: Theme.pink-mode
        && Theme.pink-composite-width == Math.round(root.width / 1px)
        && Theme.pink-composite-height == Math.round(root.height / 1px);
    if Theme.pink-mode: Image {
        source: root.pink-composite-fits
            ? Theme.pink-composite-image
            : Theme.pink-background-image;
        width: 100%;
        height: 100%;
        image-fit: cover;
    }
    // Windows 默认字体，确保图标字体和正文排版稳定。
    default-font-family: "Segoe UI";
    // 全局字号，子组件可按信息层级覆盖。
    default-font-size: 14px;
    // 标准 CheckBox/LineEdit 等控件的全局调色板同步应用当前预设。
    init => {
        Palette.color-scheme = ColorScheme.light;
    }
    // 窗口尺寸变化时重新生成背景，不在 UI 线程重采样图片。
    changed width => { root.theme-size-changed(); }
    changed height => { root.theme-size-changed(); }

    // 当前页索引：0 路由、1 音频库、2 设置。
    in-out property <int> page: 0;
    // 顶栏显示的 Cargo package 版本。
    in-out property <string> app-version: "";
    // 引擎状态摘要文本。
    in-out property <string> status-text: "未运行";
    // 0 普通、1 成功、2 警告、3 错误，供状态栏选择指示色。
    in-out property <int> status-kind: 0;
    // 最近一次用户错误短句由 bridge 保留；详情入口在问题中心。
    in-out property <string> error-text: "";
    // 转发引擎是否运行，驱动顶栏按钮和设备控件禁用条件。
    in-out property <bool> running: false;
    // 可添加/已路由进程名称数组。
    in-out property <[string]> processes: [];
    // 与 processes 对齐的 PID 文本，用于重复进程校验。
    in-out property <[string]> process-pids: [];
    // 进程图像资源数组。
    in-out property <[image]> process-icon-images: [];
    // 添加窗口当前进程选择下标。
    in-out property <int> process-index: 0;
    // 是否把麦克风加入混音。
    in-out property <bool> mix-mic: false;
    // 源类型数组，0 进程、1 文件、2 麦克风。
    in-out property <[int]> source-kinds: [];
    // 源字体图标数组。
    in-out property <[string]> source-icons: [];
    // 源图像数组。
    in-out property <[image]> source-icon-images: [];
    // 源标题数组，决定路由卡片数量。
    in-out property <[string]> source-titles: [];
    // 源副标题数组。
    in-out property <[string]> source-subtitles: [];
    // 源详情数组。
    in-out property <[string]> source-details: [];
    // 源播放状态数组。
    in-out property <[string]> source-statuses: [];
    // 每槽位启用状态。
    in-out property <[bool]> source-active: [];
    // 每槽位音量百分比。
    in-out property <[float]> source-volumes: [];
    // 每槽位音量 dB 文本。
    in-out property <[string]> source-volume-dbs: [];
    // 每槽位峰值数值。
    in-out property <[float]> source-peak-values: [];
    // 每槽位峰值 dB 文本。
    in-out property <[string]> source-peak-dbs: [];
    // 扁平源电平历史采样。
    in-out property <[float]> source-meter-history: [];
    // 每槽位峰值 dB 文本数组。
    in-out property <[string]> source-meter-dbs: [];
    // 状态栏源电平弹层可见状态。
    in-out property <bool> source-meter-open: false;
    // 每槽位静音状态。
    in-out property <[bool]> source-muted: [];
    // 每槽位文件暂停状态。
    in-out property <[bool]> source-paused: [];
    // 路由卡片行与设备下标两级勾选模型。
    in-out property <[[bool]]> source-output-selections: [];
    // 每张卡片的所选输出设备友好名。
    in-out property <[string]> source-output-labels: [];
    // 每槽位文件播放模式。
    in-out property <[int]> source-play-modes: [];
    // 每槽位文件播放进度。
    in-out property <[float]> source-progresses: [];
    // 每槽位文件当前时间文本。
    in-out property <[string]> source-position-texts: [];
    // 每槽位文件总时长文本。
    in-out property <[string]> source-duration-texts: [];
    // 文件源默认输出设备下标。
    in-out property <int> file-output-index: 0;
    // 添加文件源窗口待提交的设备勾选，仅承载一次确认事件，不镜像配置。
    in-out property <[bool]> pending-file-output-selected: [];
    // 文件源音量百分比。
    in-out property <float> audio-file-volume: 100;
    // 麦克风输入音量百分比。
    in-out property <float> microphone-input-volume: 100;
    // 添加源窗口页签索引。
    in-out property <int> source-add-tab: 0;
    // 替换目标槽位，-1 表示添加新槽位。
    in-out property <int> source-replace-index: -1;
    // 音频库分类名称数组。
    in-out property <[string]> audio-categories: ["全部", "未分类"];
    // 当前音频分类下标。
    in-out property <int> audio-category-index: 0;
    // 分类条目数量数组。
    in-out property <[int]> audio-category-counts: [];
    // 分类树深度数组。
    in-out property <[int]> audio-category-depths: [];
    // 分类图像数组。
    in-out property <[image]> audio-category-icon-images: [];
    // 分类字形数组。
    in-out property <[string]> audio-category-icon-glyphs: [];
    // 编辑器自定义图标图像。
    in-out property <image> audio-edit-custom-icon-image;
    // 编辑窗口可见状态。
    in-out property <bool> audio-edit-dialog-open: false;
    // true 编辑分类，false 编辑音频。
    in-out property <bool> audio-edit-category-mode: false;
    // 编辑对象名称草稿。
    in-out property <string> audio-edit-name: "";
    // 编辑图标索引。
    in-out property <int> audio-edit-icon-index: 0;
    // 自定义图标路径。
    in-out property <string> audio-edit-custom-icon-path: "";
    // 音频库目录条目名称数组。
    in-out property <[string]> audio-library-catalog: [];
    // 音频库条目元数据数组。
    in-out property <[string]> audio-library-metadata: [];
    // 音频库条目时长数组。
    in-out property <[string]> audio-library-durations: [];
    // 音频库条目分类数组。
    in-out property <[string]> audio-library-categories: [];
    // 音频库条目快捷键数组。
    in-out property <[string]> audio-library-hotkeys: [];
    // 音频库条目循环设置数组。
    in-out property <[bool]> audio-library-loops: [];
    // 音频库条目大小数组。
    in-out property <[string]> audio-library-sizes: [];
    // 当前分类编辑名称。
    in-out property <string> audio-category-edit-name: "";
    // 当前分页条目名称数组。
    in-out property <[string]> audio-entries: [];
    // 当前分页条目时长数组。
    in-out property <[string]> audio-entry-durations: [];
    // 当前分页条目图像数组。
    in-out property <[image]> audio-entry-icon-images: [];
    // 当前分页条目字形数组。
    in-out property <[string]> audio-entry-icon-glyphs: [];
    // 当前分页条目元数据数组。
    in-out property <[string]> audio-entry-metadata: [];
    // 当前分页条目路径数组。
    in-out property <[string]> audio-entry-paths: [];
    // 当前分页条目大小数组。
    in-out property <[string]> audio-entry-sizes: [];
    // 当前分页条目快捷键数组。
    in-out property <[string]> audio-entry-hotkeys: [];
    // 当前音频条目下标。
    in-out property <int> audio-entry-index: -1;
    // 音频搜索草稿。
    in-out property <string> audio-search: "";
    // 独立播放器当前条目下标。
    in-out property <int> player-entry-index: -1;
    // 音频库分页页码。
    in-out property <int> audio-page: 0;
    // 音频库总页数。
    in-out property <int> audio-page-count: 1;
    // 音频库筛选后的总条目数。
    in-out property <int> audio-total-count: 0;
    // 名称/时长排序列与方向均按当前筛选结果刷新。
    in-out property <int> audio-sort-column-index: 0;
    in-out property <bool> audio-sort-ascending: true;
    // 设置页当前分组索引。
    in-out property <int> settings-section-index: 0;
    // 播放器循环开关。
    in-out property <bool> player-loop: false;
    // 播放进度比例。
    in-out property <float> audio-progress: 0;
    // 用户拖动进度期间的保护标记。
    in-out property <bool> audio-seeking-progress: false;
    // 当前播放名称。
    in-out property <string> audio-current-name: "";
    // 当前播放位置文本。
    in-out property <string> audio-current-position: "";
    // 当前音频时长，单位秒。
    in-out property <float> audio-duration-seconds: 0;
    // 音频快捷键捕获态。
    in-out property <bool> audio-hotkey-listening: false;
    // 播放器播放态。
    in-out property <bool> player-playing: false;
    // 播放器暂停态。
    in-out property <bool> player-paused: false;
    // 分类菜单可见态。
    in-out property <bool> audio-category-menu-open: false;
    // 条目菜单可见态。
    in-out property <bool> audio-entry-menu-open: false;
    // 分类菜单 X 坐标。
    in-out property <length> audio-category-menu-x: 0px;
    // 分类菜单 Y 坐标。
    in-out property <length> audio-category-menu-y: 0px;
    // 条目菜单 X 坐标。
    in-out property <length> audio-entry-menu-x: 0px;
    // 条目菜单 Y 坐标。
    in-out property <length> audio-entry-menu-y: 0px;
    // 输出设备名称数组。
    in-out property <[string]> devices: [];
    // 默认输出设备下标。
    in-out property <int> device-index: 0;
    // 各设备选中状态数组。
    in-out property <[bool]> device-selected: [];
    // 是否显示全部输出设备。
    in-out property <bool> all-devices: false;
    // 麦克风名称数组。
    in-out property <[string]> mics: [];
    // 当前麦克风下标。
    in-out property <int> mic-index: 0;
    // 是否允许设置默认麦克风。
    in-out property <bool> show-set-default-mic: false;
    // 默认麦克风开关。
    in-out property <bool> set-default-mic: false;
    // 系统默认播放设备开关。
    in-out property <bool> set-default-render: false;
    // 默认通信播放设备开关。
    in-out property <bool> set-default-communications: false;
    // 默认输出目标提示。
    in-out property <string> dest-hint: "";
    // 预览功能开关。
    in-out property <bool> preview-enabled: false;
    // 预览音量百分比。
    in-out property <float> preview-volume: 50;
    // VB-CABLE 安装态。
    in-out property <bool> cable-installed: false;
    // VB-CABLE 后台任务忙碌态。
    in-out property <bool> cable-busy: false;
    // VB-CABLE 状态文本。
    in-out property <string> cable-text: "";
    // 全局快捷键显示文本。
    in-out property <string> hotkey-label: "";
    // 全局快捷键捕获态。
    in-out property <bool> listening-hotkey: false;
    // 总线音量百分比。
    in-out property <float> master-volume: 100;
    // 总线音量 dB 文本。
    in-out property <string> master-volume-db: "0.0 dB";
    // 用户正在拖动总音量滑块时保持 PointerPopup 打开。
    in-out property <bool> volume-adjusting: false;
    // PointerPopup 的屏幕位置换算到主窗口逻辑坐标。
    in-out property <length> volume-pointer-x: 0px;
    in-out property <length> volume-pointer-y: 0px;
    // Rust 已提供有效的鼠标坐标后才显示 popup，避免首帧闪到窗口原点。
    in-out property <bool> volume-pointer-valid: false;
    // 总线峰值数值。
    in-out property <float> master-peak-value: 0;
    // 总线峰值 dB 文本。
    in-out property <string> master-peak-db: "-∞ dB";
    // 总线电平历史采样。
    in-out property <[float]> master-meter-history: [];
    // 关于文本，由 Rust 组装版本和环境信息。
    in-out property <string> about-text: "";

    // 启动或停止转发引擎。
    callback start-stop();
    // 重新枚举进程、设备并清理失效源卡片。
    callback refresh();
    // 打开添加源窗口。
    callback source-add-requested();
    // 用户从主题悬浮菜单选择预设。
    callback theme-selected(int);
    // 淡粉主题图片完成后台获取后注入窗口与两个独立窗口。
    callback theme-image-ready(image);
    // 背景预合成仅由已下载图片与当前窗口尺寸派生。
    callback theme-composite-ready(image, int, int);
    // 主窗口逻辑尺寸发生变化时异步重建一次背景。
    callback theme-size-changed();
    // 绑定音频条目快捷键。
    callback audio-entry-hotkey-bind();
    // 编辑总线音量，参数为百分比。
    callback master-volume-edited(float);
    // 音频库分页变更。
    callback audio-page-changed(int);
    // 选中音频库条目。
    callback audio-entry-selected(int);
    // 点击名称或时长表头切换对应排序列与方向。
    callback audio-sort-column(int);
    // 请求添加进程源。
    callback process-add();
    // 搜索音频库条目。
    callback audio-search-edited(string);
    // 指定路由卡片与设备下标的多选变化。
    callback source-output-toggled(int, int, bool);
    // 修改文件源输出设备。
    callback file-output-changed(int);
    // 切换指定源启用状态。
    callback source-active-toggled(int, bool);
    // 修改指定源音量，单位百分比。
    callback source-volume-edited(int, float);
    // 切换指定源静音。
    callback source-mute-toggled(int);
    // 执行指定源菜单动作码。
    callback source-action(int, int);
    // 暂停指定文件源。
    callback source-pause(int);
    // 停止指定文件源。
    callback source-stop(int);
    // 播放指定文件源的上一首。
    callback source-previous(int);
    // 播放指定文件源的下一首。
    callback source-next-track(int);
    // 循环切换指定文件源播放模式。
    callback source-play-mode-cycled(int);
    // 路由文件槽进度定位；参数为混合源行号与 0..=1 比例。
    callback source-progress-seek(int, float);
    // 切换麦克风混音。
    callback mic-mix-changed(bool);
    // 切换全部输出设备显示。
    callback all-devices-toggled(bool);
    // 切换单个设备选择。
    callback device-toggled(int, bool);
    // 切换默认麦克风设置。
    callback set-default-mic-toggled(bool);
    // 切换默认播放设备设置。
    callback set-default-render-toggled(bool);
    // 切换默认通信播放设备设置。
    callback set-default-communications-toggled(bool);
    // 切换预览开关。
    callback preview-enabled-toggled(bool);
    // 编辑预览音量。
    callback preview-volume-edited(float);
    // 安装线缆。
    callback install-cable();
    // 卸载线缆。
    callback uninstall-cable();
    // 开始全局快捷键捕获。
    callback begin-hotkey-capture();
    // 重置全局快捷键。
    callback reset-hotkey();
    // 捕获全局快捷键结果。
    callback hotkey-captured(string, bool, bool, bool);
    // 捕获音频快捷键。
    callback audio-hotkey-captured(string);
    // 捕获音频快捷键组合。
    callback audio-hotkey-binding-captured(string, bool, bool, bool);
    // 捕获指定快捷键行组合。
    callback hotkey-row-captured(int, string, bool, bool, bool);
    // 开始指定行快捷键捕获。
    callback begin-hotkey-row(int);
    // 重置指定行快捷键。
    callback reset-hotkey-row(int);
    // 全局音频快捷键触发。
    callback audio-hotkey-pressed(string);
    // 更新音频快捷键下标。
    callback audio-hotkey-index(int);
    // 添加音频文件到指定路由下标。
    callback audio-entry-add-route-index(int);
    // 编辑文件源音量。
    callback audio-file-volume-edited(float);
    // 编辑文件源输出设备。
    callback audio-file-output-changed(int);
    // 编辑麦克风输入音量。
    callback microphone-input-volume-edited(float);
    // 导入音频文件。
    callback add-audio-files();
    // 请求编辑分类。
    callback audio-category-edit-requested();
    // 请求编辑音频条目。
    callback audio-entry-edit-requested();
    // 分类选择变更。
    callback audio-category-changed(int);
    // 提交编辑表单。
    callback audio-edit-accepted(string, int, string);
    // 取消编辑。
    callback audio-edit-cancelled();
    // 请求自定义图标。
    callback audio-edit-custom-icon-requested();
    // 打开分类上下文菜单。
    callback audio-category-context(int);
    // 新建分类。
    callback audio-category-new();
    // 重命名分类。
    callback category-rename();
    // 删除分类。
    callback category-delete();
    // 生成分类拖放数据，返回给 Slint 拖放系统。
    pure callback audio-category-to-transfer(int) -> data-transfer;
    // 校验分类能否接收拖放数据。
    callback audio-category-can-drop(data-transfer, int, int) -> bool;
    // 提交分类拖放。
    callback audio-category-drop(data-transfer, int, int);
    // 从可见音频行生成拖放数据；落到分类时由 Rust 持久化实际条目。
    pure callback audio-entry-to-transfer(int) -> data-transfer;
    callback audio-entry-category-can-drop(data-transfer, int) -> bool;
    callback audio-entry-category-drop(data-transfer, int);
    // 双击音频条目。
    callback audio-entry-double-clicked(int);
    // 打开音频条目上下文菜单。
    callback audio-entry-context(int);
    // 播放音频条目。
    callback audio-entry-play(int);
    // 把当前音频条目加入路由。
    callback audio-entry-add-route();
    // 清除当前条目快捷键。
    callback audio-entry-hotkey-clear();
    // 移除音频条目。
    callback audio-entry-remove();
    // 请求资源管理器重命名。
    callback audio-entry-explorer-rename();
    // 请求编辑音频文件元数据。
    callback audio-entry-edit-file();
    // 拖动音频进度。
    callback audio-progress-seek(float);
    // 停止独立播放器。
    callback audio-stop();
    // 切换播放器暂停。
    callback player-pause-toggle();
    // 播放上一条。
    callback player-previous();
    // 播放下一条。
    callback player-next();

    // 焦点作用域统一处理全局快捷键、音频快捷键和菜单关闭，避免页面重复监听。
    AppFocusScope {
    // 快捷键捕获态来自 bridge；作用域只在捕获期间接管按键。
        listening-hotkey: root.listening-hotkey;
        listening-audio-hotkey: root.audio-hotkey-listening;
        category-menu-open: root.audio-category-menu-open;
        // 事件先转回 root，再由 Rust 控制器校验和持久化。
        entry-menu-open: root.audio-entry-menu-open;
        hotkey-captured(text, control, shift, alt) => {
            root.hotkey-captured(text, control, shift, alt);
        }
        audio-hotkey-captured(text) => { root.audio-hotkey-captured(text); }
        audio-hotkey-pressed(text) => { root.audio-hotkey-pressed(text); }
        close-menus => {
            root.audio-category-menu-open = false;
            root.audio-entry-menu-open = false;
            // Escape/外部点击关闭菜单时，仅清理菜单可见状态，不修改条目数据。
        }
        // 顶栏、内容行和底栏纵向排列，侧栏仅属于中间页面行。
        // 顶栏和底栏占据完整窗口宽度；中间内容行才包含导航与页面。
        VerticalLayout {
            width: 100%;
            height: 100%;
            AppHeader {
                width: 100%;
                page: root.page;
                running: root.running;
                cable-busy: root.cable-busy;
                theme-index: Theme.theme-index;
                version: root.app-version;
                start-stop => { root.start-stop(); }
                source-add-requested => { root.source-add-requested(); }
                theme-selected(index) => { root.theme-selected(index); }
                refresh => { root.refresh(); }
            }
            // 页面行独占两栏之间的剩余高度，侧栏不覆盖顶栏或底栏。
            HorizontalLayout {
                vertical-stretch: 1;
                min-height: 0px;
                SidebarNav {
                    current <=> root.page;
                    picked(i) => {
                        root.page = i;
                        root.audio-category-menu-open = false;
                        root.audio-entry-menu-open = false;
                    }
                }
            // 页面内容容器占据中间行剩余高度，使 PageHost 与底栏保持稳定层级。
            Rectangle {
                horizontal-stretch: 1;
                min-width: 0px;
                vertical-stretch: 1;
            // PageHost 按当前页索引装配路由、音频库或设置页，未选中的页面不处理输入。
            PageHost {
                width: 100%;
                vertical-stretch: 1;
                min-height: 0px;
                pink-background-precomposed: root.pink-composite-fits;
                // 页面索引由顶栏和 Rust bridge 共同驱动，决定当前可见页面。
                page: root.page;
                processes <=> root.processes;
                process-pids <=> root.process-pids;
                process-icon-images <=> root.process-icon-images;
                // PageHost 的数组属性通过双向绑定保持与 root 的槽位索引一致。
                process-index <=> root.process-index;
                source-kinds <=> root.source-kinds;
                source-icons <=> root.source-icons;
                source-icon-images <=> root.source-icon-images;
                source-titles <=> root.source-titles;
                source-subtitles <=> root.source-subtitles;
                source-details <=> root.source-details;
                source-statuses <=> root.source-statuses;
                source-active <=> root.source-active;
                source-volumes <=> root.source-volumes;
                source-peak-values <=> root.source-peak-values;
                source-peak-dbs <=> root.source-peak-dbs;
                source-volume-dbs <=> root.source-volume-dbs;
                source-muted <=> root.source-muted;
                category-depths <=> root.audio-category-depths;
                category-icon-images <=> root.audio-category-icon-images;
                category-icon-glyphs <=> root.audio-category-icon-glyphs;
                edit-dialog-open <=> root.audio-edit-dialog-open;
                edit-category-mode <=> root.audio-edit-category-mode;
                edit-name <=> root.audio-edit-name;
                edit-icon-index <=> root.audio-edit-icon-index;
                edit-custom-icon-image <=> root.audio-edit-custom-icon-image;
                edit-custom-icon-path <=> root.audio-edit-custom-icon-path;
                source-output-selections <=> root.source-output-selections;
                source-output-labels <=> root.source-output-labels;
                source-play-modes <=> root.source-play-modes;
                source-progresses <=> root.source-progresses;
                source-position-texts <=> root.source-position-texts;
                source-duration-texts <=> root.source-duration-texts;
                outputs <=> root.devices;
                output-index <=> root.device-index;
                mics <=> root.mics;
                mic-index <=> root.mic-index;
                mix-mic <=> root.mix-mic;
                source-replace-index <=> root.source-replace-index;
                source-add-tab <=> root.source-add-tab;
                audio-catalog-entries <=> root.audio-library-catalog;
                audio-catalog-metadata <=> root.audio-library-metadata;
                audio-catalog-durations <=> root.audio-library-durations;
                audio-catalog-categories <=> root.audio-library-categories;
                audio-catalog-hotkeys <=> root.audio-library-hotkeys;
                audio-catalog-loops <=> root.audio-library-loops;
                audio-catalog-sizes <=> root.audio-library-sizes;
                audio-file-volume <=> root.audio-file-volume;
                microphone-input-volume <=> root.microphone-input-volume;
                output-options <=> root.devices;
                file-output-index <=> root.file-output-index;
                running <=> root.running;
                categories <=> root.audio-categories;
                category-counts <=> root.audio-category-counts;
                category-index <=> root.audio-category-index;
                entries <=> root.audio-entries;
                entry-durations <=> root.audio-entry-durations;
                entry-icon-images <=> root.audio-entry-icon-images;
                entry-icon-glyphs <=> root.audio-entry-icon-glyphs;
                entry-paths <=> root.audio-entry-paths;
                entry-sizes <=> root.audio-entry-sizes;
                entry-hotkeys <=> root.audio-entry-hotkeys;
                search <=> root.audio-search;
                entry-index <=> root.audio-entry-index;
                listening-entry-hotkey <=> root.audio-hotkey-listening;
                page-index <=> root.audio-page;
                page-count <=> root.audio-page-count;
                total-count <=> root.audio-total-count;
                sort-ascending <=> root.audio-sort-ascending;
                sort-column-index <=> root.audio-sort-column-index;
                playing-entry-index <=> root.player-entry-index;
                progress <=> root.audio-progress;
                seeking-progress <=> root.audio-seeking-progress;
                current-position <=> root.audio-current-position;
                duration-seconds <=> root.audio-duration-seconds;
                playing <=> root.player-playing;
                paused <=> root.player-paused;
                category-menu-open <=> root.audio-category-menu-open;
                entry-menu-open <=> root.audio-entry-menu-open;
                category-menu-x <=> root.audio-category-menu-x;
                category-menu-y <=> root.audio-category-menu-y;
                entry-menu-x <=> root.audio-entry-menu-x;
                entry-menu-y <=> root.audio-entry-menu-y;
                hotkey-label: root.hotkey-label;
                settings-section-index <=> root.settings-section-index;
                device-selected <=> root.device-selected;
                all-devices <=> root.all-devices;
                show-set-default-mic <=> root.show-set-default-mic;
                set-default-mic <=> root.set-default-mic;
                set-default-render <=> root.set-default-render;
                set-default-communications <=> root.set-default-communications;
                dest-hint <=> root.dest-hint;
                cable-installed <=> root.cable-installed;
                cable-busy <=> root.cable-busy;
                cable-text <=> root.cable-text;
                listening-hotkey <=> root.listening-hotkey;
                about-text <=> root.about-text;
                audio-entry-add-route-index(index) => {
            // PageHost 事件回调集中转发到 root，保持 Slint 与 Rust bridge 单一边界。
                    root.audio-entry-add-route-index(index);
                }
                audio-file-volume-edited(value) => {
                    root.audio-file-volume-edited(value);
                }
                audio-file-output-changed(index) => {
                    root.file-output-changed(index);
                }
                microphone-input-volume-edited(value) => {
                    root.microphone-input-volume-edited(value);
                }
                refresh => { root.refresh(); }
                process-add => { root.process-add(); }
                add-files => { root.add-audio-files(); }
                mic-mix-changed(value) => { root.mic-mix-changed(value); }
                source-active-toggled(index, value) => {
                    root.source-active-toggled(index, value);
                }
                source-volume-edited(index, value) => { root.source-volume-edited(index, value); }
                source-mute-toggled(index) => { root.source-mute-toggled(index); }
                source-output-toggled(index, target, checked) => {
                    root.source-output-toggled(index, target, checked);
                }
                source-action(index, code) => { root.source-action(index, code); }
                source-pause(index) => { root.source-pause(index); }
                source-stop(index) => { root.source-stop(index); }
                // 打开音频库只切换页面索引，条目数据仍由 bridge 的属性绑定提供。
                open-library => { root.page = 1; }
                // 设置页请求同时写入目标分组，确保跳转后直接定位到对应设置区域。
                settings-requested(section) => {
                    root.page = 2;
                    root.settings-section-index = section;
                }
                source-previous(index) => { root.source-previous(index); }
                source-next-track(index) => { root.source-next-track(index); }
                source-play-mode-cycled(index) => {
                    root.source-play-mode-cycled(index);
                }
                source-progress-seek(index, value) => {
                    root.source-progress-seek(index, value);
                }
                edit-accepted(name, icon, path) => {
                    root.audio-edit-accepted(name, icon, path);
                }
                edit-cancelled => { root.audio-edit-cancelled(); }
                edit-custom-icon-requested => {
                    root.audio-edit-custom-icon-requested();
                }
                category-changed(index) => { root.audio-category-changed(index); }
                category-context(index) => { root.audio-category-context(index); }
                category-to-transfer(index) => { root.audio-category-to-transfer(index); }
                category-can-drop(data, target, position) => {
                    root.audio-category-can-drop(data, target, position);
                }
                category-drop(data, target, position) => {
                    root.audio-category-drop(data, target, position);
                }
                entry-to-transfer(index) => { root.audio-entry-to-transfer(index); }
                entry-category-can-drop(data, target) => {
                    root.audio-entry-category-can-drop(data, target);
                }
                entry-category-drop(data, target) => {
                    root.audio-entry-category-drop(data, target);
                }
                entry-context(index) => { root.audio-entry-context(index); }
                entry-selected(index) => { root.audio-entry-selected(index); }
                entry-double-clicked(index) => { root.audio-entry-double-clicked(index); }
                entry-play(index) => { root.audio-entry-play(index); }
                entry-hotkey-clear => { root.audio-entry-hotkey-clear(); }
                progress-seek(value) => { root.audio-progress-seek(value); }
                audio-stop => { root.audio-stop(); }
                play-action(mode) => { root.audio-entry-play(mode); }
                pause-toggle => { root.player-pause-toggle(); }
                previous => { root.player-previous(); }
                next => { root.player-next(); }
                preview-volume-edited(value) => { root.preview-volume-edited(value); }
                file-output-changed(value) => { root.file-output-changed(value); }
                search-edited(value) => { root.audio-search-edited(value); }
                sort-column(index) => { root.audio-sort-column(index); }
                page-changed(value) => { root.audio-page-changed(value); }
                entry-hotkey-bind => { root.audio-entry-hotkey-bind(); }
                install-cable => { root.install-cable(); }
                uninstall-cable => { root.uninstall-cable(); }
                begin-hotkey-capture => { root.begin-hotkey-capture(); }
                reset-hotkey => { root.reset-hotkey(); }
                all-devices-toggled(value) => { root.all-devices-toggled(value); }
                device-toggled(index, value) => { root.device-toggled(index, value); }
                set-default-mic-toggled(value) => { root.set-default-mic-toggled(value); }
                set-default-render-toggled(value) => { root.set-default-render-toggled(value); }
                set-default-communications-toggled(value) => {
                    root.set-default-communications-toggled(value);
                }
            }
            }
            }
            // 状态栏位于页面右侧底部，仅承载错误、状态、总音量和音源摘要。
            StatusBar {
                status-text <=> root.status-text;
                status-kind <=> root.status-kind;
                error-text <=> root.error-text;
                source-count: root.source-titles.length;
                source-titles <=> root.source-titles;
                source-meter-history: root.source-meter-history;
                source-meter-dbs: root.source-meter-dbs;
                source-meter-open <=> root.source-meter-open;
                master-meter-history: root.master-meter-history;
                master-peak-value: root.master-peak-value;
                master-peak-db: root.master-peak-db;
                master-volume-db <=> root.master-volume-db;
                master-volume <=> root.master-volume;
                volume-adjusting <=> root.volume-adjusting;
                volume-pointer-x <=> root.volume-pointer-x;
                volume-pointer-y <=> root.volume-pointer-y;
                volume-pointer-valid <=> root.volume-pointer-valid;
                master-volume-edited(value) => { root.master-volume-edited(value); }
            }
        }
    }
    // 分类与条目菜单独立覆盖页面内容，开关和坐标由 root 属性控制其生命周期。
    ContextMenuHost {
        category-open <=> root.audio-category-menu-open;
        entry-open <=> root.audio-entry-menu-open;
        category-x <=> root.audio-category-menu-x;
        category-y <=> root.audio-category-menu-y;
        entry-x <=> root.audio-entry-menu-x;
        entry-y <=> root.audio-entry-menu-y;
        category-index <=> root.audio-category-index;
        category-edit-name <=> root.audio-category-edit-name;
        // 仅在条目下标有效且快捷键数组同步时读取，避免越界绑定。
        entry-hotkey: root.audio-entry-index >= 0
            && root.audio-entry-index < root.audio-entry-hotkeys.length
            ? root.audio-entry-hotkeys[root.audio-entry-index]
            : "";
        category-edit-requested => { root.audio-category-edit-requested(); }
        entry-edit-requested => { root.audio-entry-edit-requested(); }
        category-new => { root.audio-category-new(); }
        category-rename => { root.category-rename(); }
        category-delete => { root.category-delete(); }
        entry-play(i) => { root.audio-entry-play(i); }
        entry-add-route => { root.audio-entry-add-route(); }
        entry-hotkey-bind => { root.audio-entry-hotkey-bind(); }
        entry-hotkey-clear => { root.audio-entry-hotkey-clear(); }
        entry-remove => { root.audio-entry-remove(); }
        entry-explorer => { root.audio-entry-explorer-rename(); }
        entry-edit-file => { root.audio-entry-edit-file(); }
    }
    // 全局覆盖层随主窗口创建并由状态属性控制显示，不单独持有业务状态。
    GlobalOverlays { }
}