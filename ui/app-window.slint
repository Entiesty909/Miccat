//! 主窗口：Windows 桌面顶栏、三页内容、常驻状态栏和全局右键菜单。

import { Theme } from "theme.slint";
import { AppFocusScope } from "components/app-focus-scope.slint";
import { AppHeader } from "components/app-header.slint";
import { StatusBar } from "components/status-bar.slint";
import { ContextMenuHost } from "overlays/context-menu-host.slint";
import { DiagState, GlobalOverlays, HotkeyState } from "overlays/global-overlays.slint";
import { PageHost } from "components/page-host.slint";

export { DiagState, HotkeyState }

export component MainWindow inherits Window {
    title: "Miccat";
    min-width: 900px;
    min-height: 600px;
    preferred-width: 1280px;
    preferred-height: 800px;
    background: Theme.bg;
    default-font-family: "Segoe UI";
    default-font-size: 14px;

    in-out property <int> page: 0;
    in-out property <string> status-text: "未运行";
    in-out property <int> status-kind: 0;
    in-out property <string> error-text: "";
    in-out property <bool> running: false;
    in-out property <[string]> processes: [];
    in-out property <int> process-index: 0;
    in-out property <bool> mix-mic: false;
    in-out property <[int]> source-kinds: [];
    in-out property <[string]> source-icons: [];
    in-out property <[image]> source-icon-images: [];
    in-out property <[string]> source-titles: [];
    in-out property <[string]> source-subtitles: [];
    in-out property <[string]> source-details: [];
    in-out property <[string]> source-statuses: [];
    in-out property <[bool]> source-active: [];
    in-out property <[float]> source-volumes: [];
    in-out property <[bool]> source-muted: [];
    in-out property <[bool]> source-paused: [];
    in-out property <[int]> source-output-indices: [];
    in-out property <int> file-output-index: 0;
    in-out property <bool> sources-expanded: true;
    in-out property <bool> source-add-open: false;
    in-out property <[string]> audio-categories: ["全部", "未分类"];
    in-out property <int> audio-category-index: 0;
    in-out property <[int]> audio-category-counts: [];
    in-out property <string> audio-category-edit-name: "";
    in-out property <[string]> audio-entries: [];
    in-out property <[string]> audio-entry-durations: [];
    in-out property <[string]> audio-entry-metadata: [];
    in-out property <[string]> audio-entry-categories: [];
    in-out property <[string]> audio-entry-paths: [];
    in-out property <[string]> audio-entry-sizes: [];
    in-out property <[string]> audio-entry-statuses: [];
    in-out property <[string]> audio-entry-hotkeys: [];
    in-out property <[string]> audio-hotkey-labels: [];
    in-out property <int> audio-entry-index: -1;
    in-out property <int> audio-entry-category-index: 0;
    in-out property <string> audio-search: "";
    in-out property <int> player-entry-index: -1;
    in-out property <int> audio-page: 0;
    in-out property <int> audio-page-count: 1;
    in-out property <int> audio-total-count: 0;
    in-out property <bool> audio-sort-ascending: true;
    in-out property <int> settings-section-index: 0;
    in-out property <bool> player-loop: false;
    in-out property <float> audio-progress: 0;
    in-out property <bool> audio-seeking-progress: false;
    in-out property <string> audio-current-name: "";
    in-out property <string> audio-current-position: "";
    in-out property <float> audio-duration-seconds: 0;
    in-out property <bool> audio-hotkey-listening: false;
    in-out property <bool> player-playing: false;
    in-out property <bool> player-paused: false;
    in-out property <bool> audio-category-menu-open: false;
    in-out property <bool> audio-entry-menu-open: false;
    in-out property <length> audio-category-menu-x: 0px;
    in-out property <length> audio-category-menu-y: 0px;
    in-out property <length> audio-entry-menu-x: 0px;
    in-out property <length> audio-entry-menu-y: 0px;
    in-out property <[string]> devices: [];
    in-out property <int> device-index: 0;
    in-out property <[bool]> device-selected: [];
    in-out property <bool> all-devices: false;
    in-out property <[string]> mics: [];
    in-out property <int> mic-index: 0;
    in-out property <bool> show-set-default-mic: false;
    in-out property <bool> set-default-mic: false;
    in-out property <bool> set-default-render: false;
    in-out property <bool> set-default-communications: false;
    in-out property <string> dest-hint: "";
    in-out property <bool> preview-enabled: false;
    in-out property <float> preview-volume: 50;
    in-out property <bool> cable-installed: false;
    in-out property <bool> cable-busy: false;
    in-out property <string> cable-text: "";
    in-out property <string> hotkey-label: "";
    in-out property <bool> listening-hotkey: false;
    in-out property <float> master-volume: 100;
    in-out property <string> about-text: "";

    callback start-stop();
    callback refresh();
    callback audio-entry-hotkey-bind();
    callback master-volume-edited(float);
    callback audio-page-changed(int);
    callback entry-category-changed(int);
    callback audio-entry-selected(int);
    callback audio-sort-toggled();
    callback process-add();
    callback audio-search-edited(string);
    callback audio-loop-changed(bool);
    callback source-output-changed(int, int);
    callback file-output-changed(int);
    callback source-active-toggled(int, bool);
    callback source-volume-edited(int, float);
    callback source-mute-toggled(int);
    callback source-action(int, int);
    callback source-pause(int);
    callback source-stop(int);
    callback mic-mix-changed(bool);
    callback all-devices-toggled(bool);
    callback device-toggled(int, bool);
    callback set-default-mic-toggled(bool);
    callback set-default-render-toggled(bool);
    callback set-default-communications-toggled(bool);
    callback preview-enabled-toggled(bool);
    callback preview-volume-edited(float);
    callback install-cable();
    callback uninstall-cable();
    callback begin-hotkey-capture();
    callback reset-hotkey();
    callback hotkey-captured(string, bool, bool, bool);
    callback audio-hotkey-captured(string);
    callback audio-hotkey-binding-captured(string, bool, bool, bool);
    callback hotkey-row-captured(int, string, bool, bool, bool);
    callback begin-hotkey-row(int);
    callback reset-hotkey-row(int);
    callback audio-hotkey-pressed(string);
    callback audio-hotkey-index(int);
    callback add-audio-files();
    callback audio-category-changed(int);
    callback audio-category-context(int);
    callback audio-category-new();
    callback category-rename();
    callback category-delete();
    pure callback audio-category-to-transfer(int) -> data-transfer;
    callback audio-category-can-drop(data-transfer, int, int) -> bool;
    callback audio-category-drop(data-transfer, int, int);
    callback audio-entry-double-clicked(int);
    callback audio-entry-context(int);
    callback audio-entry-play(int);
    callback audio-entry-add-route();
    callback audio-entry-hotkey-clear();
    callback audio-entry-remove();
    callback audio-entry-explorer-rename();
    callback audio-entry-edit-file();
    callback audio-progress-seek(float);
    callback audio-stop();
    callback player-pause-toggle();
    callback player-previous();
    callback player-next();

    AppFocusScope {
        listening-hotkey: root.listening-hotkey;
        listening-audio-hotkey: root.audio-hotkey-listening;
        category-menu-open: root.audio-category-menu-open;
        entry-menu-open: root.audio-entry-menu-open;
        hotkey-captured(text, control, shift, alt) => {
            root.hotkey-captured(text, control, shift, alt);
        }
        audio-hotkey-captured(text) => { root.audio-hotkey-captured(text); }
        audio-hotkey-pressed(text) => { root.audio-hotkey-pressed(text); }
        close-menus => {
            root.audio-category-menu-open = false;
            root.audio-entry-menu-open = false;
        }
        VerticalLayout {
            AppHeader {
                current <=> root.page;
                picked(i) => {
                    root.page = i;
                    root.audio-category-menu-open = false;
                    root.audio-entry-menu-open = false;
                }
            }
            Rectangle {
                vertical-stretch: 1;
            PageHost {
                width: 100%;
                vertical-stretch: 1;
                min-height: 0px;
                page: root.page;
                processes <=> root.processes;
                process-index <=> root.process-index;
                source-kinds <=> root.source-kinds;
                source-icons <=> root.source-icons;
                source-icon-images <=> root.source-icon-images;
                source-titles <=> root.source-titles;
                source-subtitles <=> root.source-subtitles;
                source-details <=> root.source-details;
                source-statuses <=> root.source-statuses;
                source-active <=> root.source-active;
                source-volumes <=> root.source-volumes;
                source-muted <=> root.source-muted;
                source-paused <=> root.source-paused;
                source-output-indices <=> root.source-output-indices;
                outputs <=> root.devices;
                output-index <=> root.device-index;
                mics <=> root.mics;
                mic-index <=> root.mic-index;
                mix-mic <=> root.mix-mic;
                sources-expanded <=> root.sources-expanded;
                source-add-open <=> root.source-add-open;
                running <=> root.running;
                categories <=> root.audio-categories;
                category-counts <=> root.audio-category-counts;
                audio-hotkeys <=> root.audio-hotkey-labels;
                category-index <=> root.audio-category-index;
                entries <=> root.audio-entries;
                entry-durations <=> root.audio-entry-durations;
                entry-metadata <=> root.audio-entry-metadata;
                entry-categories <=> root.audio-entry-categories;
                entry-paths <=> root.audio-entry-paths;
                entry-sizes <=> root.audio-entry-sizes;
                entry-hotkeys <=> root.audio-entry-hotkeys;
                entry-statuses <=> root.audio-entry-statuses;
                search <=> root.audio-search;
                entry-index <=> root.audio-entry-index;
                entry-category-index <=> root.audio-entry-category-index;
                listening-entry-hotkey <=> root.audio-hotkey-listening;
                page-index <=> root.audio-page;
                page-count <=> root.audio-page-count;
                total-count <=> root.audio-total-count;
                sort-ascending <=> root.audio-sort-ascending;
                playing-entry-index <=> root.player-entry-index;
                progress <=> root.audio-progress;
                seeking-progress <=> root.audio-seeking-progress;
                current-name <=> root.audio-current-name;
                current-position <=> root.audio-current-position;
                duration-seconds <=> root.audio-duration-seconds;
                playing <=> root.player-playing;
                paused <=> root.player-paused;
                preview-enabled <=> root.preview-enabled;
                monitor-volume <=> root.preview-volume;
                loop <=> root.player-loop;
                file-output-index <=> root.file-output-index;
                category-menu-open <=> root.audio-category-menu-open;
                entry-menu-open <=> root.audio-entry-menu-open;
                category-menu-x <=> root.audio-category-menu-x;
                category-menu-y <=> root.audio-category-menu-y;
                entry-menu-x <=> root.audio-entry-menu-x;
                entry-menu-y <=> root.audio-entry-menu-y;
                hotkey-label: root.hotkey-label;
                settings-section-index <=> root.settings-section-index;
                device-selected <=> root.device-selected;
                all-devices <=> root.all-devices;
                show-set-default-mic <=> root.show-set-default-mic;
                set-default-mic <=> root.set-default-mic;
                set-default-render <=> root.set-default-render;
                set-default-communications <=> root.set-default-communications;
                dest-hint <=> root.dest-hint;
                cable-installed <=> root.cable-installed;
                cable-busy <=> root.cable-busy;
                cable-text <=> root.cable-text;
                listening-hotkey <=> root.listening-hotkey;
                about-text <=> root.about-text;
                refresh => { root.refresh(); }
                process-add => { root.process-add(); }
                add-files => { root.add-audio-files(); }
                mic-mix-changed(value) => { root.mic-mix-changed(value); }
                source-active-toggled(index, value) => {
                    root.source-active-toggled(index, value);
                }
                source-volume-edited(index, value) => { root.source-volume-edited(index, value); }
                source-mute-toggled(index) => { root.source-mute-toggled(index); }
                source-output-changed(index, target) => {
                    root.source-output-changed(index, target);
                }
                source-action(index, code) => { root.source-action(index, code); }
                source-pause(index) => { root.source-pause(index); }
                source-stop(index) => { root.source-stop(index); }
                open-library => { root.page = 1; }
                settings-requested(section) => {
                    root.page = 2;
                    root.settings-section-index = section;
                }
                category-changed(index) => { root.audio-category-changed(index); }
                category-context(index) => { root.audio-category-context(index); }
                category-to-transfer(index) => { root.audio-category-to-transfer(index); }
                category-can-drop(data, target, position) => {
                    root.audio-category-can-drop(data, target, position);
                }
                category-drop(data, target, position) => {
                    root.audio-category-drop(data, target, position);
                }
                entry-context(index) => { root.audio-entry-context(index); }
                entry-selected(index) => { root.audio-entry-selected(index); }
                entry-double-clicked(index) => { root.audio-entry-double-clicked(index); }
                entry-play(index) => { root.audio-entry-play(index); }
                progress-seek(value) => { root.audio-progress-seek(value); }
                audio-stop => { root.audio-stop(); }
                play-action(mode) => { root.audio-entry-play(mode); }
                pause-toggle => { root.player-pause-toggle(); }
                previous => { root.player-previous(); }
                next => { root.player-next(); }
                preview-enabled-toggled(value) => { root.preview-enabled-toggled(value); }
                preview-volume-edited(value) => { root.preview-volume-edited(value); }
                file-output-changed(value) => { root.file-output-changed(value); }
                search-edited(value) => { root.audio-search-edited(value); }
                sort-toggled => { root.audio-sort-toggled(); }
                page-changed(value) => { root.audio-page-changed(value); }
                entry-category-changed(value) => { root.entry-category-changed(value); }
                entry-hotkey-bind => { root.audio-entry-hotkey-bind(); }
                loop-changed(value) => { root.audio-loop-changed(value); }
                hotkey-settings-requested => {
                    root.page = 2;
                    root.settings-section-index = 2;
                }
                install-cable => { root.install-cable(); }
                uninstall-cable => { root.uninstall-cable(); }
                begin-hotkey-capture => { root.begin-hotkey-capture(); }
                reset-hotkey => { root.reset-hotkey(); }
                all-devices-toggled(value) => { root.all-devices-toggled(value); }
                device-toggled(index, value) => { root.device-toggled(index, value); }
                set-default-mic-toggled(value) => { root.set-default-mic-toggled(value); }
                set-default-render-toggled(value) => { root.set-default-render-toggled(value); }
                set-default-communications-toggled(value) => {
                    root.set-default-communications-toggled(value);
                }
            }
            }
            StatusBar {
                status-text <=> root.status-text;
                status-kind <=> root.status-kind;
                error-text <=> root.error-text;
                running <=> root.running;
                source-count: root.source-titles.length;
                sources-expanded <=> root.sources-expanded;
                master-volume <=> root.master-volume;
                cable-busy <=> root.cable-busy;
                sources-expanded-toggled(value) => { root.sources-expanded = value; }
                master-volume-edited(value) => { root.master-volume-edited(value); }
                start-stop => { root.start-stop(); }
            }
        }
    }
    ContextMenuHost {
        category-open <=> root.audio-category-menu-open;
        entry-open <=> root.audio-entry-menu-open;
        category-x <=> root.audio-category-menu-x;
        category-y <=> root.audio-category-menu-y;
        entry-x <=> root.audio-entry-menu-x;
        entry-y <=> root.audio-entry-menu-y;
        category-index <=> root.audio-category-index;
        category-edit-name <=> root.audio-category-edit-name;
        entry-hotkey: root.audio-entry-index >= 0
            && root.audio-entry-index < root.audio-entry-hotkeys.length
            ? root.audio-entry-hotkeys[root.audio-entry-index]
            : "";
        category-new => { root.audio-category-new(); }
        category-rename => { root.category-rename(); }
        category-delete => { root.category-delete(); }
        entry-play(i) => { root.audio-entry-play(i); }
        entry-add-route => { root.audio-entry-add-route(); }
        entry-hotkey-bind => { root.audio-entry-hotkey-bind(); }
        entry-hotkey-clear => { root.audio-entry-hotkey-clear(); }
        entry-remove => { root.audio-entry-remove(); }
        entry-explorer => { root.audio-entry-explorer-rename(); }
        entry-edit-file => { root.audio-entry-edit-file(); }
    }
    GlobalOverlays { }
}